 193:rf/trf6151.c  **** 
 194:rf/trf6151.c  **** #define SCALE_100KHZ	100
 195:rf/trf6151.c  **** 
 196:rf/trf6151.c  **** /* Compute TRF6151 PLL valuese */
 197:rf/trf6151.c  **** static void trf6151_pll_rx(uint32_t freq_khz,
 198:rf/trf6151.c  ****                            uint16_t *pll_config, enum trf6151_gsm_band *band)
 199:rf/trf6151.c  **** {
 200:rf/trf6151.c  **** 	const uint32_t p=64, r=65;
 201:rf/trf6151.c  **** 	uint32_t freq_100khz, vco_freq_100khz;
 202:rf/trf6151.c  **** 	uint32_t l, n;
 203:rf/trf6151.c  **** 	uint32_t a, b;
 204:rf/trf6151.c  **** 
 205:rf/trf6151.c  **** 	/* Scale into 100kHz unit (avoid overflow in intermediates) */
 206:rf/trf6151.c  **** 	freq_100khz = freq_khz / SCALE_100KHZ;
 207:rf/trf6151.c  **** 
 208:rf/trf6151.c  **** 	/* L selects hi/lo band */
 209:rf/trf6151.c  **** 	l = (freq_khz > 1350000) ? 2 : 4; /* cut at mid point :) */
 210:rf/trf6151.c  **** 
 211:rf/trf6151.c  **** 	/* VCO frequency */
 212:rf/trf6151.c  **** 	vco_freq_100khz = freq_100khz * l;
 213:rf/trf6151.c  **** 
 214:rf/trf6151.c  **** 	/* vco_freq = 26MHz / R * N  with R=65 and N=B*P+A */
 215:rf/trf6151.c  **** 	n = (vco_freq_100khz * r) / 260;
 216:rf/trf6151.c  **** 	a = n % p;
 217:rf/trf6151.c  **** 	b = n / p;
 218:rf/trf6151.c  **** 
 219:rf/trf6151.c  **** 	*pll_config = PLL_VAL(a, b);
 220:rf/trf6151.c  **** 
 221:rf/trf6151.c  **** 	/* Out-of-spec tuning warning */
 222:rf/trf6151.c  **** #ifdef WARN_OUT_OF_SPEC
 223:rf/trf6151.c  **** 	if ((l == 4 && (b < 135 || b > 150)) ||
 224:rf/trf6151.c  **** 	    (l == 2 && (b < 141 || b > 155)))
 225:rf/trf6151.c  **** 		printf("Frequency %u kHz is out of spec\n", (unsigned int)freq_khz);
 226:rf/trf6151.c  **** #endif
 227:rf/trf6151.c  **** 
 228:rf/trf6151.c  **** 	/* Select band */
 229:rf/trf6151.c  **** 	if (l==4) {
 230:rf/trf6151.c  **** 		/* If in the low band, same port for both GSM850/GSM900, so we
 231:rf/trf6151.c  **** 		 * choose the best VCO (VCOMAIN1=3.37GHz, VCOMAIN2=3.8GHz) */
 232:rf/trf6151.c  **** 		if (vco_freq_100khz < 35850) /* midpoint */
 233:rf/trf6151.c  **** 			*band = GSM850_LOW;
 234:rf/trf6151.c  **** 		else
 235:rf/trf6151.c  **** 			*band = GSM900;
 236:rf/trf6151.c  **** 
 237:rf/trf6151.c  **** 		/* Out-of-spec freq check */
 238:rf/trf6151.c  **** #ifdef WARN_OUT_OF_SPEC
 239:rf/trf6151.c  **** 		if (!(freq_khz >= 869000 && freq_khz <= 894000) &&
 240:rf/trf6151.c  **** 		    !(freq_khz >= 921000 && freq_khz <= 960000)) /* include GSM-R */
 241:rf/trf6151.c  **** 			printf("Frequency %u outside normal filter range for selected port\n", (unsigned int)freq_khz);
 242:rf/trf6151.c  **** #endif
 243:rf/trf6151.c  **** 	} else {
 244:rf/trf6151.c  **** 		/* In the high band, different ports for DCS/PCS, so
 245:rf/trf6151.c  **** 		 * take what's best and available */
 246:rf/trf6151.c  **** 		/* We're stuck to VCOMAIN2=3.8GHz though ... */
 247:rf/trf6151.c  **** 		uint32_t rx_ports = rffe_get_rx_ports();
 248:rf/trf6151.c  **** 		uint32_t port;
 249:rf/trf6151.c  **** 
 250:rf/trf6151.c  **** 		/* Select port */
 251:rf/trf6151.c  **** 		port = (freq_khz < 1905000) ? (1 << PORT_DCS1800) : (1 << PORT_PCS1900);
 252:rf/trf6151.c  **** 		port = (port & rx_ports) ? port : rx_ports;
 253:rf/trf6151.c  **** 
 254:rf/trf6151.c  **** 		/* Select band */
 255:rf/trf6151.c  **** 		*band = (port & (1 << PORT_DCS1800)) ? GSM1800 : GSM1900;
 256:rf/trf6151.c  **** 
 257:rf/trf6151.c  **** 		/* Out-of-spec freq check */
 258:rf/trf6151.c  **** #ifdef WARN_OUT_OF_SPEC
 259:rf/trf6151.c  **** 		if ((*band == GSM1800 && (freq_khz < 1805000 || freq_khz > 1880000)) ||
 260:rf/trf6151.c  **** 		    (*band == GSM1900 && (freq_khz < 1930000 || freq_khz > 1990000)))
 261:rf/trf6151.c  **** 			printf("Frequency %u outside normal filter range for selected port\n", (unsigned int)freq_khz);
 262:rf/trf6151.c  **** #endif
 263:rf/trf6151.c  **** 	}
 264:rf/trf6151.c  **** 
 265:rf/trf6151.c  **** 	/* Debug */
 266:rf/trf6151.c  **** 	printd("RX Freq %u kHz => A = %u, B = %u, band = %d, vco_freq = %u kHz\n", freq_khz, a, b, *band, 
 267:rf/trf6151.c  **** 
 268:rf/trf6151.c  **** 	/* All done */
 269:rf/trf6151.c  **** 	return;
 270:rf/trf6151.c  **** }
 271:rf/trf6151.c  **** 
 272:rf/trf6151.c  **** /* Compute TRF6151 PLL TX values */
 273:rf/trf6151.c  **** static void trf6151_pll_tx(uint32_t freq_khz,
 274:rf/trf6151.c  ****                            uint16_t *pll_config, enum trf6151_gsm_band *band)
 275:rf/trf6151.c  **** {
 276:rf/trf6151.c  **** 	const uint32_t p=64;
 277:rf/trf6151.c  **** 	uint32_t r, l, m, m_op_l; /* m_op_l = m +/- l depending on mode */
 278:rf/trf6151.c  **** 	uint32_t freq_100khz;
 279:rf/trf6151.c  **** 	uint32_t n, a, b, b_min, b_max;
 280:rf/trf6151.c  **** 
 281:rf/trf6151.c  **** 	/* Scale into 100kHz unit (avoid overflow in intermediates) */
 282:rf/trf6151.c  **** 	freq_100khz = freq_khz / SCALE_100KHZ;
 283:rf/trf6151.c  **** 
 284:rf/trf6151.c  **** 	/* Select band (and PLL mode) */
 285:rf/trf6151.c  **** 	if (freq_khz > 1350000) {
 286:rf/trf6151.c  **** 		/* High band, so only 1 real PLL mode. band doesn't matter
 287:rf/trf6151.c  **** 		 * that much (or at all) but we still do it :p */
 288:rf/trf6151.c  **** 		*band = (freq_khz < 1817500) ? GSM1800 : GSM1900;
 289:rf/trf6151.c  **** 		r = 70;
 290:rf/trf6151.c  **** 		l = 2;
 291:rf/trf6151.c  **** 		m = 26;
 292:rf/trf6151.c  **** 		m_op_l = m + l;
 293:rf/trf6151.c  **** 		b_min = 133;
 294:rf/trf6151.c  **** 		b_max = 149;
 295:rf/trf6151.c  **** 	} else {
 296:rf/trf6151.c  **** 		/* Low band. We have 3 possible PLL modes that output on
 297:rf/trf6151.c  **** 		 * the right port: GSM900, GSM850_HIGH, GSM850_LOW.
 298:rf/trf6151.c  **** 		 *
 299:rf/trf6151.c  **** 		 * The transition points have been chosen looking at the VCO
 300:rf/trf6151.c  **** 		 * and IF frequencies for various frequencies for these modes
 301:rf/trf6151.c  **** 		 */
 302:rf/trf6151.c  **** 		if (freq_khz < 837100) {
 303:rf/trf6151.c  **** 			/* GSM850_LOW */
 304:rf/trf6151.c  **** 			*band = GSM850_LOW;
 305:rf/trf6151.c  **** 			r = 55;
 306:rf/trf6151.c  **** 			l = 4;
 307:rf/trf6151.c  **** 			m = 26;
 308:rf/trf6151.c  **** 			m_op_l = m - l;
 309:rf/trf6151.c  **** 			b_min = 128;
 310:rf/trf6151.c  **** 			b_max = 130;
 311:rf/trf6151.c  **** 		} else if (freq_khz < 850000) {
 312:rf/trf6151.c  **** 			/* GSM850_HIGH */
 313:rf/trf6151.c  **** 			*band = GSM850_HIGH;
 314:rf/trf6151.c  **** 			r = 30;
 315:rf/trf6151.c  **** 			l = 4;
 316:rf/trf6151.c  **** 			m = 52;
 317:rf/trf6151.c  **** 			m_op_l = m - l;
 318:rf/trf6151.c  **** 			b_min = 65;
 319:rf/trf6151.c  **** 			b_max = 66;
 320:rf/trf6151.c  **** 		} else {
 321:rf/trf6151.c  **** 			/* GSM900 */
 322:rf/trf6151.c  **** 			*band = GSM900;
 323:rf/trf6151.c  **** 			r = 35;
 324:rf/trf6151.c  **** 			l = 4;
 325:rf/trf6151.c  **** 			m = 52;
 326:rf/trf6151.c  **** 			m_op_l = m + l;
 327:rf/trf6151.c  **** 			b_min = 68;
 328:rf/trf6151.c  **** 			b_max = 71;
 329:rf/trf6151.c  **** 		}
 330:rf/trf6151.c  **** 	}
 331:rf/trf6151.c  **** 
 332:rf/trf6151.c  **** 	/* vco_freq = f * M * L / (M +- L)                 */
 333:rf/trf6151.c  **** 	/*          = 26MHz / R * N  with R=65 and N=B*P+A */
 334:rf/trf6151.c  **** 	n = (freq_100khz * m * l * r) / (m_op_l * 260);
 335:rf/trf6151.c  **** 	a = n % p;
 336:rf/trf6151.c  **** 	b = n / p;
 337:rf/trf6151.c  **** 
 338:rf/trf6151.c  **** 	*pll_config = PLL_VAL(a, b);
 339:rf/trf6151.c  **** 
 340:rf/trf6151.c  **** 	/* Debug */
 341:rf/trf6151.c  **** 	printd("TX Freq %u kHz => A = %u, B = %u, band = %d\n", freq_khz, a, b, *band);
 342:rf/trf6151.c  **** 
 343:rf/trf6151.c  **** 	/* Out-of-spec tuning warning */
 344:rf/trf6151.c  **** #ifdef WARN_OUT_OF_SPEC
 345:rf/trf6151.c  **** 	if (b < b_min || b > b_max)
 346:rf/trf6151.c  **** 		printf("Frequency %u kHz is out of spec\n", (unsigned int)freq_khz);
 347:rf/trf6151.c  **** #endif
 348:rf/trf6151.c  **** 
 349:rf/trf6151.c  **** 	/* All done */
 350:rf/trf6151.c  **** 	return;
 351:rf/trf6151.c  **** }
 352:rf/trf6151.c  **** 
 353:rf/trf6151.c  **** static inline void trf6151_reset(uint16_t reset_id)
 354:rf/trf6151.c  **** {
 355:rf/trf6151.c  **** 	/* pull the nRESET line low */
 356:rf/trf6151.c  **** 	tsp_act_disable(reset_id);
 357:rf/trf6151.c  **** 	tpu_enq_wait(50);
 358:rf/trf6151.c  **** 	/* release nRESET */
 359:rf/trf6151.c  **** 	tsp_act_enable(reset_id);
 360:rf/trf6151.c  **** }
 361:rf/trf6151.c  **** 
 362:rf/trf6151.c  **** void trf6151_init(uint8_t tsp_uid, uint16_t tsp_reset_id)
 363:rf/trf6151.c  **** {
 364:rf/trf6151.c  **** 	trf6151_tsp_uid = tsp_uid;
 365:rf/trf6151.c  **** 
 366:rf/trf6151.c  **** 	/* Configure the TSPEN which is connected to TRF6151 STROBE */
 367:rf/trf6151.c  **** 	tsp_setup(trf6151_tsp_uid, 0, 1, 1);
 368:rf/trf6151.c  **** 
 369:rf/trf6151.c  **** 	trf6151_reset(tsp_reset_id);
 370:rf/trf6151.c  **** 
