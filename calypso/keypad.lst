  38:calypso/keypad.c **** static key_handler_t key_handler = NULL;
  39:calypso/keypad.c **** 
  40:calypso/keypad.c **** void emit_key(uint8_t key, uint8_t state)
  41:calypso/keypad.c **** {
  42:calypso/keypad.c **** 	printf("key=%u %s\n", key, state == PRESSED ? "pressed" : "released");
  43:calypso/keypad.c **** 
  44:calypso/keypad.c **** 	if(key_handler) {
  45:calypso/keypad.c **** 		key_handler(key, state);
  46:calypso/keypad.c **** 	}
  47:calypso/keypad.c **** }
  48:calypso/keypad.c **** 
  49:calypso/keypad.c **** volatile uint32_t lastbuttons = 0;
  50:calypso/keypad.c **** static const uint8_t *btn_map;
  51:calypso/keypad.c **** unsigned long power_hold = 0;
  52:calypso/keypad.c **** 
  53:calypso/keypad.c **** void dispatch_buttons(uint32_t buttons)
  54:calypso/keypad.c **** {
  55:calypso/keypad.c **** 	int i;
  56:calypso/keypad.c **** 	uint8_t state;
  57:calypso/keypad.c **** 
  58:calypso/keypad.c **** 	if ((buttons & (1 << btn_map[KEY_POWER]))) {
  59:calypso/keypad.c **** 		/* hold button 500ms to shut down */
  60:calypso/keypad.c **** 		if ((lastbuttons & (1 << btn_map[KEY_POWER]))) {
  61:calypso/keypad.c **** 			unsigned long elapsed = jiffies - power_hold;
  62:calypso/keypad.c **** 			if (elapsed > 50)
  63:calypso/keypad.c **** 				twl3025_power_off();
  64:calypso/keypad.c **** 			power_hold++;
  65:calypso/keypad.c **** 		} else
  66:calypso/keypad.c **** 		power_hold = jiffies;
  67:calypso/keypad.c **** 	}
  68:calypso/keypad.c **** 
  69:calypso/keypad.c **** 	if (buttons == lastbuttons)
  70:calypso/keypad.c **** 		return;
  71:calypso/keypad.c **** 
  72:calypso/keypad.c **** 	uint32_t diff = buttons ^ lastbuttons;
  73:calypso/keypad.c **** 	for (i = 0; i < BUTTON_CNT; i++) {
  74:calypso/keypad.c **** 		if (diff & (1 << btn_map[i])) {
  75:calypso/keypad.c **** 			state = (buttons & (1 << btn_map[i])) ? PRESSED : RELEASED;
  76:calypso/keypad.c **** 			emit_key(i, state);
  77:calypso/keypad.c **** 		}
  78:calypso/keypad.c **** 	}
  79:calypso/keypad.c **** 	lastbuttons = buttons;
  80:calypso/keypad.c **** }
