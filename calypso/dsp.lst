 240:calypso/dsp.c **** /* memcpy from RAM to DSP API, 16 bits by 16 bits. If odd byte count, last word will
 241:calypso/dsp.c ****  * be zero filled */
 242:calypso/dsp.c **** void dsp_memcpy_to_api(volatile uint16_t *dsp_buf, const uint8_t *mcu_buf, int n, int be)
 243:calypso/dsp.c **** {
 244:calypso/dsp.c **** 	int odd, i;
 245:calypso/dsp.c **** 
 246:calypso/dsp.c **** 	odd = n & 1;
 247:calypso/dsp.c **** 	n >>= 1;
 248:calypso/dsp.c **** 
 249:calypso/dsp.c **** 	if (be) {
 250:calypso/dsp.c **** 		for (i=0; i<n; i++) {
 251:calypso/dsp.c **** 			uint16_t w;
 252:calypso/dsp.c **** 			w  = *(mcu_buf++) << 8;
 253:calypso/dsp.c **** 			w |= *(mcu_buf++);
 254:calypso/dsp.c **** 			*(dsp_buf++) = w;
 255:calypso/dsp.c **** 		}
 256:calypso/dsp.c **** 		if (odd)
 257:calypso/dsp.c **** 			*dsp_buf = *mcu_buf << 8;
 258:calypso/dsp.c **** 	} else {
 259:calypso/dsp.c **** 		for (i=0; i<n; i++) {
 260:calypso/dsp.c **** 			uint16_t w;
 261:calypso/dsp.c **** 			w  = *(mcu_buf++);
 262:calypso/dsp.c **** 			w |= *(mcu_buf++) << 8;
 263:calypso/dsp.c **** 			*(dsp_buf++) = w;
 264:calypso/dsp.c **** 		}
 265:calypso/dsp.c **** 		if (odd)
 266:calypso/dsp.c **** 			*dsp_buf = *mcu_buf;
 267:calypso/dsp.c **** 	}
 268:calypso/dsp.c **** }
 269:calypso/dsp.c **** 
 270:calypso/dsp.c **** /* memcpy from DSP API to RAM, accessing API 16 bits word at a time */
 271:calypso/dsp.c **** void dsp_memcpy_from_api(uint8_t *mcu_buf, const volatile uint16_t *dsp_buf, int n, int be)
 272:calypso/dsp.c **** {
 273:calypso/dsp.c **** 	int odd, i;
 274:calypso/dsp.c **** 
 275:calypso/dsp.c **** 	odd = n & 1;
 276:calypso/dsp.c **** 	n >>= 1;
 277:calypso/dsp.c **** 
 278:calypso/dsp.c **** 	if (be) {
 279:calypso/dsp.c **** 		for (i=0; i<n; i++) {
 280:calypso/dsp.c **** 			uint16_t w = *(dsp_buf++);
 281:calypso/dsp.c **** 			*(mcu_buf++) = w >> 8;
 282:calypso/dsp.c **** 			*(mcu_buf++) = w;
 283:calypso/dsp.c **** 		}
 284:calypso/dsp.c **** 		if (odd)
 285:calypso/dsp.c **** 			*mcu_buf = *(dsp_buf++) >> 8;
 286:calypso/dsp.c **** 	} else {
 287:calypso/dsp.c **** 		for (i=0; i<n; i++) {
 288:calypso/dsp.c **** 			uint16_t w = *(dsp_buf++);
 289:calypso/dsp.c **** 			*(mcu_buf++) = w;
 290:calypso/dsp.c **** 			*(mcu_buf++) = w >> 8;
 291:calypso/dsp.c **** 		}
 292:calypso/dsp.c **** 		if (odd)
 293:calypso/dsp.c **** 			*mcu_buf = *(dsp_buf++);
 294:calypso/dsp.c **** 	}
 295:calypso/dsp.c **** }
 296:calypso/dsp.c **** 
 297:calypso/dsp.c **** static void dsp_audio_init(void)
 298:calypso/dsp.c **** {
 299:calypso/dsp.c **** 	T_NDB_MCU_DSP *ndb = dsp_api.ndb;
 300:calypso/dsp.c **** 	uint8_t i;
 301:calypso/dsp.c **** 
 302:calypso/dsp.c **** 	ndb->d_vbctrl1  = ABB_VAL_T(VBCTRL1, 0x00B); 	/* VULSWITCH=0, VDLAUX=1, VDLEAR=1 */
 303:calypso/dsp.c **** 	ndb->d_vbctrl2	= ABB_VAL_T(VBCTRL2, 0x000); 	/* MICBIASEL=0, VDLHSO=0, MICAUX=0 */
 304:calypso/dsp.c **** 
 305:calypso/dsp.c **** 	/*
 306:calypso/dsp.c **** 	 * TODO: the following two settings are used to control
 307:calypso/dsp.c **** 	 * the volume and uplink/downlink/sidetone gain. Make them
 308:calypso/dsp.c **** 	 * adjustable by the user.
 309:calypso/dsp.c **** 	 */
 310:calypso/dsp.c **** 
 311:calypso/dsp.c **** 	ndb->d_vbuctrl	= ABB_VAL_T(VBUCTRL, 0x009);	/* Uplink gain amp 3dB, Sidetone gain -5dB */
 312:calypso/dsp.c **** 	ndb->d_vbdctrl	= ABB_VAL_T(VBDCTRL, 0x066);	/* Downlink gain amp 0dB, Volume control -6 dB */
 313:calypso/dsp.c **** 
 314:calypso/dsp.c **** 	ndb->d_toneskb_init = 0;			/* MCU/DSP audio task com. register */
 315:calypso/dsp.c **** 	ndb->d_toneskb_status = 0;			/* MCU/DSP audio task com. register */
 316:calypso/dsp.c **** 
 317:calypso/dsp.c **** 	ndb->d_shiftul = 0x100;
 318:calypso/dsp.c **** 	ndb->d_shiftdl = 0x100;
 319:calypso/dsp.c **** 
 320:calypso/dsp.c **** 	ndb->d_melo_osc_used    = 0;
 321:calypso/dsp.c **** 	ndb->d_melo_osc_active  = 0;
 322:calypso/dsp.c **** 
 323:calypso/dsp.c **** #define SC_END_OSCILLATOR_MASK        0xfffe
 324:calypso/dsp.c **** 
 325:calypso/dsp.c **** 	ndb->a_melo_note0[0] = SC_END_OSCILLATOR_MASK;
 326:calypso/dsp.c **** 	ndb->a_melo_note1[0] = SC_END_OSCILLATOR_MASK;
 327:calypso/dsp.c **** 	ndb->a_melo_note2[0] = SC_END_OSCILLATOR_MASK;
 328:calypso/dsp.c **** 	ndb->a_melo_note3[0] = SC_END_OSCILLATOR_MASK;
 329:calypso/dsp.c **** 	ndb->a_melo_note4[0] = SC_END_OSCILLATOR_MASK;
 330:calypso/dsp.c **** 	ndb->a_melo_note5[0] = SC_END_OSCILLATOR_MASK;
 331:calypso/dsp.c **** 	ndb->a_melo_note6[0] = SC_END_OSCILLATOR_MASK;
 332:calypso/dsp.c **** 	ndb->a_melo_note7[0] = SC_END_OSCILLATOR_MASK;
 333:calypso/dsp.c **** 
 334:calypso/dsp.c **** #define MAX_FIR_COEF  31
 335:calypso/dsp.c **** 
 336:calypso/dsp.c **** 	/* Initialize the FIR as an all band pass */
 337:calypso/dsp.c **** 	dsp_api.param->a_fir31_downlink[0] = 0x4000;
 338:calypso/dsp.c **** 	dsp_api.param->a_fir31_uplink[0]   = 0x4000;
 339:calypso/dsp.c **** 	for (i = 1; i < MAX_FIR_COEF; i++)
 340:calypso/dsp.c **** 	{
 341:calypso/dsp.c **** 		dsp_api.param->a_fir31_downlink[i]  = 0;
 342:calypso/dsp.c **** 		dsp_api.param->a_fir31_uplink[i]    = 0;
 343:calypso/dsp.c **** 	}
 344:calypso/dsp.c **** 
 345:calypso/dsp.c **** #define B_GSM_ONLY	((1L <<  13) | (1L <<  11))	/* GSM normal mode */
 346:calypso/dsp.c **** #define B_BT_CORDLESS	(1L <<  12)			/* Bluetooth cordless mode */
 347:calypso/dsp.c **** #define B_BT_HEADSET	(1L <<  14)			/* Bluetooth headset mode */
 348:calypso/dsp.c **** 
 349:calypso/dsp.c **** 		/* Bit set by the MCU to close the loop between the audio UL and DL path. */
 350:calypso/dsp.c **** 		/* This features is used to find the FIR coefficient. */
 351:calypso/dsp.c **** #define B_FIR_LOOP	(1L <<  1)
 352:calypso/dsp.c **** 
 353:calypso/dsp.c **** 	/* Reset the FIR loopback and the audio mode */
 354:calypso/dsp.c **** 	ndb->d_audio_init &= ~(B_FIR_LOOP | B_GSM_ONLY | B_BT_HEADSET | B_BT_CORDLESS);
 355:calypso/dsp.c **** 
 356:calypso/dsp.c **** 	/* Set the GSM mode  */
 357:calypso/dsp.c **** 	ndb->d_audio_init |= (B_GSM_ONLY);
 358:calypso/dsp.c **** 
 359:calypso/dsp.c **** 	ndb->d_aec_ctrl = 0;
 360:calypso/dsp.c **** 
 361:calypso/dsp.c **** 	/* DSP background task through pending task queue */
 362:calypso/dsp.c **** 	dsp_api.param->d_gsm_bgd_mgt = 0;
 363:calypso/dsp.c **** 
 364:calypso/dsp.c **** 	ndb->d_audio_compressor_ctrl = 0x0401;
 365:calypso/dsp.c **** 
 366:calypso/dsp.c **** #define NO_MELODY_SELECTED    (0)
 367:calypso/dsp.c **** 
 368:calypso/dsp.c **** 	ndb->d_melody_selection = NO_MELODY_SELECTED;
 369:calypso/dsp.c **** }
 370:calypso/dsp.c **** 
 371:calypso/dsp.c **** static void dsp_ndb_init(void)
 372:calypso/dsp.c **** {
 373:calypso/dsp.c **** 	T_NDB_MCU_DSP *ndb = dsp_api.ndb;
 374:calypso/dsp.c **** 	uint8_t i;
 375:calypso/dsp.c **** 
 376:calypso/dsp.c **** 	#define APCDEL_DOWN     (2+0)   // minimum value: 2
 377:calypso/dsp.c **** 	#define APCDEL_UP       (6+3+1) // minimum value: 6
 378:calypso/dsp.c **** 
 379:calypso/dsp.c **** 	/* load APC ramp: set to "no ramp" so that there will be no output if
 380:calypso/dsp.c **** 	 * not properly initialised at some other place. */
 381:calypso/dsp.c **** 	for (i = 0; i < 16; i++)
 382:calypso/dsp.c **** 		dsp_api.ndb->a_ramp[i] = ABB_VAL(APCRAM, ABB_RAMP_VAL(0, 0));
 383:calypso/dsp.c **** 
 384:calypso/dsp.c **** 	/* Iota registers values will be programmed at 1st DSP communication interrupt */
 385:calypso/dsp.c **** 
 386:calypso/dsp.c **** 	/* Enable f_tx delay of 400000 cyc DEBUG */
 387:calypso/dsp.c **** 	ndb->d_debug1 	= ABB_VAL_T(0, 0x000);
 388:calypso/dsp.c **** 	ndb->d_afcctladd= ABB_VAL_T(AFCCTLADD, 0x000);  // Value at reset
 389:calypso/dsp.c **** 	ndb->d_vbuctrl	= ABB_VAL_T(VBUCTRL, 0x0C9);	// Uplink gain amp 0dB, Sidetone gain to mute
 390:calypso/dsp.c **** 	ndb->d_vbdctrl	= ABB_VAL_T(VBDCTRL, 0x006);	// Downlink gain amp 0dB, Volume control 0 dB
 391:calypso/dsp.c **** 	ndb->d_bbctrl	= ABB_VAL_T(BBCTRL,  0x2C1);	// value at reset
 392:calypso/dsp.c **** 	ndb->d_bulgcal	= ABB_VAL_T(BULGCAL, 0x000);	// value at reset
 393:calypso/dsp.c **** 	ndb->d_apcoff	= ABB_VAL_T(APCOFF,  0x040);	// value at reset
 394:calypso/dsp.c **** 	ndb->d_bulioff	= ABB_VAL_T(BULIOFF, 0x0FF);	// value at reset
 395:calypso/dsp.c **** 	ndb->d_bulqoff	= ABB_VAL_T(BULQOFF, 0x0FF);	// value at reset
 396:calypso/dsp.c **** 	ndb->d_dai_onoff= ABB_VAL_T(APCOFF,  0x000);	// value at reset
 397:calypso/dsp.c **** 	ndb->d_auxdac	= ABB_VAL_T(AUXDAC,  0x000);	// value at reset
 398:calypso/dsp.c **** 	ndb->d_vbctrl1  = ABB_VAL_T(VBCTRL1, 0x00B); 	// VULSWITCH=0, VDLAUX=1, VDLEAR=1.
 399:calypso/dsp.c **** 	ndb->d_vbctrl2	= ABB_VAL_T(VBCTRL2, 0x000); 	// MICBIASEL=0, VDLHSO=0, MICAUX=0
 400:calypso/dsp.c **** 
 401:calypso/dsp.c **** 	/* APCDEL will be initialized on rach only */
 402:calypso/dsp.c **** 	ndb->d_apcdel1	= ABB_VAL_T(APCDEL1, ((APCDEL_DOWN-2) << 5) | (APCDEL_UP-6));
 403:calypso/dsp.c **** 	ndb->d_apcdel2	= ABB_VAL_T(APCDEL2, 0x000);
 404:calypso/dsp.c **** 
 405:calypso/dsp.c **** 	ndb->d_fb_mode	= 1;		/* mode 1 FCCH burst detection */
 406:calypso/dsp.c **** 	ndb->d_fb_det	= 0;		/* we have not yet detected a FB */
 407:calypso/dsp.c **** 	ndb->a_cd[0]	= (1<<B_FIRE1);	/* CCCH/SACCH downlink */
 408:calypso/dsp.c **** 	ndb->a_dd_0[0]	= 0;
 409:calypso/dsp.c **** 	ndb->a_dd_0[2]	= 0xffff;
 410:calypso/dsp.c **** 	ndb->a_dd_1[0]	= 0;
 411:calypso/dsp.c **** 	ndb->a_dd_1[2]	= 0xffff;
 412:calypso/dsp.c **** 	ndb->a_du_0[0]	= 0;
 413:calypso/dsp.c **** 	ndb->a_du_0[2]	= 0xffff;
 414:calypso/dsp.c **** 	ndb->a_du_1[0]	= 0;
 415:calypso/dsp.c **** 	ndb->a_du_1[2]	= 0xffff;
 416:calypso/dsp.c **** 	ndb->a_fd[0]	= (1<<B_FIRE1);
 417:calypso/dsp.c **** 	ndb->a_fd[2]	= 0xffff;
 418:calypso/dsp.c **** 	ndb->d_a5mode	= 0;
 419:calypso/dsp.c **** 	ndb->d_tch_mode	= 0x0800; /* Set ABB model to Iota */
 420:calypso/dsp.c **** 
 421:calypso/dsp.c **** 	#define GUARD_BITS 8 // 11 or 9 for TSM30, 7 for Freerunner
 422:calypso/dsp.c **** 	ndb->d_tch_mode |= (((GUARD_BITS - 4) & 0x000F) << 7); //Bit 7..10: guard bits
 423:calypso/dsp.c **** 
 424:calypso/dsp.c **** 	ndb->a_sch26[0]	= (1<<B_SCH_CRC);
 425:calypso/dsp.c **** 
 426:calypso/dsp.c **** 	/* Interrupt RIF transmit if FIFO <= threshold with threshold == 0 */
 427:calypso/dsp.c **** 	/* MCM = 1, XRST = 0, CLKX_AUTO=1, TXM=1, NCLK_EN=1, NCLK13_EN=1,
 428:calypso/dsp.c **** 	 * THRESHOLD = 0, DIV_CLK = 0 (13MHz) */
 429:calypso/dsp.c **** 	ndb->d_spcx_rif	= 0x179;
 430:calypso/dsp.c **** 
 431:calypso/dsp.c **** 	/* Init audio related parameters */
 432:calypso/dsp.c **** 	dsp_audio_init();
 433:calypso/dsp.c **** }
 434:calypso/dsp.c **** 
 435:calypso/dsp.c **** static void dsp_db_init(void)
 436:calypso/dsp.c **** {
 437:calypso/dsp.c **** 	dsp_api_memset((uint16_t *)BASE_API_W_PAGE_0, sizeof(T_DB_MCU_TO_DSP));
 438:calypso/dsp.c **** 	dsp_api_memset((uint16_t *)BASE_API_W_PAGE_1, sizeof(T_DB_MCU_TO_DSP));
 439:calypso/dsp.c **** 	dsp_api_memset((uint16_t *)BASE_API_R_PAGE_0, sizeof(T_DB_DSP_TO_MCU));
 440:calypso/dsp.c **** 	dsp_api_memset((uint16_t *)BASE_API_R_PAGE_1, sizeof(T_DB_DSP_TO_MCU));
 441:calypso/dsp.c **** }
 442:calypso/dsp.c **** 
 443:calypso/dsp.c **** void dsp_power_on(void)
 444:calypso/dsp.c **** {
 445:calypso/dsp.c **** 	/* probably a good idea to initialize the whole API area to a known value */
 446:calypso/dsp.c **** 	dsp_api_memset((uint16_t *)BASE_API_RAM, API_SIZE * 2); // size is in words
 447:calypso/dsp.c **** 
 448:calypso/dsp.c **** 	dsp_set_params((int16_t *)&dsp_params, sizeof(dsp_params)/2);
 449:calypso/dsp.c **** 	dsp_ndb_init();
 450:calypso/dsp.c **** 	dsp_db_init();
 451:calypso/dsp.c **** 	dsp_api.frame_ctr = 0;
 452:calypso/dsp.c **** 	dsp_api.r_page = dsp_api.w_page = dsp_api.r_page_used = 0;
 453:calypso/dsp.c **** }
 454:calypso/dsp.c **** 
 455:calypso/dsp.c **** /* test for frequency burst detection */
 456:calypso/dsp.c **** #define REG_INT_STAT 0xffff1004
 457:calypso/dsp.c **** static void wait_for_frame_irq(void)
 458:calypso/dsp.c **** {
 459:calypso/dsp.c **** 	//puts("Waiting for Frame Interrupt");
 460:calypso/dsp.c **** 	//while (readb(REG_INT_STAT) & 1)
 461:calypso/dsp.c **** 	while (readb((void *)0xffff1000) & (1<<4))
 462:calypso/dsp.c **** 	;//	putchar('.');
 463:calypso/dsp.c **** 	//puts("Done!\n");
 464:calypso/dsp.c **** }
 465:calypso/dsp.c **** 
 466:calypso/dsp.c **** void dsp_end_scenario(void)
 467:calypso/dsp.c **** {
 468:calypso/dsp.c **** 	/* FIXME: we don't yet deal with the MISC_TASK */
 469:calypso/dsp.c **** 
 470:calypso/dsp.c **** 	/* End the DSP Scenario */
 471:calypso/dsp.c **** 	dsp_api.ndb->d_dsp_page = B_GSM_TASK | dsp_api.w_page;
 472:calypso/dsp.c **** 	dsp_api.w_page ^= 1;
 473:calypso/dsp.c **** 
 474:calypso/dsp.c **** 	/* Tell TPU to generate a FRAME interrupt to the DSP */
 475:calypso/dsp.c **** 	tpu_dsp_frameirq_enable();
 476:calypso/dsp.c **** 	tpu_frame_irq_en(1, 1);
 477:calypso/dsp.c **** }
 478:calypso/dsp.c **** 
 479:calypso/dsp.c **** void dsp_load_rx_task(uint16_t task, uint8_t burst_id, uint8_t tsc)
 480:calypso/dsp.c **** {
 481:calypso/dsp.c **** 	dsp_api.db_w->d_task_d = task;
 482:calypso/dsp.c **** 	dsp_api.db_w->d_burst_d = burst_id;
 483:calypso/dsp.c **** 	dsp_api.db_w->d_ctrl_system |= tsc & 0x7;
 484:calypso/dsp.c **** }
 485:calypso/dsp.c **** 
 486:calypso/dsp.c **** void dsp_load_tx_task(uint16_t task, uint8_t burst_id, uint8_t tsc)
 487:calypso/dsp.c **** {
 488:calypso/dsp.c **** 	dsp_api.db_w->d_task_u = task;
 489:calypso/dsp.c **** 	dsp_api.db_w->d_burst_u = burst_id;
 490:calypso/dsp.c **** 	dsp_api.db_w->d_ctrl_system |= tsc & 0x7;
 491:calypso/dsp.c **** }
 492:calypso/dsp.c **** 
 493:calypso/dsp.c **** /* no AMR yet */
 494:calypso/dsp.c **** void dsp_load_tch_param(struct gsm_time *next_time,
 495:calypso/dsp.c ****                         uint8_t chan_mode, uint8_t chan_type, uint8_t chan_sub,
 496:calypso/dsp.c ****                         uint8_t tch_loop, uint8_t sync_tch, uint8_t tn)
 497:calypso/dsp.c **** {
 498:calypso/dsp.c **** 	uint16_t d_ctrl_tch;
 499:calypso/dsp.c **** 	uint16_t fn, a5fn0, a5fn1;
 500:calypso/dsp.c **** 
 501:calypso/dsp.c **** 	/* d_ctrl_tch
 502:calypso/dsp.c **** 	   ----------
 503:calypso/dsp.c **** 	    bit [0..3]   -> b_chan_mode
 504:calypso/dsp.c **** 	    bit [4..7]   -> b_chan_type
 505:calypso/dsp.c **** 	    bit [8]      -> b_sync_tch_ul
 506:calypso/dsp.c **** 	    bit [9]      -> b_sync_tch_dl
 507:calypso/dsp.c **** 	    bit [10]     -> b_stop_tch_ul
 508:calypso/dsp.c **** 	    bit [11]     -> b_stop_tch_dl
 509:calypso/dsp.c **** 	    bit [12..14] -> b_tch_loop
 510:calypso/dsp.c **** 	    bit [15]     -> b_subchannel */
 511:calypso/dsp.c **** 	d_ctrl_tch = (chan_mode  << B_CHAN_MODE) |
 512:calypso/dsp.c **** 		     (chan_type  << B_CHAN_TYPE)  |
 513:calypso/dsp.c **** 		     (chan_sub   << B_SUBCHANNEL) |
 514:calypso/dsp.c **** 		     (sync_tch   << B_SYNC_TCH_UL) |
 515:calypso/dsp.c **** 		     (sync_tch   << B_SYNC_TCH_DL) |
 516:calypso/dsp.c **** 		     (tch_loop   << B_TCH_LOOP);
 517:calypso/dsp.c **** 
 518:calypso/dsp.c **** 	/* used for ciphering and TCH traffic */
 519:calypso/dsp.c **** 
 520:calypso/dsp.c **** 	/* d_fn
 521:calypso/dsp.c **** 	   ----
 522:calypso/dsp.c **** 
 523:calypso/dsp.c **** 	   for TCH_F:
 524:calypso/dsp.c **** 	     bit [0..7]  -> b_fn_report = (fn - (tn * 13) + 104) % 104)
 525:calypso/dsp.c **** 	     bit [8..15] -> b_fn_sid    = (fn % 104)
 526:calypso/dsp.c **** 
 527:calypso/dsp.c **** 	   for TCH_H:
 528:calypso/dsp.c **** 	                    tn_report = (tn & ~1) | subchannel
 529:calypso/dsp.c **** 	     bit [0..7]  -> b_fn_report = (fn - tn_report * 13) + 104) % 104)
 530:calypso/dsp.c **** 	     bit [8..15] -> b_fn_sid    = (fn % 104)
 531:calypso/dsp.c **** 
 532:calypso/dsp.c **** 	   for other: irrelevant
 533:calypso/dsp.c **** 	 */
 534:calypso/dsp.c **** 
 535:calypso/dsp.c **** 	if (chan_type == TCH_F) {
 536:calypso/dsp.c **** 		fn = ((next_time->fn - (tn * 13) + 104) % 104) |
 537:calypso/dsp.c **** 		     ((next_time->fn % 104) << 8);
 538:calypso/dsp.c **** 	} else if (chan_type == TCH_H) {
 539:calypso/dsp.c **** 		uint8_t tn_report = (tn & ~1) | chan_sub;
 540:calypso/dsp.c **** 		fn = ((next_time->fn - (tn_report * 13) + 104) % 104) |
 541:calypso/dsp.c **** 		     ((next_time->fn % 104) << 8);
 542:calypso/dsp.c **** 	} else {
 543:calypso/dsp.c **** 		/* irrelevant */
 544:calypso/dsp.c **** 		fn = 0;
 545:calypso/dsp.c **** 	}
 546:calypso/dsp.c **** 
 547:calypso/dsp.c **** 	/* a_a5fn
 548:calypso/dsp.c **** 	   ------
 549:calypso/dsp.c **** 	     byte[0] bit [0..4]  -> T2
 550:calypso/dsp.c **** 	     byte[0] bit [5..10] -> T3
 551:calypso/dsp.c **** 	     byte[1] bit [0..10] -> T1 */
 552:calypso/dsp.c **** 
 553:calypso/dsp.c **** 	a5fn0 = ((uint16_t)next_time->t3 << 5) |
 554:calypso/dsp.c **** 	         (uint16_t)next_time->t2;
 555:calypso/dsp.c **** 	a5fn1 =  (uint16_t)next_time->t1;
 556:calypso/dsp.c **** 
 557:calypso/dsp.c **** 	dsp_api.db_w->d_fn        = fn;         /* Fn_sid & Fn_report  */
 558:calypso/dsp.c **** 	dsp_api.db_w->a_a5fn[0]   = a5fn0;      /* ciphering FN part 1 */
 559:calypso/dsp.c **** 	dsp_api.db_w->a_a5fn[1]   = a5fn1;      /* ciphering FN part 2 */
 560:calypso/dsp.c **** 	dsp_api.db_w->d_ctrl_tch  = d_ctrl_tch; /* Channel config.     */
 561:calypso/dsp.c **** }
 562:calypso/dsp.c **** 
 563:calypso/dsp.c **** void dsp_load_ciph_param(int mode, uint8_t *key)
 564:calypso/dsp.c **** {
 565:calypso/dsp.c **** 	dsp_api.ndb->d_a5mode = mode;
 566:calypso/dsp.c **** 
 567:calypso/dsp.c **** 	if (mode >= 3) /* Only A5/0, A5/1, A5/2 are supported by calypso */
 568:calypso/dsp.c **** 		printd("Algo A5/%u is not supported!!!\n", mode);
 569:calypso/dsp.c **** 
 570:calypso/dsp.c **** 	if (!mode || !key)
 571:calypso/dsp.c **** 		return;
 572:calypso/dsp.c **** 
 573:calypso/dsp.c **** 		/* key is expected in the same format as in RSL
 574:calypso/dsp.c **** 		 * Encryption information IE. So we need to load the
 575:calypso/dsp.c **** 		 * bytes backward in A5 unit */
 576:calypso/dsp.c **** 	dsp_api.ndb->a_kc[0] = (uint16_t)key[7] | ((uint16_t)key[6] << 8);
 577:calypso/dsp.c **** 	dsp_api.ndb->a_kc[1] = (uint16_t)key[5] | ((uint16_t)key[4] << 8);
 578:calypso/dsp.c **** 	dsp_api.ndb->a_kc[2] = (uint16_t)key[3] | ((uint16_t)key[2] << 8);
 579:calypso/dsp.c **** 	dsp_api.ndb->a_kc[3] = (uint16_t)key[1] | ((uint16_t)key[0] << 8);
 580:calypso/dsp.c **** }
