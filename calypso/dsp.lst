 107:calypso/dsp.c **** static void dsp_bl_start_at(uint16_t addr)
 108:calypso/dsp.c **** {
 109:calypso/dsp.c **** 	writew(0, BL_ADDR_HI);
 110:calypso/dsp.c **** 	writew(addr, BL_ADDR_LO);
 111:calypso/dsp.c **** 	writew(0, BL_SIZE);
 112:calypso/dsp.c **** 	writew(BL_CMD_COPY_BLOCK, BL_CMD_STATUS);
 113:calypso/dsp.c **** }
 114:calypso/dsp.c **** 
 115:calypso/dsp.c **** static int dsp_bl_upload_sections(const struct dsp_section *sec)
 116:calypso/dsp.c **** {
 117:calypso/dsp.c **** 	/* Make sure the bootloader is ready */
 118:calypso/dsp.c **** 	dsp_bl_wait_ready();
 119:calypso/dsp.c **** 
 120:calypso/dsp.c **** 	/* Set mode */
 121:calypso/dsp.c **** 	writew(BL_MODE_DATA_WRITE, BASE_API_RAM);
 122:calypso/dsp.c **** 	writew(BL_CMD_COPY_MODE, BL_CMD_STATUS);
 123:calypso/dsp.c **** 	dsp_bl_wait_ready();
 124:calypso/dsp.c **** 
 125:calypso/dsp.c **** 	/* Scan all sections */
 126:calypso/dsp.c **** 	for (; sec->data; sec++) {
 127:calypso/dsp.c **** 		volatile uint16_t *api = (volatile uint16_t *)BASE_API_RAM;
 128:calypso/dsp.c **** 		unsigned int i;
 129:calypso/dsp.c **** 
 130:calypso/dsp.c **** 		if (sec->size > BL_MAX_BLOCK_SIZE)
 131:calypso/dsp.c **** 			return -1; /* not supported for now */
 132:calypso/dsp.c **** 
 133:calypso/dsp.c **** 		/* Copy data to API */
 134:calypso/dsp.c **** 		for (i=0; i<sec->size; i++)
 135:calypso/dsp.c **** 			api[i] = sec->data[i];
 136:calypso/dsp.c **** 
 137:calypso/dsp.c **** 		/* Issue DRAM write */
 138:calypso/dsp.c **** 		writew(sec->addr >> 16, BL_ADDR_HI);
 139:calypso/dsp.c **** 		writew(sec->addr & 0xffff, BL_ADDR_LO);
 140:calypso/dsp.c **** 		writew(sec->size, BL_SIZE);
 141:calypso/dsp.c **** 		writew(BL_CMD_COPY_BLOCK, BL_CMD_STATUS);
 142:calypso/dsp.c **** 
 143:calypso/dsp.c **** 		/* Wait for completion */
 144:calypso/dsp.c **** 		dsp_bl_wait_ready();
 145:calypso/dsp.c **** 	}
 146:calypso/dsp.c **** 
 147:calypso/dsp.c **** 	return 0;
 148:calypso/dsp.c **** }
