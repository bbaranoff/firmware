 173:calypso/dsp.c **** static void dsp_pre_boot(const struct dsp_section *bootcode)
 174:calypso/dsp.c **** {
 175:calypso/dsp.c **** 	dputs("Assert DSP into Reset\n");
 176:calypso/dsp.c **** 	calypso_reset_set(RESET_DSP, 1);
 177:calypso/dsp.c **** 
 178:calypso/dsp.c **** 	if (bootcode) {
 179:calypso/dsp.c **** 		dputs("Loading initial DSP bootcode (API boot mode)\n");
 180:calypso/dsp.c **** 		dsp_upload_sections_api(bootcode, DSP_BASE_API_MIRROR);
 181:calypso/dsp.c **** 
 182:calypso/dsp.c **** 		writew(BL_STATUS_NA, BL_CMD_STATUS);
 183:calypso/dsp.c **** 	} else
 184:calypso/dsp.c **** 		delay_ms(10);
 185:calypso/dsp.c **** 
 186:calypso/dsp.c **** 	dputs("Releasing DSP from Reset\n");
 187:calypso/dsp.c **** 	calypso_reset_set(RESET_DSP, 0);
 188:calypso/dsp.c **** 
 189:calypso/dsp.c **** 	/* Wait 10 us */
 190:calypso/dsp.c **** 	delay_ms(100);
 191:calypso/dsp.c **** 
 192:calypso/dsp.c **** 	dsp_bl_wait_ready();
 193:calypso/dsp.c **** }
