 233:calypso/dsp.c **** void dsp_api_memset(uint16_t *ptr, int octets)
 234:calypso/dsp.c **** {
 235:calypso/dsp.c **** 	uint16_t i;
 236:calypso/dsp.c **** 	for (i = 0; i < octets / sizeof(uint16_t); i++)
 237:calypso/dsp.c **** 		*ptr++ = 0;
 238:calypso/dsp.c **** }
