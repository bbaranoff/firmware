 199:calypso/dsp.c **** 
 200:calypso/dsp.c **** 	/* Start DSP up to bootloader */
 201:calypso/dsp.c **** 	dsp_pre_boot(dsp_bootcode);
 202:calypso/dsp.c **** 
 203:calypso/dsp.c **** 	/* FIXME: Implement Patch download, if any */
 204:calypso/dsp.c **** 
 205:calypso/dsp.c **** 	dputs("Setting some dsp_api.ndb values\n");
 206:calypso/dsp.c **** 	dsp_api.ndb->d_background_enable = 0;
 207:calypso/dsp.c **** 	dsp_api.ndb->d_background_abort = 0;
 208:calypso/dsp.c **** 	dsp_api.ndb->d_background_state = 0;
 209:calypso/dsp.c **** 	dsp_api.ndb->d_debug_ptr = 0x0074;
 210:calypso/dsp.c **** 	dsp_api.ndb->d_debug_bk = 0x0001;
 211:calypso/dsp.c **** 	dsp_api.ndb->d_pll_config = 0x154; //C_PLL_CONFIG;
 212:calypso/dsp.c **** 	dsp_api.ndb->p_debug_buffer = 0x17ff; //C_DEBUG_BUFFER_ADD;
 213:calypso/dsp.c **** 	dsp_api.ndb->d_debug_buffer_size = 7; //C_DEBUG_BUFFER_SIZE;
 214:calypso/dsp.c **** 	dsp_api.ndb->d_debug_trace_type = 0; //C_DEBUG_TRACE_TYPE;
 215:calypso/dsp.c **** 	dsp_api.ndb->d_dsp_state = 3; //C_DSP_IDLE3;
 216:calypso/dsp.c **** 	dsp_api.ndb->d_audio_gain_ul = 0;
 217:calypso/dsp.c **** 	dsp_api.ndb->d_audio_gain_dl = 0;
 218:calypso/dsp.c **** 	dsp_api.ndb->d_es_level_api = 0x5213;
 219:calypso/dsp.c **** 	dsp_api.ndb->d_mu_api = 0x5000;
 220:calypso/dsp.c **** 
 221:calypso/dsp.c **** 	dputs("Setting API NDB parameters\n");
 222:calypso/dsp.c **** 	for (i = 0; i < param_size; i ++)
 223:calypso/dsp.c **** 		*param_ptr++ = param_tab[i];
 224:calypso/dsp.c **** 	
 225:calypso/dsp.c **** 	dsp_dump_version();
 226:calypso/dsp.c **** 
 227:calypso/dsp.c **** 	dputs("Finishing download phase\n");
 228:calypso/dsp.c **** 	dsp_bl_start_at(DSP_START);
 229:calypso/dsp.c **** 
 230:calypso/dsp.c **** 	dsp_dump_version();
 231:calypso/dsp.c **** }
