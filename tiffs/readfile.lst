 119:tiffs/readfile.c **** static int get_file_head(const char *pathname, uint8_t **startret,
 120:tiffs/readfile.c **** 			 size_t *sizeret, int *continue_ret)
 121:tiffs/readfile.c **** {
 122:tiffs/readfile.c **** 	struct tiffs_inode *irec;
 123:tiffs/readfile.c **** 	uint8_t *start, *end;
 124:tiffs/readfile.c **** 	int ino, cont, size;
 125:tiffs/readfile.c **** 
 126:tiffs/readfile.c **** 	ino = pathname_to_inode(pathname);
 127:tiffs/readfile.c **** 	if (ino <= 0)
 128:tiffs/readfile.c **** 		return ino;
 129:tiffs/readfile.c **** 
 130:tiffs/readfile.c **** 	irec = tiffs_active_index + ino;
 131:tiffs/readfile.c **** 	if (irec->type != TIFFS_OBJTYPE_FILE) {
 132:tiffs/readfile.c **** 		printf("TIFFS error: '%s' is not a regular file\n", pathname);
 133:tiffs/readfile.c **** 		return -1;
 134:tiffs/readfile.c **** 	}
 135:tiffs/readfile.c **** 
 136:tiffs/readfile.c **** 	start = INODE_TO_DATAPTR(irec);
 137:tiffs/readfile.c **** 	start += strlen((const char *) start) + 1;
 138:tiffs/readfile.c **** 	end = find_endofchunk(ino);
 139:tiffs/readfile.c **** 
 140:tiffs/readfile.c **** 	size = end - start;
 141:tiffs/readfile.c **** 	if (size < 0)
 142:tiffs/readfile.c **** 		size = 0;
 143:tiffs/readfile.c **** 
 144:tiffs/readfile.c **** 	cont = irec->descend;
 145:tiffs/readfile.c **** 	if (cont == 0xFFFF)
 146:tiffs/readfile.c **** 		cont = 0;
 147:tiffs/readfile.c **** 	if (startret)
 148:tiffs/readfile.c **** 		*startret = start;
 149:tiffs/readfile.c **** 	if (sizeret)
 150:tiffs/readfile.c **** 		*sizeret = size;
 151:tiffs/readfile.c **** 	if (continue_ret)
 152:tiffs/readfile.c **** 		*continue_ret = cont;
 153:tiffs/readfile.c **** 
 154:tiffs/readfile.c **** 	return 1;
 155:tiffs/readfile.c **** }
 156:tiffs/readfile.c **** 
 157:tiffs/readfile.c **** static int get_segment(int ino, uint8_t **startret,
 158:tiffs/readfile.c **** 		       size_t *sizeret, int *continue_ret)
 159:tiffs/readfile.c **** {
 160:tiffs/readfile.c **** 	struct tiffs_inode *irec;
 161:tiffs/readfile.c **** 	uint8_t *start, *end;
 162:tiffs/readfile.c **** 	int cont, size;
 163:tiffs/readfile.c **** 
 164:tiffs/readfile.c **** 	for (;;) {
 165:tiffs/readfile.c **** 		irec = tiffs_active_index + ino;
 166:tiffs/readfile.c **** 		if (irec->type)
 167:tiffs/readfile.c **** 			break;
 168:tiffs/readfile.c **** 		if (irec->sibling == 0xFFFF) {
 169:tiffs/readfile.c **** 			printf("TIFFS error: segment inode #%d: "
 170:tiffs/readfile.c **** 				"deleted and no sibling\n", ino);
 171:tiffs/readfile.c **** 			return -1;
 172:tiffs/readfile.c **** 		}
 173:tiffs/readfile.c **** 		ino = irec->sibling;
 174:tiffs/readfile.c **** 	}
 175:tiffs/readfile.c **** 
 176:tiffs/readfile.c **** 	if (irec->type != TIFFS_OBJTYPE_SEGMENT) {
 177:tiffs/readfile.c **** 		printf("TIFFS error: inode #%x is not a segment\n", ino);
 178:tiffs/readfile.c **** 		return -1;
 179:tiffs/readfile.c **** 	}
 180:tiffs/readfile.c **** 
 181:tiffs/readfile.c **** 	start = INODE_TO_DATAPTR(irec);
 182:tiffs/readfile.c **** 	end = find_endofchunk(ino);
 183:tiffs/readfile.c **** 
 184:tiffs/readfile.c **** 	size = end - start;
 185:tiffs/readfile.c **** 	if (size <= 0) {
 186:tiffs/readfile.c **** 		printf("TIFFS error: segment inode #%x has bad length\n", ino);
 187:tiffs/readfile.c **** 		return -1;
 188:tiffs/readfile.c **** 	}
 189:tiffs/readfile.c **** 
 190:tiffs/readfile.c **** 	cont = irec->descend;
 191:tiffs/readfile.c **** 	if (cont == 0xFFFF)
 192:tiffs/readfile.c **** 		cont = 0;
 193:tiffs/readfile.c **** 	if (startret)
 194:tiffs/readfile.c **** 		*startret = start;
 195:tiffs/readfile.c **** 	if (sizeret)
 196:tiffs/readfile.c **** 		*sizeret = size;
 197:tiffs/readfile.c **** 	if (continue_ret)
 198:tiffs/readfile.c **** 		*continue_ret = cont;
 199:tiffs/readfile.c **** 
 200:tiffs/readfile.c **** 	return 0;
 201:tiffs/readfile.c **** }
