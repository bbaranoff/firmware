  31:tiffs/readfile.c **** #define	MAX_FN_COMPONENT	20
  32:tiffs/readfile.c **** 
  33:tiffs/readfile.c **** static unsigned find_named_child(unsigned start, const char *seekname)
  34:tiffs/readfile.c **** {
  35:tiffs/readfile.c **** 	struct tiffs_inode *irec;
  36:tiffs/readfile.c **** 	unsigned ino;
  37:tiffs/readfile.c **** 
  38:tiffs/readfile.c **** 	for (ino = start; ino != 0xFFFF; ino = irec->sibling) {
  39:tiffs/readfile.c **** 		irec = tiffs_active_index + ino;
  40:tiffs/readfile.c **** 		if (!irec->type)
  41:tiffs/readfile.c **** 			continue;
  42:tiffs/readfile.c **** 		if (!strcmp((const char *) INODE_TO_DATAPTR(irec), seekname))
  43:tiffs/readfile.c **** 			return ino;
  44:tiffs/readfile.c **** 	}
  45:tiffs/readfile.c **** 
  46:tiffs/readfile.c **** 	return 0;
  47:tiffs/readfile.c **** }
  48:tiffs/readfile.c **** 
  49:tiffs/readfile.c **** static int pathname_to_inode(const char *pathname)
  50:tiffs/readfile.c **** {
  51:tiffs/readfile.c **** 	char seekname[MAX_FN_COMPONENT + 1];
  52:tiffs/readfile.c **** 	struct tiffs_inode *irec;
  53:tiffs/readfile.c **** 	const char *cur, *next;
  54:tiffs/readfile.c **** 	unsigned ino, namelen;
  55:tiffs/readfile.c **** 
  56:tiffs/readfile.c **** 	cur = pathname;
  57:tiffs/readfile.c **** 	if (*cur == '/')
  58:tiffs/readfile.c **** 		cur++;
  59:tiffs/readfile.c **** 
  60:tiffs/readfile.c **** 	for (ino = tiffs_root_ino; cur; cur = next) {
  61:tiffs/readfile.c **** 		if (!*cur)
  62:tiffs/readfile.c **** 			break;
  63:tiffs/readfile.c **** 
  64:tiffs/readfile.c **** 		next = index(cur, '/');
  65:tiffs/readfile.c **** 		if (next == cur) {
  66:tiffs/readfile.c **** 			puts("Malformed TIFFS pathname: multiple adjacent slashes\n");
  67:tiffs/readfile.c **** 			return -1;
  68:tiffs/readfile.c **** 		} else if (next) {
  69:tiffs/readfile.c **** 			namelen = next - cur;
  70:tiffs/readfile.c **** 			next++;
  71:tiffs/readfile.c **** 		} else {
  72:tiffs/readfile.c **** 			namelen = strlen(cur);
  73:tiffs/readfile.c **** 		}
  74:tiffs/readfile.c **** 
  75:tiffs/readfile.c **** 		if (namelen > MAX_FN_COMPONENT) {
  76:tiffs/readfile.c **** 			puts("Malformed TIFFS pathname: component name too long\n");
  77:tiffs/readfile.c **** 			return -1;
  78:tiffs/readfile.c **** 		}
  79:tiffs/readfile.c **** 
  80:tiffs/readfile.c **** 		memcpy(seekname, cur, namelen);
  81:tiffs/readfile.c **** 		seekname[namelen] = '\0';
  82:tiffs/readfile.c **** 
  83:tiffs/readfile.c **** 		irec = tiffs_active_index + ino;
  84:tiffs/readfile.c **** 		if (irec->type != TIFFS_OBJTYPE_DIR) {
  85:tiffs/readfile.c **** 			/* printf("Error: non-terminal non-directory\n"); */
  86:tiffs/readfile.c **** 			return 0;
  87:tiffs/readfile.c **** 		}
  88:tiffs/readfile.c **** 		ino = find_named_child(irec->descend, seekname);
  89:tiffs/readfile.c **** 		if (!ino) {
  90:tiffs/readfile.c **** 			/* printf("Error: pathname component not found\n"); */
  91:tiffs/readfile.c **** 			return 0;
  92:tiffs/readfile.c **** 		}
  93:tiffs/readfile.c **** 	}
  94:tiffs/readfile.c **** 
  95:tiffs/readfile.c **** 	return ino;
  96:tiffs/readfile.c **** }
