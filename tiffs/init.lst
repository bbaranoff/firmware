  29:tiffs/init.c  **** 
  30:tiffs/init.c  **** /* Each flash sector used for TIFFS begins with this 6-byte signature */
  31:tiffs/init.c  **** static const uint8_t ffs_sector_signature[6] = {
  32:tiffs/init.c  **** 	'F', 'f', 's', '#', 0x10, 0x02
  33:tiffs/init.c  **** };
  34:tiffs/init.c  **** 
  35:tiffs/init.c  **** static int find_indexblk(void)
  36:tiffs/init.c  **** {
  37:tiffs/init.c  **** 	uint32_t sector_addr;
  38:tiffs/init.c  **** 	uint8_t *sector_ptr;
  39:tiffs/init.c  **** 	unsigned i;
  40:tiffs/init.c  **** 
  41:tiffs/init.c  **** 	sector_addr = tiffs_base_addr;
  42:tiffs/init.c  **** 	for (i = 0; i < tiffs_nsectors; i++) {
  43:tiffs/init.c  **** 		sector_ptr = (uint8_t *) sector_addr;
  44:tiffs/init.c  **** 		if (!memcmp(sector_ptr, ffs_sector_signature, 6)
  45:tiffs/init.c  **** 		    && sector_ptr[8] == 0xAB) {
  46:tiffs/init.c  **** 			printf("Found TIFFS active index block "
  47:tiffs/init.c  **** 				"at 0x%" PRIx32 "\n", sector_addr);
  48:tiffs/init.c  **** 			tiffs_active_index = (struct tiffs_inode *) sector_addr;
  49:tiffs/init.c  **** 			return 0;
  50:tiffs/init.c  **** 		}
  51:tiffs/init.c  **** 		sector_addr += tiffs_sector_size;
  52:tiffs/init.c  **** 	}
  53:tiffs/init.c  **** 
  54:tiffs/init.c  **** 	puts("TIFFS error: no active index block found\n");
  55:tiffs/init.c  **** 	return -1;
  56:tiffs/init.c  **** }
  57:tiffs/init.c  **** 
  58:tiffs/init.c  **** static int find_rootino(void)
  59:tiffs/init.c  **** {
  60:tiffs/init.c  **** 	struct tiffs_inode *irec;
  61:tiffs/init.c  **** 	unsigned ino = 0;
  62:tiffs/init.c  **** 
  63:tiffs/init.c  **** 	while (++ino < tiffs_sector_size >> 4) {
  64:tiffs/init.c  **** 		irec = tiffs_active_index + ino;
  65:tiffs/init.c  **** 		if (irec->type != TIFFS_OBJTYPE_DIR)
  66:tiffs/init.c  **** 			continue;
  67:tiffs/init.c  **** 		if (*INODE_TO_DATAPTR(irec) != '/')
  68:tiffs/init.c  **** 			continue;
  69:tiffs/init.c  **** 
  70:tiffs/init.c  **** 		printf("Found TIFFS root inode at #%x\n", ino);
  71:tiffs/init.c  **** 		tiffs_root_ino = ino;
  72:tiffs/init.c  **** 		return 0;
  73:tiffs/init.c  **** 	}
  74:tiffs/init.c  **** 
  75:tiffs/init.c  **** 	puts("TIFFS error: no root inode found\n");
  76:tiffs/init.c  **** 	return -1;
  77:tiffs/init.c  **** }
