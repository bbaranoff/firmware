  32:abb/twl3025.c **** /* TWL3025 */
  33:abb/twl3025.c **** #define REG_PAGE(n)	(n >> 7)
  34:abb/twl3025.c **** #define REG_ADDR(n)	(n & 0x3f)
  35:abb/twl3025.c **** 
  36:abb/twl3025.c **** #define TWL3025_DEV_IDX		0	/* On the SPI bus */
  37:abb/twl3025.c **** #define TWL3025_TSP_DEV_IDX	0	/* On the TSP bus */
  38:abb/twl3025.c **** 
  39:abb/twl3025.c **** /* values encountered on a GTA-02 for GSM900 (the same for GSM1800!?) */
  40:abb/twl3025.c **** const uint16_t twl3025_default_ramp[16] = {
  41:abb/twl3025.c **** 	ABB_RAMP_VAL( 0,  0),
  42:abb/twl3025.c **** 	ABB_RAMP_VAL( 0, 11),
  43:abb/twl3025.c **** 	ABB_RAMP_VAL( 0, 31),
  44:abb/twl3025.c **** 	ABB_RAMP_VAL( 0, 31),
  45:abb/twl3025.c **** 	ABB_RAMP_VAL( 0, 31),
  46:abb/twl3025.c **** 	ABB_RAMP_VAL( 0, 24),
  47:abb/twl3025.c **** 	ABB_RAMP_VAL( 0,  0),
  48:abb/twl3025.c **** 	ABB_RAMP_VAL( 0,  0),
  49:abb/twl3025.c **** 	ABB_RAMP_VAL( 9,  0),
  50:abb/twl3025.c **** 	ABB_RAMP_VAL(18,  0),
  51:abb/twl3025.c **** 	ABB_RAMP_VAL(25,  0),
  52:abb/twl3025.c **** 	ABB_RAMP_VAL(31,  0),
  53:abb/twl3025.c **** 	ABB_RAMP_VAL(30,  0),
  54:abb/twl3025.c **** 	ABB_RAMP_VAL(15,  0),
  55:abb/twl3025.c **** 	ABB_RAMP_VAL( 0,  0),
  56:abb/twl3025.c **** 	ABB_RAMP_VAL( 0,  0),
  57:abb/twl3025.c **** };
  58:abb/twl3025.c **** 
  59:abb/twl3025.c **** typedef enum pwon_state {
  60:abb/twl3025.c **** 	PWON_IDLE,
  61:abb/twl3025.c **** 	PWON_DETECTED,
  62:abb/twl3025.c **** 	PWON_REPORTED,
  63:abb/twl3025.c **** } pwon_state_t;
  64:abb/twl3025.c **** 
  65:abb/twl3025.c **** struct twl3025 {
  66:abb/twl3025.c **** 	uint8_t page;
  67:abb/twl3025.c **** 	pwon_state_t pwon;
  68:abb/twl3025.c **** };
  69:abb/twl3025.c **** static struct twl3025 twl3025_state;
  70:abb/twl3025.c **** 
  71:abb/twl3025.c **** /* Switch the register page of the TWL3025 */
  72:abb/twl3025.c **** static void twl3025_switch_page(uint8_t page)
  73:abb/twl3025.c **** {
  74:abb/twl3025.c **** 	if (page == 0)
  75:abb/twl3025.c **** 		twl3025_reg_write(PAGEREG, 1 << 0);
  76:abb/twl3025.c **** 	else
  77:abb/twl3025.c **** 		twl3025_reg_write(PAGEREG, 1 << 1);
  78:abb/twl3025.c **** 
  79:abb/twl3025.c **** 	twl3025_state.page = page;
  80:abb/twl3025.c **** }
  81:abb/twl3025.c **** 
  82:abb/twl3025.c **** static void handle_charger(void)
  83:abb/twl3025.c **** {
  84:abb/twl3025.c **** 	uint16_t status;
  85:abb/twl3025.c **** 	printd("handle_charger();");
  86:abb/twl3025.c **** 
  87:abb/twl3025.c **** 	status = twl3025_reg_read(VRPCSTS);
  88:abb/twl3025.c **** //	printd("\nvrpcsts: 0x%02x", status);
  89:abb/twl3025.c **** 
  90:abb/twl3025.c **** 	if (status & 0x40) {
  91:abb/twl3025.c **** 		printd(" inserted\n");
  92:abb/twl3025.c **** 	} else {
  93:abb/twl3025.c **** 		printd(" removed\n");
  94:abb/twl3025.c **** 	}
  95:abb/twl3025.c **** 
  96:abb/twl3025.c **** //	twl3025_dump_madc();
  97:abb/twl3025.c **** }
  98:abb/twl3025.c **** 
  99:abb/twl3025.c **** static void handle_adc_done(void)
 100:abb/twl3025.c **** {
 101:abb/twl3025.c **** 	printd("handle_adc_done();");
 102:abb/twl3025.c **** }
 103:abb/twl3025.c **** 
 104:abb/twl3025.c **** static void twl3025_irq(enum irq_nr nr)
 105:abb/twl3025.c **** {
 106:abb/twl3025.c **** 	uint16_t src;
 107:abb/twl3025.c **** 	printd("twl3025_irq: 0x%02x\n",nr);
 108:abb/twl3025.c **** 	switch (nr){
 109:abb/twl3025.c **** 	case IRQ_EXTERNAL: // charger in/out, pwrbtn, adc done
 110:abb/twl3025.c **** 		src = twl3025_reg_read(ITSTATREG);
 111:abb/twl3025.c **** //		printd("itstatreg 0x%02x\n", src);
 112:abb/twl3025.c **** 		if ((src & 0x04) && twl3025_state.pwon == PWON_IDLE)
 113:abb/twl3025.c **** 			twl3025_state.pwon = PWON_DETECTED;
 114:abb/twl3025.c **** 		if (src & 0x08)
 115:abb/twl3025.c **** 			handle_charger();
 116:abb/twl3025.c **** 		if (src & 0x20)
 117:abb/twl3025.c **** 			handle_adc_done();
 118:abb/twl3025.c **** 		break;
 119:abb/twl3025.c **** 	case IRQ_EXTERNAL_FIQ: // vcc <2.8V emergency power off
 120:abb/twl3025.c **** 		puts("\nBROWNOUT!1!");
 121:abb/twl3025.c **** 		twl3025_power_off();
 122:abb/twl3025.c **** 		break;
 123:abb/twl3025.c **** 	default:
 124:abb/twl3025.c **** 		return;
 125:abb/twl3025.c **** 	}
 126:abb/twl3025.c **** }
 127:abb/twl3025.c **** 
 128:abb/twl3025.c **** void twl3025_init(void)
 129:abb/twl3025.c **** {
 130:abb/twl3025.c **** 	spi_init();
 131:abb/twl3025.c **** 	twl3025_switch_page(0);
 132:abb/twl3025.c **** 	twl3025_clk13m(1);
 133:abb/twl3025.c **** 	twl3025_reg_write(AFCCTLADD, 0x01);	/* AFCCK(1:0) must not be zero! */
 134:abb/twl3025.c **** 	twl3025_unit_enable(TWL3025_UNIT_AFC, 1);
 135:abb/twl3025.c **** 	twl3025_state.pwon = PWON_IDLE;
 136:abb/twl3025.c **** 
 137:abb/twl3025.c **** 	irq_register_handler(IRQ_EXTERNAL, &twl3025_irq);
 138:abb/twl3025.c **** 	irq_config(IRQ_EXTERNAL, 0, 0, 0);
 139:abb/twl3025.c **** 	irq_enable(IRQ_EXTERNAL);
 140:abb/twl3025.c **** 
 141:abb/twl3025.c **** 	irq_register_handler(IRQ_EXTERNAL_FIQ, &twl3025_irq);
 142:abb/twl3025.c **** 	irq_config(IRQ_EXTERNAL_FIQ, 1, 0, 0);
 143:abb/twl3025.c **** 	irq_enable(IRQ_EXTERNAL_FIQ);
 144:abb/twl3025.c **** }
 145:abb/twl3025.c **** 
 146:abb/twl3025.c **** void twl3025_reg_write(uint8_t reg, uint16_t data)
 147:abb/twl3025.c **** {
 148:abb/twl3025.c **** 	uint16_t tx;
 149:abb/twl3025.c **** 
 150:abb/twl3025.c **** 	printd("tw3025_reg_write(%u,%u)=0x%04x\n", REG_PAGE(reg),
 151:abb/twl3025.c **** 		REG_ADDR(reg), data);
 152:abb/twl3025.c **** 
 153:abb/twl3025.c **** 	if (reg != PAGEREG && REG_PAGE(reg) != twl3025_state.page)
 154:abb/twl3025.c **** 		twl3025_switch_page(REG_PAGE(reg));
 155:abb/twl3025.c **** 
 156:abb/twl3025.c **** 	tx = ((data & 0x3ff) << 6) | (REG_ADDR(reg) << 1);
 157:abb/twl3025.c **** 
 158:abb/twl3025.c **** 	spi_xfer(TWL3025_DEV_IDX, 16, &tx, NULL);
 159:abb/twl3025.c **** }
 160:abb/twl3025.c **** 
 161:abb/twl3025.c **** void twl3025_tsp_write(uint8_t data)
 162:abb/twl3025.c **** {
 163:abb/twl3025.c **** 	tsp_write(TWL3025_TSP_DEV_IDX, 7, data);
 164:abb/twl3025.c **** }
 165:abb/twl3025.c **** 
 166:abb/twl3025.c **** uint16_t twl3025_reg_read(uint8_t reg)
 167:abb/twl3025.c **** {
 168:abb/twl3025.c **** 	uint16_t tx, rx;
 169:abb/twl3025.c **** 
 170:abb/twl3025.c **** 	if (REG_PAGE(reg) != twl3025_state.page)
 171:abb/twl3025.c **** 		twl3025_switch_page(REG_PAGE(reg));
 172:abb/twl3025.c **** 
 173:abb/twl3025.c **** 	tx = (REG_ADDR(reg) << 1) | 1;
 174:abb/twl3025.c **** 
 175:abb/twl3025.c **** 	/* A read cycle contains two SPI transfers */
 176:abb/twl3025.c **** 	spi_xfer(TWL3025_DEV_IDX, 16, &tx, &rx);
 177:abb/twl3025.c **** 	delay_ms(1);
 178:abb/twl3025.c **** 	spi_xfer(TWL3025_DEV_IDX, 16, &tx, &rx);
 179:abb/twl3025.c **** 
 180:abb/twl3025.c **** 	rx >>= 6;
 181:abb/twl3025.c **** 
 182:abb/twl3025.c **** 	printd("tw3025_reg_read(%u,%u)=0x%04x\n", REG_PAGE(reg),
 183:abb/twl3025.c **** 		REG_ADDR(reg), rx);
 184:abb/twl3025.c **** 
 185:abb/twl3025.c **** 	return rx;
 186:abb/twl3025.c **** }
