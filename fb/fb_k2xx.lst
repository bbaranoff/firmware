  27:fb/fb_k2xx.c  **** 
  28:fb/fb_k2xx.c  **** #define K2XX_WIDTH		128
  29:fb/fb_k2xx.c  **** #define K2XX_HEIGHT		128
  30:fb/fb_k2xx.c  **** 
  31:fb/fb_k2xx.c  **** #define ARMIO_LATCH_OUT		0xfffe4802
  32:fb/fb_k2xx.c  **** #define CS3_ADDR		0x02000000
  33:fb/fb_k2xx.c  **** 
  34:fb/fb_k2xx.c  **** #define DISPLAY_CMD_ADDR	(CS3_ADDR + 0)
  35:fb/fb_k2xx.c  **** #define DISPLAY_DATA_ADDR	(CS3_ADDR + 2)
  36:fb/fb_k2xx.c  **** #define CL761_INDEX_ADDR	(CS3_ADDR + 4)
  37:fb/fb_k2xx.c  **** #define CL761_DATA_ADDR		(CS3_ADDR + 6)
  38:fb/fb_k2xx.c  **** 
  39:fb/fb_k2xx.c  **** #define CL761_CLK		(1 << 4)
  40:fb/fb_k2xx.c  **** #define CL761_RESET		(1 << 9)
  41:fb/fb_k2xx.c  **** #define K2XX_ENABLE_BACKLIGHT	(1 << 3)
  42:fb/fb_k2xx.c  **** 
  43:fb/fb_k2xx.c  **** static uint8_t fb_k2xx_mem[K2XX_WIDTH * K2XX_HEIGHT];
  44:fb/fb_k2xx.c  **** 
  45:fb/fb_k2xx.c  **** static const uint8_t k2xx_initdata[] = {
  46:fb/fb_k2xx.c  **** 	0x2c,	/* CMD:  Standby Mode off */
  47:fb/fb_k2xx.c  **** 	0x02,	/* CMD:  Oscillation Mode Set */
  48:fb/fb_k2xx.c  **** 	0x01,	/* DATA: oscillator on */
  49:fb/fb_k2xx.c  **** 	0x26,	/* CMD:  DCDC and AMP ON/OFF set */
  50:fb/fb_k2xx.c  **** 	0x01,	/* DATA: Booster 1 on */
  51:fb/fb_k2xx.c  **** 	0x26,	/* CMD:  DCDC and AMP ON/OFF set */
  52:fb/fb_k2xx.c  **** 	0x09,	/* DATA: Booster 1 on, OP-AMP on */
  53:fb/fb_k2xx.c  **** 	0x26,	/* CMD:  DCDC and AMP ON/OFF set */
  54:fb/fb_k2xx.c  **** 	0x0b,	/* DATA: Booster 1 + 2 on, OP-AMP on */
  55:fb/fb_k2xx.c  **** 	0x26,	/* CMD:  DCDC and AMP ON/OFF set */
  56:fb/fb_k2xx.c  **** 	0x0f,	/* DATA: Booster 1 + 2 + 3 on, OP-AMP on */
  57:fb/fb_k2xx.c  **** 	0x10,	/* CMD:  Driver output mode set */
  58:fb/fb_k2xx.c  **** 	0x00,	/* DATA: Display duty: 1/66 */
  59:fb/fb_k2xx.c  **** 	0x20,	/* CMD:  DC-DC Select */
  60:fb/fb_k2xx.c  **** 	0x01,	/* DATA: step up x1.5 */
  61:fb/fb_k2xx.c  **** 	0x24,	/* CMD:  DCDC Clock Division Set */
  62:fb/fb_k2xx.c  **** 	0x08,	/* DATA: fPCK = fOSC/32 */
  63:fb/fb_k2xx.c  **** 	0x28,	/* CMD:  Temperature Compensation set */
  64:fb/fb_k2xx.c  **** 	0x02,	/* DATA: slope -0.10%/degC */
  65:fb/fb_k2xx.c  **** 	0x2a,	/* CMD:  Contrast Control */
  66:fb/fb_k2xx.c  **** 	0x1d,	/* DATA: Constrast Level 29 */
  67:fb/fb_k2xx.c  **** 	0x30,	/* CMD:  Addressing mode set */
  68:fb/fb_k2xx.c  **** 	0x53,	/* DATA: 256 color mode (orignal FW uses 0x13, 65k colors) */
  69:fb/fb_k2xx.c  **** 	0x32,	/* CMD:  ROW vector mode set */
  70:fb/fb_k2xx.c  **** 	0x0e,	/* DATA: every subframe */
  71:fb/fb_k2xx.c  **** 	0x34,	/* CMD:  N-block inversion set */
  72:fb/fb_k2xx.c  **** 	0x8d,	/* DATA: inversion on, every 1 block and every 2 frames */
  73:fb/fb_k2xx.c  **** 	0x36,	/* CMD:  unknown */
  74:fb/fb_k2xx.c  **** 	0x00,	/* DATA: unknown */
  75:fb/fb_k2xx.c  **** 	0x40,	/* CMD:  Entry mode set */
  76:fb/fb_k2xx.c  **** 	0x80,	/* DATA: Y address counter mode */
  77:fb/fb_k2xx.c  **** 	0x45,	/* CMD:  RAM Skip Area Set */
  78:fb/fb_k2xx.c  **** 	0x00,	/* DATA: No Skip */
  79:fb/fb_k2xx.c  **** 	0x53,	/* CMD:  Specified Display Pattern Set */
  80:fb/fb_k2xx.c  **** 	0x00,	/* DATA: Normal display */
  81:fb/fb_k2xx.c  **** 	0x55,	/* CMD:  Partial Display Mode Set */
  82:fb/fb_k2xx.c  **** 	0x00,	/* DATA: Partial display OFF */
  83:fb/fb_k2xx.c  **** 	0x51,	/* CMD:  Display on */
  84:fb/fb_k2xx.c  **** };
  85:fb/fb_k2xx.c  **** 
  86:fb/fb_k2xx.c  **** uint16_t cl761_read_reg(uint16_t reg)
  87:fb/fb_k2xx.c  **** {
  88:fb/fb_k2xx.c  **** 	writew(reg, CL761_INDEX_ADDR);
  89:fb/fb_k2xx.c  **** 	return readw(CL761_INDEX_ADDR);
  90:fb/fb_k2xx.c  **** }
  91:fb/fb_k2xx.c  **** 
  92:fb/fb_k2xx.c  **** void cl761_write_reg(uint8_t reg, uint16_t data)
  93:fb/fb_k2xx.c  **** {
  94:fb/fb_k2xx.c  **** 	writew(reg, CL761_INDEX_ADDR);
  95:fb/fb_k2xx.c  **** 	writew(data, CL761_DATA_ADDR);
  96:fb/fb_k2xx.c  **** }
  97:fb/fb_k2xx.c  **** 
  98:fb/fb_k2xx.c  **** static void fb_k2xx_init(void)
  99:fb/fb_k2xx.c  **** {
 100:fb/fb_k2xx.c  **** 	unsigned int i;
 101:fb/fb_k2xx.c  **** 	uint16_t reg;
 102:fb/fb_k2xx.c  **** 
 103:fb/fb_k2xx.c  **** 	printf("%s: initializing LCD.\n", __FUNCTION__);
 104:fb/fb_k2xx.c  **** 
 105:fb/fb_k2xx.c  **** 	reg = readw(ARMIO_LATCH_OUT);
 106:fb/fb_k2xx.c  **** 	reg &= ~(CL761_RESET | (1 << 1));
 107:fb/fb_k2xx.c  **** 	reg |= CL761_CLK;
 108:fb/fb_k2xx.c  **** 	writew(reg, ARMIO_LATCH_OUT);
 109:fb/fb_k2xx.c  **** 	delay_ms(10);
 110:fb/fb_k2xx.c  **** 	reg |= CL761_RESET;
 111:fb/fb_k2xx.c  **** 	writew(reg, ARMIO_LATCH_OUT);
 112:fb/fb_k2xx.c  **** 
 113:fb/fb_k2xx.c  **** 	/* we need to perform a dummy register read for the
 114:fb/fb_k2xx.c  **** 	 * CL761 to pass through the chip select to the display */
 115:fb/fb_k2xx.c  **** 	cl761_read_reg(0x2e);
 116:fb/fb_k2xx.c  **** 	delay_ms(1);
 117:fb/fb_k2xx.c  **** 
 118:fb/fb_k2xx.c  **** 	reg &= ~CL761_CLK;
 119:fb/fb_k2xx.c  **** 	reg |= (1 << 1) | K2XX_ENABLE_BACKLIGHT;
 120:fb/fb_k2xx.c  **** 	writew(reg, ARMIO_LATCH_OUT);
 121:fb/fb_k2xx.c  **** 
 122:fb/fb_k2xx.c  **** 	for (i = 0; i < sizeof(k2xx_initdata); i++)
 123:fb/fb_k2xx.c  **** 		writew(k2xx_initdata[i], DISPLAY_CMD_ADDR);
 124:fb/fb_k2xx.c  **** }
