 165:fb/fb_bw8.c   **** /* Copy Paste from
 166:fb/fb_bw8.c   ****  * http://de.wikipedia.org/wiki/Bresenham-Algorithmus#Kompakte_Variante */
 167:fb/fb_bw8.c   **** static void fb_bw8_line(int16_t x1,int16_t y1,int16_t x2,int16_t y2){
 168:fb/fb_bw8.c   **** 	fb_limit_fb_range(&x1, &y1);
 169:fb/fb_bw8.c   **** 	fb_limit_fb_range(&x2, &y2);
 170:fb/fb_bw8.c   **** 	fb_bw8_update_damage(x1,y1,x2,y2);
 171:fb/fb_bw8.c   **** 	/* printf("fb_bw8_line from (%u|%u) -> (%u|%u)\n", x1, y1, x2, y2); */
 172:fb/fb_bw8.c   **** 	int16_t dx =  abs(x2-x1), dy = -abs(y2-y1);
 173:fb/fb_bw8.c   **** 	int16_t sx = x1<x2 ? 1 : -1, sy = y1<y2 ? 1 : -1;
 174:fb/fb_bw8.c   **** 	int16_t err = dx+dy, e2; /* error value e_xy */
 175:fb/fb_bw8.c   **** 
 176:fb/fb_bw8.c   **** 	while (1) {
 177:fb/fb_bw8.c   **** 		fb_bw8_set_pixel(x1,y1);
 178:fb/fb_bw8.c   **** 		if (x1==x2 && y1==y2) break;
 179:fb/fb_bw8.c   **** 		e2 = 2*err;
 180:fb/fb_bw8.c   **** 		if (e2 > dy) { err += dy; x1 += sx; } /* e_xy+e_x > 0 */
 181:fb/fb_bw8.c   **** 		if (e2 < dx) { err += dx; y1 += sy; } /* e_xy+e_y < 0 */
 182:fb/fb_bw8.c   **** 	}
 183:fb/fb_bw8.c   **** }
