 109:fb/fb_bw8.c   **** static void fb_bw8_box(uint16_t x1,uint16_t y1,uint16_t x2,uint16_t y2)
 110:fb/fb_bw8.c   **** {
 111:fb/fb_bw8.c   **** 	uint16_t y,w;
 112:fb/fb_bw8.c   **** 	uint8_t *p;
 113:fb/fb_bw8.c   **** 
 114:fb/fb_bw8.c   **** 	uint8_t and_mask,or_mask;	// filling
 115:fb/fb_bw8.c   **** 	uint8_t and_mask_side,or_mask_side; // left and right side
 116:fb/fb_bw8.c   **** 
 117:fb/fb_bw8.c   **** 	fb_sanitize_box(&x1,&y1,&x2,&y2);
 118:fb/fb_bw8.c   **** 	fb_bw8_update_damage(x1,y1,x2,y2);
 119:fb/fb_bw8.c   **** 
 120:fb/fb_bw8.c   **** 	for(y=y1&0xfff8;y<=y2;y+=8){
 121:fb/fb_bw8.c   **** 		/* don't clear any pixels (white) */
 122:fb/fb_bw8.c   **** 		and_mask = and_mask_side = 0xff;
 123:fb/fb_bw8.c   **** 		or_mask = or_mask_side = 0;
 124:fb/fb_bw8.c   **** 
 125:fb/fb_bw8.c   **** 		for(w=0;w<8;w++){ /* check which pixels are affected */
 126:fb/fb_bw8.c   **** 			if(y+w >= y1 && y+w <= y2){
 127:fb/fb_bw8.c   **** 				set_bg_pixel(&and_mask,&or_mask,w);
 128:fb/fb_bw8.c   **** 				set_fg_pixel(&and_mask_side,&or_mask_side,w);
 129:fb/fb_bw8.c   **** 			}
 130:fb/fb_bw8.c   **** 
 131:fb/fb_bw8.c   **** 			if(y+w == y1 || y+w == y2){ /* top and bottom line */
 132:fb/fb_bw8.c   **** 				set_fg_pixel(&and_mask,&or_mask,w);
 133:fb/fb_bw8.c   **** 			}
 134:fb/fb_bw8.c   **** 		}
 135:fb/fb_bw8.c   **** 
 136:fb/fb_bw8.c   **** 		p = fb_bw8->mem + (y/8)*framebuffer->width + x1;
 137:fb/fb_bw8.c   **** 		for(w=x1;w<=x2;w++){
 138:fb/fb_bw8.c   **** 			if(w == x1 || w == x2)
 139:fb/fb_bw8.c   **** 				*p = (*p & and_mask_side)|or_mask_side;
 140:fb/fb_bw8.c   **** 			else
 141:fb/fb_bw8.c   **** 				*p = (*p & and_mask)|or_mask;
 142:fb/fb_bw8.c   **** 			p++;
 143:fb/fb_bw8.c   **** 		}
 144:fb/fb_bw8.c   **** 	}
 145:fb/fb_bw8.c   **** }
