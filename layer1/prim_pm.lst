  48:layer1/prim_pm.c **** 
  49:layer1/prim_pm.c **** static void l1ddsp_meas_read(uint8_t nbmeas, uint16_t *pm)
  50:layer1/prim_pm.c **** {
  51:layer1/prim_pm.c **** 	uint8_t i;
  52:layer1/prim_pm.c **** 
  53:layer1/prim_pm.c **** 	for (i = 0; i < nbmeas; i++)
  54:layer1/prim_pm.c **** 		pm[i] = (uint16_t) ((dsp_api.db_r->a_pm[i] & 0xffff) >> 3);
  55:layer1/prim_pm.c **** 	dsp_api.r_page_used = 1;
  56:layer1/prim_pm.c **** }
  57:layer1/prim_pm.c **** 
  58:layer1/prim_pm.c **** /* scheduler callback to issue a power measurement task to the DSP */
  59:layer1/prim_pm.c **** static int l1s_pm_cmd(uint8_t num_meas,
  60:layer1/prim_pm.c **** 		      __unused uint8_t p2, uint16_t arfcn)
  61:layer1/prim_pm.c **** {
  62:layer1/prim_pm.c **** 	putchart('P');
  63:layer1/prim_pm.c **** 
  64:layer1/prim_pm.c **** 	dsp_api.db_w->d_task_md = num_meas; /* number of measurements */
  65:layer1/prim_pm.c **** 	dsp_api.ndb->d_fb_mode = 0; /* wideband search */
  66:layer1/prim_pm.c **** 
  67:layer1/prim_pm.c **** 	/* Tell the RF frontend to set the gain appropriately */
  68:layer1/prim_pm.c **** 	rffe_compute_gain(-85, CAL_DSP_TGT_BB_LVL);
  69:layer1/prim_pm.c **** 
  70:layer1/prim_pm.c **** 	/* Program TPU */
  71:layer1/prim_pm.c **** 	/* FIXME: RXWIN_PW needs to set up multiple times in case
  72:layer1/prim_pm.c **** 	 * num_meas > 1 */
  73:layer1/prim_pm.c **** 	l1s_rx_win_ctrl(arfcn, L1_RXWIN_PW, 0);
  74:layer1/prim_pm.c **** 	//l1s_rx_win_ctrl(arfcn, L1_RXWIN_NB);
  75:layer1/prim_pm.c **** 
  76:layer1/prim_pm.c **** 	return 0;
  77:layer1/prim_pm.c **** }
  78:layer1/prim_pm.c **** 
  79:layer1/prim_pm.c **** /* scheduler callback to read power measurement resposnse from the DSP */
  80:layer1/prim_pm.c **** static int l1s_pm_resp(uint8_t num_meas, __unused uint8_t p2,
  81:layer1/prim_pm.c **** 		       uint16_t arfcn)
  82:layer1/prim_pm.c **** {
  83:layer1/prim_pm.c **** 	struct l1ctl_pm_conf *pmr;
  84:layer1/prim_pm.c **** 	uint16_t pm_level[2];
  85:layer1/prim_pm.c **** 
  86:layer1/prim_pm.c **** 	putchart('p');
  87:layer1/prim_pm.c **** 
  88:layer1/prim_pm.c **** 	l1ddsp_meas_read(num_meas, pm_level);
  89:layer1/prim_pm.c **** 
  90:layer1/prim_pm.c **** 	printf("PM MEAS: ARFCN=%u, %-4d dBm at baseband, %-4d dBm at RF\n",
  91:layer1/prim_pm.c **** 		arfcn, pm_level[0]/8, agc_inp_dbm8_by_pm(pm_level[0])/8);
  92:layer1/prim_pm.c **** 
  93:layer1/prim_pm.c **** 	printd("PM MEAS: %-4d dBm, %-4d dBm ARFCN=%u\n",
  94:layer1/prim_pm.c **** 		agc_inp_dbm8_by_pm(pm_level[0])/8,
  95:layer1/prim_pm.c **** 		agc_inp_dbm8_by_pm(pm_level[1])/8, arfcn);
  96:layer1/prim_pm.c **** 
  97:layer1/prim_pm.c **** 	if (!l1s.pm.msg)
  98:layer1/prim_pm.c **** 		l1s.pm.msg = l1ctl_msgb_alloc(L1CTL_PM_CONF);
  99:layer1/prim_pm.c **** 
 100:layer1/prim_pm.c **** 	if (msgb_tailroom(l1s.pm.msg) < sizeof(*pmr)) {
 101:layer1/prim_pm.c **** 		/* flush current msgb */
 102:layer1/prim_pm.c **** 		l1_queue_for_l2(l1s.pm.msg);
 103:layer1/prim_pm.c **** 		/* allocate a new msgb and initialize header */
 104:layer1/prim_pm.c **** 		l1s.pm.msg = l1ctl_msgb_alloc(L1CTL_PM_CONF);
 105:layer1/prim_pm.c **** 	}
 106:layer1/prim_pm.c **** 
 107:layer1/prim_pm.c **** 	pmr = (struct l1ctl_pm_conf *) msgb_put(l1s.pm.msg, sizeof(*pmr));
 108:layer1/prim_pm.c **** 	pmr->band_arfcn = htons(arfcn);
 109:layer1/prim_pm.c **** 	/* FIXME: do this as RxLev rather than DBM8 ? */
 110:layer1/prim_pm.c **** 	pmr->pm[0] = dbm2rxlev(agc_inp_dbm8_by_pm(pm_level[0])/8);
 111:layer1/prim_pm.c **** 	if (num_meas > 1)
 112:layer1/prim_pm.c **** 		pmr->pm[1] = dbm2rxlev(agc_inp_dbm8_by_pm(pm_level[1])/8);
 113:layer1/prim_pm.c **** 	else
 114:layer1/prim_pm.c **** 		pmr->pm[1] = 0;
 115:layer1/prim_pm.c **** 
 116:layer1/prim_pm.c **** 	if (l1s.pm.mode == 1) {
 117:layer1/prim_pm.c **** 		if (l1s.pm.range.arfcn_next != l1s.pm.range.arfcn_end) {
 118:layer1/prim_pm.c **** 			/* schedule PM for next ARFCN in range */
 119:layer1/prim_pm.c **** 			l1s.pm.range.arfcn_next =
 120:layer1/prim_pm.c **** 				(l1s.pm.range.arfcn_next+1) & 0xfbff;
 121:layer1/prim_pm.c **** 			l1s_pm_test(1, l1s.pm.range.arfcn_next);
 122:layer1/prim_pm.c **** 		} else {
 123:layer1/prim_pm.c **** 			/* we have finished, flush the msgb to L2 */
 124:layer1/prim_pm.c **** 			struct l1ctl_hdr *l1h;
 125:layer1/prim_pm.c **** 			l1h = (struct l1ctl_hdr *) l1s.pm.msg->l1h;
 126:layer1/prim_pm.c **** 			l1h->flags |= L1CTL_F_DONE;
 127:layer1/prim_pm.c **** 			l1_queue_for_l2(l1s.pm.msg);
 128:layer1/prim_pm.c **** 			l1s.pm.msg = NULL;
 129:layer1/prim_pm.c **** 		}
 130:layer1/prim_pm.c **** 	}
 131:layer1/prim_pm.c **** 
 132:layer1/prim_pm.c **** 	return 0;
 133:layer1/prim_pm.c **** }
 134:layer1/prim_pm.c **** 
 135:layer1/prim_pm.c **** static const struct tdma_sched_item pm_sched_set[] = {
 136:layer1/prim_pm.c **** 	SCHED_ITEM_DT(l1s_pm_cmd, 0, 1, 0),	SCHED_END_FRAME(),
 137:layer1/prim_pm.c **** 						SCHED_END_FRAME(),
 138:layer1/prim_pm.c **** 	SCHED_ITEM(l1s_pm_resp, -4, 1, 0),	SCHED_END_FRAME(),
 139:layer1/prim_pm.c **** 	SCHED_END_SET()
 140:layer1/prim_pm.c **** };
 141:layer1/prim_pm.c **** 
 142:layer1/prim_pm.c **** /* Schedule a power measurement test */
 143:layer1/prim_pm.c **** void l1s_pm_test(uint8_t base_fn, uint16_t arfcn)
 144:layer1/prim_pm.c **** {
 145:layer1/prim_pm.c **** 	unsigned long flags;
 146:layer1/prim_pm.c **** 
 147:layer1/prim_pm.c **** 	printd("l1s_pm_test(%u, %u)\n", base_fn, arfcn);
 148:layer1/prim_pm.c **** 
 149:layer1/prim_pm.c **** 	local_firq_save(flags);
 150:layer1/prim_pm.c **** 	tdma_schedule_set(base_fn, pm_sched_set, arfcn);
 151:layer1/prim_pm.c **** 	local_irq_restore(flags);
 152:layer1/prim_pm.c **** }
 153:layer1/prim_pm.c **** 
 154:layer1/prim_pm.c **** /*
 155:layer1/prim_pm.c ****  * perform measurements of neighbour cells
 156:layer1/prim_pm.c ****  */
 157:layer1/prim_pm.c **** 
 158:layer1/prim_pm.c **** /* scheduler callback to issue a power measurement task to the DSP */
 159:layer1/prim_pm.c **** static int l1s_neigh_pm_cmd(uint8_t num_meas,
 160:layer1/prim_pm.c **** 		      __unused uint8_t p2, __unused uint16_t p3)
 161:layer1/prim_pm.c **** {
 162:layer1/prim_pm.c **** 	uint8_t last_gain = rffe_get_gain();
 163:layer1/prim_pm.c **** 
 164:layer1/prim_pm.c **** 	dsp_api.db_w->d_task_md = num_meas; /* number of measurements */
 165:layer1/prim_pm.c **** //	dsp_api.ndb->d_fb_mode = 0; /* wideband search */
 166:layer1/prim_pm.c **** 
 167:layer1/prim_pm.c **** 	/* Tell the RF frontend to set the gain appropriately (keep last) */
 168:layer1/prim_pm.c **** 	rffe_compute_gain(-85, CAL_DSP_TGT_BB_LVL);
 169:layer1/prim_pm.c **** 
 170:layer1/prim_pm.c **** 	/* Program TPU */
 171:layer1/prim_pm.c **** 	/* FIXME: RXWIN_PW needs to set up multiple times in case
 172:layer1/prim_pm.c **** 	 * num_meas > 1 */
 173:layer1/prim_pm.c **** 	/* do measurement dummy, in case l1s.neigh_pm.n == 0 */
 174:layer1/prim_pm.c **** 	l1s_rx_win_ctrl((l1s.neigh_pm.n) ?
 175:layer1/prim_pm.c **** 			l1s.neigh_pm.band_arfcn[l1s.neigh_pm.pos] : 0,
 176:layer1/prim_pm.c **** 		L1_RXWIN_PW, l1s.neigh_pm.tn[l1s.neigh_pm.pos]);
 177:layer1/prim_pm.c **** 
 178:layer1/prim_pm.c **** 	/* restore last gain */
 179:layer1/prim_pm.c **** 	rffe_set_gain(last_gain);
 180:layer1/prim_pm.c **** 
 181:layer1/prim_pm.c **** 	l1s.neigh_pm.running = 1;
 182:layer1/prim_pm.c **** 
 183:layer1/prim_pm.c **** 	return 0;
 184:layer1/prim_pm.c **** }
 185:layer1/prim_pm.c **** 
