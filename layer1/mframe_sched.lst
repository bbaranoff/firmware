  32:layer1/mframe_sched.c **** /* A multiframe operation which can be scheduled for a multiframe */
  33:layer1/mframe_sched.c **** struct mframe_sched_item {
  34:layer1/mframe_sched.c **** 	/* The TDMA scheduler item that shall be scheduled */
  35:layer1/mframe_sched.c **** 	const struct tdma_sched_item *sched_set;
  36:layer1/mframe_sched.c **** 	/* Which modulo shall be used on the frame number */
  37:layer1/mframe_sched.c **** 	uint16_t modulo;
  38:layer1/mframe_sched.c **** 	/* At which number inside the modulo shall we be scheduled */
  39:layer1/mframe_sched.c **** 	uint16_t frame_nr;
  40:layer1/mframe_sched.c **** 	/* bit-mask of flags */
  41:layer1/mframe_sched.c **** 	uint16_t flags;
  42:layer1/mframe_sched.c **** };
  43:layer1/mframe_sched.c **** 
  44:layer1/mframe_sched.c **** /* FIXME: properly clean this up */
  45:layer1/mframe_sched.c **** #define NB_QUAD_DL	nb_sched_set
  46:layer1/mframe_sched.c **** #define NB_QUAD_FH_DL	NB_QUAD_DL
  47:layer1/mframe_sched.c **** #define NB_QUAD_UL	nb_sched_set_ul
  48:layer1/mframe_sched.c **** #define NB_QUAD_FH_UL	NB_QUAD_UL
  49:layer1/mframe_sched.c **** #define NEIGH_PM	neigh_pm_sched_set
  50:layer1/mframe_sched.c **** 
