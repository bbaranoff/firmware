 401:layer1/mframe_sched.c **** /* encodes a channel number according to 08.58 Chapter 9.3.1 */
 402:layer1/mframe_sched.c **** uint8_t mframe_task2chan_nr(enum mframe_task mft, uint8_t ts)
 403:layer1/mframe_sched.c **** {
  18              		.loc 1 403 0
  19              		.cfi_startproc
  20              		@ args = 0, pretend = 0, frame = 0
  21              		@ frame_needed = 0, uses_anonymous_args = 0
  22              		@ link register save eliminated.
  23              	.LVL0:
  24              		.loc 1 403 0
  25 0000 170050E3 		cmp	r0, #23
  26 0004 18309F95 		ldrls	r3, .L4
  27 0008 FF1001E2 		and	r1, r1, #255
  28              	.LVL1:
  29 000c 0030D397 		ldrlsb	r3, [r3, r0]	@ zero_extendqisi2
  30 0010 0030A083 		movhi	r3, #0
  31              	.LVL2:
 404:layer1/mframe_sched.c **** 	uint8_t cbits;
 405:layer1/mframe_sched.c **** 
 406:layer1/mframe_sched.c **** 	switch (mft) {
 407:layer1/mframe_sched.c **** 	case MF_TASK_BCCH_NORM:
 408:layer1/mframe_sched.c **** 	case MF_TASK_BCCH_EXT:
 409:layer1/mframe_sched.c **** 		cbits = 0x10;
 410:layer1/mframe_sched.c **** 		break;
 411:layer1/mframe_sched.c **** 	case MF_TASK_CCCH:
 412:layer1/mframe_sched.c **** 	case MF_TASK_CCCH_COMB:
 413:layer1/mframe_sched.c **** 		cbits = 0x12;
 414:layer1/mframe_sched.c **** 		break;
 415:layer1/mframe_sched.c **** 	case MF_TASK_SDCCH4_0:
 416:layer1/mframe_sched.c **** 		cbits = 0x04 + 0;
 417:layer1/mframe_sched.c **** 		break;
 418:layer1/mframe_sched.c **** 	case MF_TASK_SDCCH4_1:
 419:layer1/mframe_sched.c **** 		cbits = 0x04 + 1;
 420:layer1/mframe_sched.c **** 		break;
 421:layer1/mframe_sched.c **** 	case MF_TASK_SDCCH4_2:
 422:layer1/mframe_sched.c **** 		cbits = 0x04 + 2;
 423:layer1/mframe_sched.c **** 		break;
 424:layer1/mframe_sched.c **** 	case MF_TASK_SDCCH4_3:
 425:layer1/mframe_sched.c **** 		cbits = 0x04 + 3;
 426:layer1/mframe_sched.c **** 		break;
 427:layer1/mframe_sched.c **** 	case MF_TASK_SDCCH8_0:
 428:layer1/mframe_sched.c **** 		cbits = 0x08 + 0;
 429:layer1/mframe_sched.c **** 		break;
 430:layer1/mframe_sched.c **** 	case MF_TASK_SDCCH8_1:
 431:layer1/mframe_sched.c **** 		cbits = 0x08 + 1;
 432:layer1/mframe_sched.c **** 		break;
 433:layer1/mframe_sched.c **** 	case MF_TASK_SDCCH8_2:
 434:layer1/mframe_sched.c **** 		cbits = 0x08 + 2;
 435:layer1/mframe_sched.c **** 		break;
 436:layer1/mframe_sched.c **** 	case MF_TASK_SDCCH8_3:
 437:layer1/mframe_sched.c **** 		cbits = 0x08 + 3;
 438:layer1/mframe_sched.c **** 		break;
 439:layer1/mframe_sched.c **** 	case MF_TASK_SDCCH8_4:
 440:layer1/mframe_sched.c **** 		cbits = 0x08 + 4;
 441:layer1/mframe_sched.c **** 		break;
 442:layer1/mframe_sched.c **** 	case MF_TASK_SDCCH8_5:
 443:layer1/mframe_sched.c **** 		cbits = 0x08 + 5;
 444:layer1/mframe_sched.c **** 		break;
 445:layer1/mframe_sched.c **** 	case MF_TASK_SDCCH8_6:
 446:layer1/mframe_sched.c **** 		cbits = 0x08 + 6;
 447:layer1/mframe_sched.c **** 		break;
 448:layer1/mframe_sched.c **** 	case MF_TASK_SDCCH8_7:
 449:layer1/mframe_sched.c **** 		cbits = 0x08 + 7;
 450:layer1/mframe_sched.c **** 		break;
 451:layer1/mframe_sched.c **** 	case MF_TASK_TCH_F_EVEN:
 452:layer1/mframe_sched.c **** 	case MF_TASK_TCH_F_ODD:
 453:layer1/mframe_sched.c **** 		cbits = 0x01;
 454:layer1/mframe_sched.c **** 		break;
 455:layer1/mframe_sched.c **** 	case MF_TASK_TCH_H_0:
 456:layer1/mframe_sched.c **** 		cbits = 0x02 + 0;
 457:layer1/mframe_sched.c **** 		break;
 458:layer1/mframe_sched.c **** 	case MF_TASK_TCH_H_1:
 459:layer1/mframe_sched.c **** 		cbits = 0x02 + 1;
 460:layer1/mframe_sched.c **** 		break;
 461:layer1/mframe_sched.c **** 
 462:layer1/mframe_sched.c **** 	/* Osmocom specific extensions */
 463:layer1/mframe_sched.c **** 	case MF_TASK_GPRS_PDTCH:
 464:layer1/mframe_sched.c **** 	case MF_TASK_GPRS_PTCCH:
 465:layer1/mframe_sched.c **** 		cbits = 0x18;
 466:layer1/mframe_sched.c **** 		break;
 467:layer1/mframe_sched.c **** 	case MF_TASK_SDCCH4_CBCH:
 468:layer1/mframe_sched.c **** 		cbits = 0x19;
 469:layer1/mframe_sched.c **** 		break;
 470:layer1/mframe_sched.c **** 	case MF_TASK_SDCCH8_CBCH:
 471:layer1/mframe_sched.c **** 		cbits = 0x1a;
 472:layer1/mframe_sched.c **** 		break;
 473:layer1/mframe_sched.c **** 
 474:layer1/mframe_sched.c **** 	case MF_TASK_UL_ALL_NB:
 475:layer1/mframe_sched.c **** 	default:
 476:layer1/mframe_sched.c **** 		printd("ERROR: cannot express mf_task=%d as "
 477:layer1/mframe_sched.c **** 			"channel number, using 0x00\n", mft);
 478:layer1/mframe_sched.c **** 		cbits = 0x00;
 479:layer1/mframe_sched.c **** 	}
 480:layer1/mframe_sched.c **** 
 481:layer1/mframe_sched.c **** 	return (cbits << 3) | (ts & 0x7);
