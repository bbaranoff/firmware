 483:layer1/mframe_sched.c **** 
 484:layer1/mframe_sched.c **** /* how many TDMA frame ticks should we schedule events ahead? */
 485:layer1/mframe_sched.c **** #define SCHEDULE_AHEAD	2
 486:layer1/mframe_sched.c **** 
 487:layer1/mframe_sched.c **** /* how long do we need to tell the DSP in advance what we want to do? */
 488:layer1/mframe_sched.c **** #define SCHEDULE_LATENCY	1
 489:layer1/mframe_sched.c **** 
 490:layer1/mframe_sched.c **** /* (test and) schedule one particular sched_item_set by means of the TDMA scheduler */
 491:layer1/mframe_sched.c **** static void mframe_schedule_set(enum mframe_task task_id)
 492:layer1/mframe_sched.c **** {
 493:layer1/mframe_sched.c **** 	const struct mframe_sched_item *set = sched_set_for_task[task_id];
 494:layer1/mframe_sched.c **** 	const struct mframe_sched_item *si;
 495:layer1/mframe_sched.c **** 
 496:layer1/mframe_sched.c **** 	for (si = set; si->sched_set != NULL; si++) {
 497:layer1/mframe_sched.c **** 		unsigned int trigger = si->frame_nr % si->modulo;
 498:layer1/mframe_sched.c **** 		unsigned int current = (l1s.current_time.fn + SCHEDULE_AHEAD) % si->modulo;
 499:layer1/mframe_sched.c **** 		if (current == trigger) {
 500:layer1/mframe_sched.c **** 			uint32_t fn;
 501:layer1/mframe_sched.c **** 			int rv;
 502:layer1/mframe_sched.c **** 
 503:layer1/mframe_sched.c **** 			/* Schedule the set */
 504:layer1/mframe_sched.c **** 			/* FIXME: what to do with SACCH Flag etc? */
 505:layer1/mframe_sched.c **** 			rv = tdma_schedule_set(SCHEDULE_AHEAD-SCHEDULE_LATENCY,
 506:layer1/mframe_sched.c **** 					  si->sched_set, task_id | (si->flags<<8));
 507:layer1/mframe_sched.c **** 
 508:layer1/mframe_sched.c **** 			/* Compute the next safe time to queue a DSP command */
 509:layer1/mframe_sched.c **** 			fn = l1s.current_time.fn;
