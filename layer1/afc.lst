  30:layer1/afc.c  **** 
  31:layer1/afc.c  **** /* Over how many TDMA frames do we want to average? (this may change in dedicated mode) */
  32:layer1/afc.c  **** #define AFC_PERIOD		40
  33:layer1/afc.c  **** /* How many of our measurements have to be valid? */
  34:layer1/afc.c  **** #define AFC_MIN_MUN_VALID	8
  35:layer1/afc.c  **** 
  36:layer1/afc.c  **** /* The actual AFC code */
  37:layer1/afc.c  **** 
  38:layer1/afc.c  **** struct afc_state {
  39:layer1/afc.c  **** 	struct running_avg ravg;		/* running average */
  40:layer1/afc.c  **** 	int16_t		dac_value;		/* current DAC output value */
  41:layer1/afc.c  **** 	uint16_t	arfcn;
  42:layer1/afc.c  **** };
  43:layer1/afc.c  **** 
  44:layer1/afc.c  **** static void afc_ravg_output(struct running_avg *ravg, int32_t avg);
  45:layer1/afc.c  **** 
  46:layer1/afc.c  **** static struct afc_state afc_state = {
  47:layer1/afc.c  **** 	.ravg = {
  48:layer1/afc.c  **** 		.outfn = &afc_ravg_output,
  49:layer1/afc.c  **** 		.period = AFC_PERIOD,
  50:layer1/afc.c  **** 		.min_valid = AFC_MIN_MUN_VALID,
  51:layer1/afc.c  **** 	},
  52:layer1/afc.c  **** };
  53:layer1/afc.c  **** 
  54:layer1/afc.c  **** /* The AFC DAC in the ABB has to be configured as follows:
  55:layer1/afc.c  ****  * DAC = 1MHz / 947MHz * FreqErr(Hz) / AFCslop(ppm/LSB)
  56:layer1/afc.c  ****  * where:
  57:layer1/afc.c  ****  *	947 MHz is the center of EGSM
  58:layer1/afc.c  ****  *	AFCslope is coded F1.15, thus a normalization factor of 2^15 applies
  59:layer1/afc.c  ****  */
  60:layer1/afc.c  **** 
  61:layer1/afc.c  **** #define AFC_NORM_FACTOR_GSM	((1<<15) / 947)
  62:layer1/afc.c  **** #define AFC_NORM_FACTOR_DCS	((1<<15) / 1894)
  63:layer1/afc.c  **** 
  64:layer1/afc.c  **** /* The DSP can measure the frequency error in the following ranges:
  65:layer1/afc.c  ****  * 	FB_MODE0:	+/- 20 kHz
  66:layer1/afc.c  ****  *	FB_MODE1:	+/-  4 kHz
  67:layer1/afc.c  ****  *	Sync Burst:	+/-  1 kHz
  68:layer1/afc.c  ****  *	Normal Burst:	+/- 400 Hz
  69:layer1/afc.c  ****  */
  70:layer1/afc.c  **** 
