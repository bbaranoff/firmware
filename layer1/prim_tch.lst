 602:layer1/prim_tch.c **** 
 603:layer1/prim_tch.c **** /*
 604:layer1/prim_tch.c ****  * SACCH data are spread over 4 bursts, however they are so far apart that
 605:layer1/prim_tch.c ****  * we can't use the normal scheduler to schedule all them at once in a single
 606:layer1/prim_tch.c ****  * set.
 607:layer1/prim_tch.c ****  * Therefore, the task code itself decides in which burst it is, if it's the
 608:layer1/prim_tch.c ****  * start/end, and act appropriately.
 609:layer1/prim_tch.c ****  */
 610:layer1/prim_tch.c **** 
 611:layer1/prim_tch.c **** 
