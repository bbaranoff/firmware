 579:layer1/prim_tch.c **** 	dsp_load_tch_param(
 580:layer1/prim_tch.c **** 		&l1s.next_time,
 581:layer1/prim_tch.c **** 		tch_mode, tch_f_hn ? TCH_F : TCH_H, tch_sub,
 582:layer1/prim_tch.c **** 		l1s.tch_loop_mode, 0, tn
 583:layer1/prim_tch.c **** 	);
 584:layer1/prim_tch.c **** 
 585:layer1/prim_tch.c **** 	dsp_load_rx_task(TCHD_DSP_TASK, 0, tsc); /* burst_id unused for TCH */
 586:layer1/prim_tch.c **** 	dsp_load_tx_task(TCHD_DSP_TASK, 0, tsc); /* burst_id unused for TCH */
 587:layer1/prim_tch.c **** 
 588:layer1/prim_tch.c **** 	return 0;
 589:layer1/prim_tch.c **** }
