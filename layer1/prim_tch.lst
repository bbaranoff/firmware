 570:layer1/prim_tch.c **** 	uint8_t tch_f_hn, tch_sub, tch_mode;
 571:layer1/prim_tch.c **** 	uint32_t fn_report;
 572:layer1/prim_tch.c **** 
 573:layer1/prim_tch.c **** 	/* Get/compute various parameters */
 574:layer1/prim_tch.c **** 	rfch_get_params(&l1s.next_time, NULL, &tsc, &tn);
 575:layer1/prim_tch.c **** 	chan_nr = mframe_task2chan_nr(mf_task_id, tn);
 576:layer1/prim_tch.c **** 	tch_get_params(&l1s.next_time, chan_nr, &fn_report, &tch_f_hn, &tch_sub, &tch_mode);
 577:layer1/prim_tch.c **** 
