  19:layer1/prim_tch.c **** 
  20:layer1/prim_tch.c **** #include <stdint.h>
  21:layer1/prim_tch.c **** #include <stdio.h>
  22:layer1/prim_tch.c **** #include <string.h>
  23:layer1/prim_tch.c **** #include <stdlib.h>
  24:layer1/prim_tch.c **** 
