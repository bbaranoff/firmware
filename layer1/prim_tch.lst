  26:layer1/prim_tch.c **** #include <debug.h>
  27:layer1/prim_tch.c **** #include <memory.h>
  28:layer1/prim_tch.c **** #include <byteorder.h>
  29:layer1/prim_tch.c **** #include <osmocom/gsm/gsm_utils.h>
  30:layer1/prim_tch.c **** #include <osmocom/gsm/protocol/gsm_04_08.h>
  31:layer1/prim_tch.c **** #include <osmocom/core/msgb.h>
  32:layer1/prim_tch.c **** #include <calypso/dsp_api.h>
  33:layer1/prim_tch.c **** #include <calypso/irq.h>
  34:layer1/prim_tch.c **** #include <calypso/tpu.h>
  35:layer1/prim_tch.c **** #include <calypso/tsp.h>
  36:layer1/prim_tch.c **** #include <calypso/dsp.h>
  37:layer1/prim_tch.c **** #include <calypso/timer.h>
  38:layer1/prim_tch.c **** #include <comm/sercomm.h>
  39:layer1/prim_tch.c **** 
  40:layer1/prim_tch.c **** #include <rffe.h>
  41:layer1/prim_tch.c **** #include <layer1/sync.h>
  42:layer1/prim_tch.c **** #include <layer1/afc.h>
  43:layer1/prim_tch.c **** #include <layer1/agc.h>
  44:layer1/prim_tch.c **** #include <layer1/toa.h>
  45:layer1/prim_tch.c **** #include <layer1/tdma_sched.h>
  46:layer1/prim_tch.c **** #include <layer1/mframe_sched.h>
  47:layer1/prim_tch.c **** #include <layer1/tpu_window.h>
  48:layer1/prim_tch.c **** #include <layer1/l23_api.h>
  49:layer1/prim_tch.c **** #include <layer1/rfch.h>
  50:layer1/prim_tch.c **** #include <layer1/prim.h>
  51:layer1/prim_tch.c **** 
  52:layer1/prim_tch.c **** #include <l1ctl_proto.h>
  53:layer1/prim_tch.c **** 
  54:layer1/prim_tch.c **** /* This computes various parameters both for the DSP and for
  55:layer1/prim_tch.c ****  * our logic. Not all are used all the time, but it's easier
  56:layer1/prim_tch.c ****  * to build all in one place */
  57:layer1/prim_tch.c **** static void tch_get_params(struct gsm_time *time, uint8_t chan_nr,
  58:layer1/prim_tch.c ****                            uint32_t *fn_report, uint8_t *tch_f_hn,
  59:layer1/prim_tch.c ****                            uint8_t *tch_sub, uint8_t *tch_mode)
  60:layer1/prim_tch.c **** {
  61:layer1/prim_tch.c **** 	uint8_t tn = chan_nr & 0x07;
  62:layer1/prim_tch.c **** 	uint8_t cbits = chan_nr >> 3;
  63:layer1/prim_tch.c **** 
  64:layer1/prim_tch.c **** 	*tch_f_hn = (cbits & 2) ? 0 : 1;
  65:layer1/prim_tch.c **** 
  66:layer1/prim_tch.c **** 	if (*tch_f_hn) {
  67:layer1/prim_tch.c **** 		*fn_report = (time->fn - (tn * 13) + 104) % 104;
  68:layer1/prim_tch.c **** 		*tch_sub = 0;
  69:layer1/prim_tch.c **** 	} else {
  70:layer1/prim_tch.c **** 		uint8_t chan_sub = cbits & 1;
  71:layer1/prim_tch.c **** 		uint8_t tn_report = (tn & ~1) | chan_sub;
  72:layer1/prim_tch.c **** 		*fn_report = (time->fn - (tn_report * 13) + 104) % 104;
  73:layer1/prim_tch.c **** 		*tch_sub = chan_sub;
  74:layer1/prim_tch.c **** 	}
  75:layer1/prim_tch.c **** 
  76:layer1/prim_tch.c **** 	if (tch_mode) {
  77:layer1/prim_tch.c **** 		switch (l1s.tch_mode) {
  78:layer1/prim_tch.c **** 		case GSM48_CMODE_SPEECH_V1:
  79:layer1/prim_tch.c **** 			*tch_mode = *tch_f_hn ? TCH_FS_MODE : TCH_HS_MODE;
  80:layer1/prim_tch.c **** 			break;
  81:layer1/prim_tch.c **** 		case GSM48_CMODE_SPEECH_EFR:
  82:layer1/prim_tch.c **** 			*tch_mode = *tch_f_hn ? TCH_EFR_MODE : SIG_ONLY_MODE;
  83:layer1/prim_tch.c **** 			break;
  84:layer1/prim_tch.c **** 		case GSM48_CMODE_DATA_14k5:
  85:layer1/prim_tch.c **** 			*tch_mode = *tch_f_hn ? TCH_144_MODE : SIG_ONLY_MODE;
  86:layer1/prim_tch.c **** 			break;
  87:layer1/prim_tch.c **** 		case GSM48_CMODE_DATA_12k0:
  88:layer1/prim_tch.c **** 			*tch_mode = *tch_f_hn ? TCH_96_MODE : SIG_ONLY_MODE;
  89:layer1/prim_tch.c **** 			break;
  90:layer1/prim_tch.c **** 		case GSM48_CMODE_DATA_6k0:
  91:layer1/prim_tch.c **** 			*tch_mode = *tch_f_hn ? TCH_48F_MODE : TCH_48H_MODE;
  92:layer1/prim_tch.c **** 			break;
  93:layer1/prim_tch.c **** 		case GSM48_CMODE_DATA_3k6:
  94:layer1/prim_tch.c **** 			*tch_mode = *tch_f_hn ? TCH_24F_MODE : TCH_24H_MODE;
  95:layer1/prim_tch.c **** 			break;
  96:layer1/prim_tch.c **** 		default:
  97:layer1/prim_tch.c **** 			*tch_mode = SIG_ONLY_MODE;
  98:layer1/prim_tch.c **** 		}
  99:layer1/prim_tch.c **** 	}
 100:layer1/prim_tch.c **** 
 101:layer1/prim_tch.c **** 	/* enable/disable the voice decoder (Downlink) */
 102:layer1/prim_tch.c **** 	if (l1s.audio_mode & AUDIO_RX_SPEAKER)
 103:layer1/prim_tch.c **** 		dsp_api.ndb->d_tch_mode &= ~B_MUTE_VOCODEC_DL; /* unmute */
 104:layer1/prim_tch.c **** 	else
 105:layer1/prim_tch.c **** 		dsp_api.ndb->d_tch_mode |= B_MUTE_VOCODEC_DL; /* mute */
 106:layer1/prim_tch.c **** 
 107:layer1/prim_tch.c **** 	/* enable/disable the voice encoder (Uplink) */
 108:layer1/prim_tch.c **** 	if (l1s.audio_mode & AUDIO_TX_MICROPHONE)
 109:layer1/prim_tch.c **** 		dsp_api.ndb->d_tch_mode &= ~B_MUTE_VOCODEC_UL; /* unmute */
 110:layer1/prim_tch.c **** 	else
 111:layer1/prim_tch.c **** 		dsp_api.ndb->d_tch_mode |= B_MUTE_VOCODEC_UL; /* mute */
 112:layer1/prim_tch.c **** }
 113:layer1/prim_tch.c **** 
 114:layer1/prim_tch.c **** 
 115:layer1/prim_tch.c **** /* -------------------------------------------------------------------------
 116:layer1/prim_tch.c ****  * Shared completion handler
 117:layer1/prim_tch.c ****  * ------------------------------------------------------------------------- */
 118:layer1/prim_tch.c **** 
 119:layer1/prim_tch.c **** /*
 120:layer1/prim_tch.c ****  * FIXME We really need a better way to handle completion, where we can
 121:layer1/prim_tch.c ****  *       pass arguments and such ...
 122:layer1/prim_tch.c ****  *
 123:layer1/prim_tch.c ****  *       Right now, we just 'hope' it gets processed before the next one ...
 124:layer1/prim_tch.c ****  */
 125:layer1/prim_tch.c **** 
 126:layer1/prim_tch.c **** #define TX_TYPE_SACCH	(1<<0)
 127:layer1/prim_tch.c **** #define TX_TYPE_FACCH	(1<<1)
 128:layer1/prim_tch.c **** #define TX_TYPE_TRAFFIC	(1<<2)
 129:layer1/prim_tch.c **** 
 130:layer1/prim_tch.c **** static uint16_t last_tx_tch_fn;
 131:layer1/prim_tch.c **** static uint16_t last_tx_tch_type;
 132:layer1/prim_tch.c **** 
 133:layer1/prim_tch.c **** static void l1a_tx_tch_compl(__unused enum l1_compl c)
 134:layer1/prim_tch.c **** {
 135:layer1/prim_tch.c **** 	struct msgb *msg;
 136:layer1/prim_tch.c **** 
 137:layer1/prim_tch.c **** 	if (last_tx_tch_type & (TX_TYPE_SACCH | TX_TYPE_FACCH)) {
 138:layer1/prim_tch.c **** 		msg = l1_create_l2_msg(L1CTL_DATA_CONF, last_tx_tch_fn, 0, 0);
 139:layer1/prim_tch.c **** 		l1_queue_for_l2(msg);
 140:layer1/prim_tch.c **** 	}
 141:layer1/prim_tch.c **** 
 142:layer1/prim_tch.c **** 	if (last_tx_tch_type & TX_TYPE_TRAFFIC) {
 143:layer1/prim_tch.c **** 		msg = l1_create_l2_msg(L1CTL_TRAFFIC_CONF, last_tx_tch_fn, 0, 0);
 144:layer1/prim_tch.c **** 		l1_queue_for_l2(msg);
 145:layer1/prim_tch.c **** 	}
 146:layer1/prim_tch.c **** 
 147:layer1/prim_tch.c **** 	last_tx_tch_type = 0;
 148:layer1/prim_tch.c **** }
 149:layer1/prim_tch.c **** 
 150:layer1/prim_tch.c **** static __attribute__ ((constructor)) void prim_tch_init(void)
 151:layer1/prim_tch.c **** {
 152:layer1/prim_tch.c **** 	l1s.completion[L1_COMPL_TX_TCH]  = &l1a_tx_tch_compl;
 153:layer1/prim_tch.c **** }
 154:layer1/prim_tch.c **** 
 155:layer1/prim_tch.c **** 
 156:layer1/prim_tch.c **** /* -------------------------------------------------------------------------
 157:layer1/prim_tch.c ****  * TCH: Voice & FACCH
 158:layer1/prim_tch.c ****  * ------------------------------------------------------------------------- */
 159:layer1/prim_tch.c **** 
 160:layer1/prim_tch.c **** /*
 161:layer1/prim_tch.c ****  * Voice and FACCH data are spread in various ways depending on a lot of
 162:layer1/prim_tch.c ****  * factors. Trying to handle that with the mframe scheduler is just a mess,
 163:layer1/prim_tch.c ****  * so we schedule it burst by burst and handle the complex logic inside the
 164:layer1/prim_tch.c ****  * primitive task code itself.
 165:layer1/prim_tch.c ****  */
 166:layer1/prim_tch.c **** 
 167:layer1/prim_tch.c **** 
 168:layer1/prim_tch.c **** #define FACCH_MEAS_HIST	8	/* Up to 8 bursts history */
 169:layer1/prim_tch.c **** struct l1s_rx_tch_state {
 170:layer1/prim_tch.c **** 	struct l1s_meas_hdr meas[FACCH_MEAS_HIST];
 171:layer1/prim_tch.c **** 	uint8_t meas_id;
 172:layer1/prim_tch.c **** };
 173:layer1/prim_tch.c **** 
 174:layer1/prim_tch.c **** static struct l1s_rx_tch_state rx_tch;
 175:layer1/prim_tch.c **** 
 176:layer1/prim_tch.c **** 
 177:layer1/prim_tch.c **** static inline void l1s_tch_meas_avg(struct l1ctl_info_dl *dl,
 178:layer1/prim_tch.c **** 				    unsigned int meas_num)
 179:layer1/prim_tch.c **** {
 180:layer1/prim_tch.c **** 	uint32_t avg_snr = 0;
 181:layer1/prim_tch.c **** 	int32_t avg_dbm8 = 0;
 182:layer1/prim_tch.c **** 	unsigned int i;
 183:layer1/prim_tch.c **** 
 184:layer1/prim_tch.c **** 	for (i = 0; i < meas_num; i++) {
 185:layer1/prim_tch.c **** 		int j = (rx_tch.meas_id + FACCH_MEAS_HIST - i) % FACCH_MEAS_HIST;
 186:layer1/prim_tch.c **** 		avg_snr += rx_tch.meas[j].snr;
 187:layer1/prim_tch.c **** 		avg_dbm8 += rx_tch.meas[j].pm_dbm8;
 188:layer1/prim_tch.c **** 	}
 189:layer1/prim_tch.c **** 
 190:layer1/prim_tch.c **** 	dl->snr = avg_snr / meas_num;
 191:layer1/prim_tch.c **** 	dl->rx_level = dbm2rxlev(avg_dbm8 / (8 * meas_num));
 192:layer1/prim_tch.c **** }
 193:layer1/prim_tch.c **** 
 194:layer1/prim_tch.c **** static int l1s_tch_resp(__unused uint8_t p1, __unused uint8_t p2, uint16_t p3)
 195:layer1/prim_tch.c **** {
 196:layer1/prim_tch.c **** 	uint8_t mf_task_id = p3 & 0xff;
 197:layer1/prim_tch.c **** 	struct gsm_time rx_time;
 198:layer1/prim_tch.c **** 	uint8_t chan_nr;
 199:layer1/prim_tch.c **** 	uint16_t arfcn;
 200:layer1/prim_tch.c **** 	uint8_t tsc, tn;
 201:layer1/prim_tch.c **** 	uint8_t tch_f_hn, tch_sub;
 202:layer1/prim_tch.c **** 	uint32_t fn_report;
 203:layer1/prim_tch.c **** 	int facch_rx_now, traffic_rx_now;
 204:layer1/prim_tch.c **** 
 205:layer1/prim_tch.c **** 	/* Get/compute various parameters */
 206:layer1/prim_tch.c **** 	gsm_fn2gsmtime(&rx_time, (l1s.current_time.fn - 1 + GSM_MAX_FN) % GSM_MAX_FN);
 207:layer1/prim_tch.c **** 	rfch_get_params(&rx_time, &arfcn, &tsc, &tn);
 208:layer1/prim_tch.c **** 	chan_nr = mframe_task2chan_nr(mf_task_id, tn);
 209:layer1/prim_tch.c **** 	tch_get_params(&rx_time, chan_nr, &fn_report, &tch_f_hn, &tch_sub, NULL);
 210:layer1/prim_tch.c **** 
 211:layer1/prim_tch.c **** 	rx_tch.meas_id = (rx_tch.meas_id + 1) % FACCH_MEAS_HIST; /* absolute value doesn't matter */
 212:layer1/prim_tch.c **** 
 213:layer1/prim_tch.c **** 	/* Collect measurements */
 214:layer1/prim_tch.c **** 	rx_tch.meas[rx_tch.meas_id].toa_qbit = dsp_api.db_r->a_serv_demod[D_TOA];
 215:layer1/prim_tch.c **** 	rx_tch.meas[rx_tch.meas_id].pm_dbm8 =
 216:layer1/prim_tch.c **** 		agc_inp_dbm8_by_pm(dsp_api.db_r->a_serv_demod[D_PM] >> 3);
 217:layer1/prim_tch.c **** 	rx_tch.meas[rx_tch.meas_id].freq_err =
 218:layer1/prim_tch.c **** 		ANGLE_TO_FREQ(dsp_api.db_r->a_serv_demod[D_ANGLE]);
 219:layer1/prim_tch.c **** 	rx_tch.meas[rx_tch.meas_id].snr = dsp_api.db_r->a_serv_demod[D_SNR];
 220:layer1/prim_tch.c **** 
 221:layer1/prim_tch.c **** 	/* feed computed frequency error into AFC loop */
 222:layer1/prim_tch.c **** 	if (rx_tch.meas[rx_tch.meas_id].snr > AFC_SNR_THRESHOLD)
 223:layer1/prim_tch.c **** 		afc_input(rx_tch.meas[rx_tch.meas_id].freq_err, arfcn, 1);
 224:layer1/prim_tch.c **** 	else
 225:layer1/prim_tch.c **** 		afc_input(rx_tch.meas[rx_tch.meas_id].freq_err, arfcn, 0);
 226:layer1/prim_tch.c **** 
 227:layer1/prim_tch.c **** 	/* feed computed TOA into TA loop */
 228:layer1/prim_tch.c **** 	toa_input(rx_tch.meas[rx_tch.meas_id].toa_qbit << 2, rx_tch.meas[rx_tch.meas_id].snr);
 229:layer1/prim_tch.c **** 
 230:layer1/prim_tch.c **** 	/* Tell the RF frontend to set the gain appropriately */
 231:layer1/prim_tch.c **** 	rffe_compute_gain(rx_tch.meas[rx_tch.meas_id].pm_dbm8 / 8,
 232:layer1/prim_tch.c **** 		CAL_DSP_TGT_BB_LVL);
 233:layer1/prim_tch.c **** 
 234:layer1/prim_tch.c **** 	/* FACCH Block end ? */
 235:layer1/prim_tch.c **** 	if (tch_f_hn) {
 236:layer1/prim_tch.c **** 		/* FACCH/F: B0(0...7),B1(4...11),B2(8...11,0...3) (mod 13) */
 237:layer1/prim_tch.c **** 		facch_rx_now = ((rx_time.fn % 13) % 4) == 3;
 238:layer1/prim_tch.c **** 	} else {
 239:layer1/prim_tch.c **** 		/* FACCH/H: See GSM 05.02 Clause 7 Table 1of9 */
 240:layer1/prim_tch.c **** 		uint8_t t2_norm = rx_time.t2 - tch_sub;
 241:layer1/prim_tch.c **** 		facch_rx_now = (t2_norm == 15) ||
 242:layer1/prim_tch.c **** 		               (t2_norm == 23) ||
 243:layer1/prim_tch.c **** 		               (t2_norm ==  6);
 244:layer1/prim_tch.c **** 	}
 245:layer1/prim_tch.c **** 
 246:layer1/prim_tch.c **** 	if (facch_rx_now && (dsp_api.ndb->a_fd[0] & (1<<B_BLUD))) {
 247:layer1/prim_tch.c **** 		struct msgb *msg;
 248:layer1/prim_tch.c **** 		struct l1ctl_info_dl *dl;
 249:layer1/prim_tch.c **** 		struct l1ctl_data_ind *di;
 250:layer1/prim_tch.c **** 		uint16_t num_biterr;
 251:layer1/prim_tch.c **** 
 252:layer1/prim_tch.c **** 		/* Allocate msgb */
 253:layer1/prim_tch.c **** 			/* FIXME: we actually want all allocation out of L1S! */
 254:layer1/prim_tch.c **** 		msg = l1ctl_msgb_alloc(L1CTL_DATA_IND);
 255:layer1/prim_tch.c **** 		if(!msg) {
 256:layer1/prim_tch.c **** 			printf("TCH FACCH: unable to allocate msgb\n");
 257:layer1/prim_tch.c **** 			goto skip_rx_facch;
 258:layer1/prim_tch.c **** 		}
 259:layer1/prim_tch.c **** 
 260:layer1/prim_tch.c **** 		dl = (struct l1ctl_info_dl *) msgb_put(msg, sizeof(*dl));
 261:layer1/prim_tch.c **** 		di = (struct l1ctl_data_ind *) msgb_put(msg, sizeof(*di));
 262:layer1/prim_tch.c **** 
 263:layer1/prim_tch.c **** 		/* Fill DL header (should be about the first burst ... here is the last) */
 264:layer1/prim_tch.c **** 		dl->chan_nr = chan_nr;
 265:layer1/prim_tch.c **** 		dl->link_id = 0x00;	/* FACCH */
 266:layer1/prim_tch.c **** 		dl->band_arfcn = htons(arfcn);
 267:layer1/prim_tch.c **** 		dl->frame_nr = htonl(rx_time.fn);
 268:layer1/prim_tch.c **** 
 269:layer1/prim_tch.c **** 		/* Average SNR & RX level */
 270:layer1/prim_tch.c **** 		l1s_tch_meas_avg(dl, tch_f_hn ? 8 : 6);
 271:layer1/prim_tch.c **** 
 272:layer1/prim_tch.c **** 		/* Errors & CRC status */
 273:layer1/prim_tch.c **** 		num_biterr = dsp_api.ndb->a_fd[2] & 0xffff;
 274:layer1/prim_tch.c **** 		if (num_biterr > 0xff)
 275:layer1/prim_tch.c **** 			dl->num_biterr = 0xff;
 276:layer1/prim_tch.c **** 		else
 277:layer1/prim_tch.c **** 			dl->num_biterr = num_biterr;
 278:layer1/prim_tch.c **** 
 279:layer1/prim_tch.c **** 		dl->fire_crc = ((dsp_api.ndb->a_fd[0] & 0xffff) & ((1 << B_FIRE1) | (1 << B_FIRE0))) >> B_FIRE0;
 280:layer1/prim_tch.c **** 
 281:layer1/prim_tch.c **** 		/* Update rx level for pm report */
 282:layer1/prim_tch.c **** 		pu_update_rx_level(dl->rx_level);
 283:layer1/prim_tch.c **** 
 284:layer1/prim_tch.c **** 		/* Copy actual data, skipping the information block [0,1,2] */
 285:layer1/prim_tch.c **** 		dsp_memcpy_from_api(di->data, &dsp_api.ndb->a_fd[3], 23, 0);
 286:layer1/prim_tch.c **** 
 287:layer1/prim_tch.c **** 		/* Give message to up layer */
 288:layer1/prim_tch.c **** 		l1_queue_for_l2(msg);
 289:layer1/prim_tch.c **** 
 290:layer1/prim_tch.c **** skip_rx_facch:
 291:layer1/prim_tch.c **** 		/* Reset A_FD header (needed by DSP) */
 292:layer1/prim_tch.c **** 		/* B_FIRE1 =1, B_FIRE0 =0 , BLUD =0 */
 293:layer1/prim_tch.c **** 		dsp_api.ndb->a_fd[0] = (1<<B_FIRE1);
 294:layer1/prim_tch.c **** 		dsp_api.ndb->a_fd[2] = 0xffff;
 295:layer1/prim_tch.c **** 
 296:layer1/prim_tch.c **** 		/* Reset A_DD_0 header in NDB (needed by DSP) */
 297:layer1/prim_tch.c **** 		dsp_api.ndb->a_dd_0[0] = 0;
 298:layer1/prim_tch.c **** 		dsp_api.ndb->a_dd_0[2] = 0xffff;
 299:layer1/prim_tch.c **** 
 300:layer1/prim_tch.c **** 		/* Reset A_DD_1 header in NDB (needed by DSP) */
 301:layer1/prim_tch.c **** 		dsp_api.ndb->a_dd_1[0] = 0;
 302:layer1/prim_tch.c **** 		dsp_api.ndb->a_dd_1[2] = 0xffff;
 303:layer1/prim_tch.c **** 	}
 304:layer1/prim_tch.c **** 
 305:layer1/prim_tch.c **** 	/* Traffic now ? */
 306:layer1/prim_tch.c **** 	if (tch_f_hn) {
 307:layer1/prim_tch.c **** 		/* TCH/F: B0(0...7),B1(4...11),B2(8...11,0...3) (mod 13)*/
 308:layer1/prim_tch.c **** 		traffic_rx_now = ((rx_time.fn % 13) % 4) == 3;
 309:layer1/prim_tch.c **** 	} else {
 310:layer1/prim_tch.c **** 		/* TCH/H0: B0(0,2,4,6),B1(4,6,8,10),B2(8,10,0,2) (mod 13) */
 311:layer1/prim_tch.c **** 		/*     H1: B0(1,3,5,7),B1(5,7,9,11),B2(9,11,1,3) (mod 13) */
 312:layer1/prim_tch.c **** 		traffic_rx_now = (((rx_time.fn - tch_sub + 13) % 13) % 4) == 2;
 313:layer1/prim_tch.c **** 	}
 314:layer1/prim_tch.c **** 
 315:layer1/prim_tch.c **** 	if (traffic_rx_now) {
 316:layer1/prim_tch.c **** 		volatile uint16_t *traffic_buf;
 317:layer1/prim_tch.c **** 		struct l1ctl_info_dl *dl;
 318:layer1/prim_tch.c **** 		struct l1ctl_traffic_ind *ti;
 319:layer1/prim_tch.c **** 		struct msgb *msg;
 320:layer1/prim_tch.c **** 		uint16_t num_biterr;
 321:layer1/prim_tch.c **** 
 322:layer1/prim_tch.c **** 		traffic_buf = tch_sub ? dsp_api.ndb->a_dd_1 : dsp_api.ndb->a_dd_0;
 323:layer1/prim_tch.c **** 
 324:layer1/prim_tch.c **** 		/* Send the data to upper layers (if interested and good frame) */
 325:layer1/prim_tch.c **** 		if (~l1s.audio_mode & AUDIO_RX_TRAFFIC_IND)
 326:layer1/prim_tch.c **** 			goto skip_rx_traffic;
 327:layer1/prim_tch.c **** 		if (~traffic_buf[0] & (1 << B_BLUD))
 328:layer1/prim_tch.c **** 			goto skip_rx_traffic;
 329:layer1/prim_tch.c **** 
 330:layer1/prim_tch.c **** 		/* Allocate msgb */
 331:layer1/prim_tch.c **** 		/* FIXME: we actually want all allocation out of L1S! */
 332:layer1/prim_tch.c **** 		msg = l1ctl_msgb_alloc(L1CTL_TRAFFIC_IND);
 333:layer1/prim_tch.c **** 		if (!msg) {
 334:layer1/prim_tch.c **** 			printf("TCH traffic: unable to allocate msgb\n");
 335:layer1/prim_tch.c **** 			goto skip_rx_traffic;
 336:layer1/prim_tch.c **** 		}
 337:layer1/prim_tch.c **** 
 338:layer1/prim_tch.c **** 		dl = (struct l1ctl_info_dl *) msgb_put(msg, sizeof(*dl));
 339:layer1/prim_tch.c **** 		ti = (struct l1ctl_traffic_ind *) msgb_put(msg, sizeof(*ti));
 340:layer1/prim_tch.c **** 
 341:layer1/prim_tch.c **** 		dl->chan_nr = chan_nr;
 342:layer1/prim_tch.c **** 		dl->band_arfcn = htons(arfcn);
 343:layer1/prim_tch.c **** 		dl->frame_nr = htonl(rx_time.fn);
 344:layer1/prim_tch.c **** 
 345:layer1/prim_tch.c **** 		/* Average SNR & RX level */
 346:layer1/prim_tch.c **** 		l1s_tch_meas_avg(dl, tch_f_hn ? 8 : 4);
 347:layer1/prim_tch.c **** 
 348:layer1/prim_tch.c **** 		/* Errors & CRC status */
 349:layer1/prim_tch.c **** 		num_biterr = traffic_buf[2] & 0xffff;
 350:layer1/prim_tch.c **** 		if (num_biterr > 0xff)
 351:layer1/prim_tch.c **** 			dl->num_biterr = 0xff;
 352:layer1/prim_tch.c **** 		else
 353:layer1/prim_tch.c **** 			dl->num_biterr = num_biterr;
 354:layer1/prim_tch.c **** 
 355:layer1/prim_tch.c **** 		dl->fire_crc = ((traffic_buf[0] & 0xffff) & ((1 << B_FIRE1) | (1 << B_FIRE0))) >> B_FIRE0;
 356:layer1/prim_tch.c **** 
 357:layer1/prim_tch.c **** 		/* Update rx level for pm report */
 358:layer1/prim_tch.c **** 		pu_update_rx_level(dl->rx_level);
 359:layer1/prim_tch.c **** 
 360:layer1/prim_tch.c **** 		/* Copy actual data, skipping the information block [0,1,2] */
 361:layer1/prim_tch.c **** 		dsp_memcpy_from_api(msgb_put(msg, 33), &traffic_buf[3], 33, 1);
 362:layer1/prim_tch.c **** 
 363:layer1/prim_tch.c **** 		/* Give message to up layer */
 364:layer1/prim_tch.c **** 		l1_queue_for_l2(msg);
 365:layer1/prim_tch.c **** 
 366:layer1/prim_tch.c **** skip_rx_traffic:
 367:layer1/prim_tch.c **** 		/* Reset A_DD_0 header in NDB (needed by DSP) */
 368:layer1/prim_tch.c **** 		dsp_api.ndb->a_dd_0[0] = 0;
 369:layer1/prim_tch.c **** 		dsp_api.ndb->a_dd_0[2] = 0xffff;
 370:layer1/prim_tch.c **** 
 371:layer1/prim_tch.c **** 		/* Reset A_DD_1 header in NDB (needed by DSP) */
 372:layer1/prim_tch.c **** 		dsp_api.ndb->a_dd_1[0] = 0;
 373:layer1/prim_tch.c **** 		dsp_api.ndb->a_dd_1[2] = 0xffff;
 374:layer1/prim_tch.c **** 	}
 375:layer1/prim_tch.c **** 
 376:layer1/prim_tch.c **** 	/* mark READ page as being used */
 377:layer1/prim_tch.c **** 	dsp_api.r_page_used = 1;
 378:layer1/prim_tch.c **** 
 379:layer1/prim_tch.c **** 	return 0;
 380:layer1/prim_tch.c **** }
 381:layer1/prim_tch.c **** 
 382:layer1/prim_tch.c **** static int l1s_tch_cmd(__unused uint8_t p1, __unused uint8_t p2, uint16_t p3)
 383:layer1/prim_tch.c **** {
 384:layer1/prim_tch.c **** 	uint8_t mf_task_id = p3 & 0xff;
 385:layer1/prim_tch.c **** 	uint8_t chan_nr;
 386:layer1/prim_tch.c **** 	uint16_t arfcn;
 387:layer1/prim_tch.c **** 	uint8_t tsc, tn;
 388:layer1/prim_tch.c **** 	uint8_t tch_f_hn, tch_sub, tch_mode;
 389:layer1/prim_tch.c **** 	uint32_t fn_report;
 390:layer1/prim_tch.c **** 	uint8_t sync = 0;
 391:layer1/prim_tch.c **** 	static int icnt;
 392:layer1/prim_tch.c **** 	int facch_tx_now, traffic_tx_now;
 393:layer1/prim_tch.c **** 
 394:layer1/prim_tch.c **** 	/* Get/compute various parameters */
 395:layer1/prim_tch.c **** 	rfch_get_params(&l1s.next_time, &arfcn, &tsc, &tn);
 396:layer1/prim_tch.c **** 	chan_nr = mframe_task2chan_nr(mf_task_id, tn);
 397:layer1/prim_tch.c **** 	tch_get_params(&l1s.next_time, chan_nr, &fn_report, &tch_f_hn, &tch_sub, &tch_mode);
 398:layer1/prim_tch.c **** 
 399:layer1/prim_tch.c **** 	/* Sync & FACCH delay */
 400:layer1/prim_tch.c **** 	if (l1s.tch_sync) {
 401:layer1/prim_tch.c **** 		l1s.tch_sync = 0;
 402:layer1/prim_tch.c **** 		sync = 1;
 403:layer1/prim_tch.c **** 		icnt = 0;
 404:layer1/prim_tch.c **** 	} else if (icnt <= 26)
 405:layer1/prim_tch.c **** 		icnt++;
 406:layer1/prim_tch.c **** 
 407:layer1/prim_tch.c **** 	/* Load FACCH data if we start a new burst */
 408:layer1/prim_tch.c **** 	/* (the DSP wants the data on the CMD of the burst _preceding_ the
 409:layer1/prim_tch.c **** 	 * first burst) */
 410:layer1/prim_tch.c **** 	if (tch_f_hn) {
 411:layer1/prim_tch.c **** 		/* FACCH/F: B0(0...7),B1(4...11),B2(8...11,0...3) */
 412:layer1/prim_tch.c **** 		facch_tx_now = ((l1s.next_time.fn % 13) % 4) == 3;
 413:layer1/prim_tch.c **** 	} else {
 414:layer1/prim_tch.c **** 		/* FACCH/H: See GSM 05.02 Clause 7 Table 1of9 */
 415:layer1/prim_tch.c **** 		uint8_t t2_norm = l1s.next_time.t2 - tch_sub;
 416:layer1/prim_tch.c **** 		facch_tx_now = (t2_norm == 23) ||
 417:layer1/prim_tch.c **** 		               (t2_norm ==  6) ||
 418:layer1/prim_tch.c **** 		               (t2_norm == 15);
 419:layer1/prim_tch.c **** 	}
 420:layer1/prim_tch.c **** 
 421:layer1/prim_tch.c **** 	if (facch_tx_now) {
 422:layer1/prim_tch.c **** 		uint16_t *info_ptr = dsp_api.ndb->a_fu;
 423:layer1/prim_tch.c **** 		struct msgb *msg;
 424:layer1/prim_tch.c **** 		const uint8_t *data;
 425:layer1/prim_tch.c **** 
 426:layer1/prim_tch.c **** 		/* Pull FACCH data (if ready) */
 427:layer1/prim_tch.c **** 		if (icnt > 26)
 428:layer1/prim_tch.c **** 			msg = msgb_dequeue(&l1s.tx_queue[L1S_CHAN_MAIN]);
 429:layer1/prim_tch.c **** 		else
 430:layer1/prim_tch.c **** 			msg = NULL;
 431:layer1/prim_tch.c **** 
 432:layer1/prim_tch.c **** 		/* If TX is empty and we're signalling only, use dummy frame */
 433:layer1/prim_tch.c **** 		if (msg)
 434:layer1/prim_tch.c **** 			data = msg->l3h;
 435:layer1/prim_tch.c **** 		else if (tch_mode == SIG_ONLY_MODE)
 436:layer1/prim_tch.c **** 			data = pu_get_idle_frame();
 437:layer1/prim_tch.c **** 		else
 438:layer1/prim_tch.c **** 			data = NULL;
 439:layer1/prim_tch.c **** 
 440:layer1/prim_tch.c **** 		/* Do we really send something ? */
 441:layer1/prim_tch.c **** 		if (data) {
 442:layer1/prim_tch.c **** 			/* Fill data block header */
 443:layer1/prim_tch.c **** 			info_ptr[0] = (1 << B_BLUD);	/* 1st word: Set B_BLU bit. */
 444:layer1/prim_tch.c **** 			info_ptr[1] = 0;		/* 2nd word: cleared. */
 445:layer1/prim_tch.c **** 			info_ptr[2] = 0;		/* 3nd word: cleared. */
 446:layer1/prim_tch.c **** 
 447:layer1/prim_tch.c **** 			/* Copy the actual data after the header */
 448:layer1/prim_tch.c **** 			dsp_memcpy_to_api(&info_ptr[3], data, 23, 0);
 449:layer1/prim_tch.c **** 		}
 450:layer1/prim_tch.c **** 
 451:layer1/prim_tch.c **** 		/* Indicate completion (FIXME: early but easier this way for now) */
 452:layer1/prim_tch.c **** 		if (msg) {
 453:layer1/prim_tch.c **** 			last_tx_tch_fn = l1s.next_time.fn;
 454:layer1/prim_tch.c **** 			last_tx_tch_type |= TX_TYPE_FACCH;
 455:layer1/prim_tch.c **** 			l1s_compl_sched(L1_COMPL_TX_TCH);
 456:layer1/prim_tch.c **** 		}
 457:layer1/prim_tch.c **** 
 458:layer1/prim_tch.c **** 		/* Free msg now that we're done with it */
 459:layer1/prim_tch.c **** 		if (msg)
 460:layer1/prim_tch.c **** 			msgb_free(msg);
 461:layer1/prim_tch.c **** 	}
 462:layer1/prim_tch.c **** 
 463:layer1/prim_tch.c **** 	/* Traffic now ? */
 464:layer1/prim_tch.c **** 	if (tch_f_hn) {
 465:layer1/prim_tch.c **** 		/* TCH/F: B0(0...7),B1(4...11),B2(8...11,0...3) (mod 13)*/
 466:layer1/prim_tch.c **** 		traffic_tx_now = ((l1s.next_time.fn % 13) % 4) == 3;
 467:layer1/prim_tch.c **** 	} else {
 468:layer1/prim_tch.c **** 		/* TCH/H0: B0(0,2,4,6),B1(4,6,8,10),B2(8,10,0,2) (mod 13) */
 469:layer1/prim_tch.c **** 		/*     H1: B0(1,3,5,7),B1(5,7,9,11),B2(9,11,1,3) (mod 13) */
 470:layer1/prim_tch.c **** 		traffic_tx_now = (((l1s.next_time.fn - tch_sub + 13) % 13) % 4) == 2;
 471:layer1/prim_tch.c **** 	}
 472:layer1/prim_tch.c **** 
 473:layer1/prim_tch.c **** 	if (traffic_tx_now) {
 474:layer1/prim_tch.c **** 		volatile uint16_t *traffic_buf;
 475:layer1/prim_tch.c **** 		struct msgb *msg;
 476:layer1/prim_tch.c **** 
 477:layer1/prim_tch.c **** 		/* Reset play mode */
 478:layer1/prim_tch.c **** 		dsp_api.ndb->d_tch_mode &= ~B_PLAY_UL;
 479:layer1/prim_tch.c **** 
 480:layer1/prim_tch.c **** 		/* Check l1s audio mode */
 481:layer1/prim_tch.c **** 		if (!(l1s.audio_mode & AUDIO_TX_TRAFFIC_REQ))
 482:layer1/prim_tch.c **** 			goto skip_tx_traffic;
 483:layer1/prim_tch.c **** 
 484:layer1/prim_tch.c **** 		/* Traffic buffer = !tch_sub */
 485:layer1/prim_tch.c **** 		traffic_buf = tch_sub ? dsp_api.ndb->a_du_0 : dsp_api.ndb->a_du_1;
 486:layer1/prim_tch.c **** 
 487:layer1/prim_tch.c **** 		/* Pull Traffic data (if any) */
 488:layer1/prim_tch.c **** 		msg = msgb_dequeue(&l1s.tx_queue[L1S_CHAN_TRAFFIC]);
 489:layer1/prim_tch.c **** 		if (msg == NULL)
 490:layer1/prim_tch.c **** 			goto skip_tx_traffic;
 491:layer1/prim_tch.c **** 
 492:layer1/prim_tch.c **** 		/* Copy actual data, skipping the information block [0,1,2] */
 493:layer1/prim_tch.c **** 		dsp_memcpy_to_api(&traffic_buf[3], msgb_l2(msg), 33, 1);
 494:layer1/prim_tch.c **** 
 495:layer1/prim_tch.c **** 		traffic_buf[0] = (1 << B_BLUD);	/* 1st word: Set B_BLU bit. */
 496:layer1/prim_tch.c **** 		traffic_buf[1] = 0;		/* 2nd word: cleared. */
 497:layer1/prim_tch.c **** 		traffic_buf[2] = 0;		/* 3nd word: cleared. */
 498:layer1/prim_tch.c **** 
 499:layer1/prim_tch.c **** 		dsp_api.ndb->d_tch_mode |= B_PLAY_UL;
 500:layer1/prim_tch.c **** 
 501:layer1/prim_tch.c **** 		/* Indicate completion (FIXME: early but easier this way for now) */
 502:layer1/prim_tch.c **** 		last_tx_tch_fn = l1s.next_time.fn;
 503:layer1/prim_tch.c **** 		last_tx_tch_type |= TX_TYPE_TRAFFIC;
 504:layer1/prim_tch.c **** 		l1s_compl_sched(L1_COMPL_TX_TCH);
 505:layer1/prim_tch.c **** 
 506:layer1/prim_tch.c **** 		/* Free msg now that we're done with it */
 507:layer1/prim_tch.c **** 		msgb_free(msg);
 508:layer1/prim_tch.c **** 	}
 509:layer1/prim_tch.c **** skip_tx_traffic:
 510:layer1/prim_tch.c **** 
 511:layer1/prim_tch.c **** 	/* Configure DSP for TX/RX */
 512:layer1/prim_tch.c **** 	l1s_tx_apc_helper(arfcn);
 513:layer1/prim_tch.c **** 
 514:layer1/prim_tch.c **** 	dsp_load_tch_param(
 515:layer1/prim_tch.c **** 		&l1s.next_time,
 516:layer1/prim_tch.c **** 		tch_mode, tch_f_hn ? TCH_F : TCH_H, tch_sub,
 517:layer1/prim_tch.c **** 		l1s.tch_loop_mode, sync, tn
 518:layer1/prim_tch.c **** 	);
 519:layer1/prim_tch.c **** 
 520:layer1/prim_tch.c **** 	dsp_load_rx_task(
 521:layer1/prim_tch.c **** 		dsp_task_iq_swap(TCHT_DSP_TASK, arfcn, 0),
 522:layer1/prim_tch.c **** 		0, tsc		/* burst_id unused for TCH */
 523:layer1/prim_tch.c **** 	);
 524:layer1/prim_tch.c **** 	l1s_rx_win_ctrl(arfcn, L1_RXWIN_NB, 0);
 525:layer1/prim_tch.c **** 
 526:layer1/prim_tch.c **** 	/* If transmission is off, use dummy task for DSP and do not open TX window. */
 527:layer1/prim_tch.c **** 	if ((l1s.tch_flags & L1CTL_TCH_FLAG_RXONLY)) {
 528:layer1/prim_tch.c **** 		dsp_load_tx_task(TCHD_DSP_TASK, 0, tsc); /* burst_id unused for TCH */
 529:layer1/prim_tch.c **** 		return 0;
 530:layer1/prim_tch.c **** 	}
 531:layer1/prim_tch.c **** 
 532:layer1/prim_tch.c **** 	dsp_load_tx_task(
 533:layer1/prim_tch.c **** 		dsp_task_iq_swap(TCHT_DSP_TASK, arfcn, 1),
 534:layer1/prim_tch.c **** 		0, tsc		/* burst_id unused for TCH */
 535:layer1/prim_tch.c **** 	);
 536:layer1/prim_tch.c **** 	l1s_tx_win_ctrl(arfcn | ARFCN_UPLINK, L1_TXWIN_NB, 0, 3);
 537:layer1/prim_tch.c **** 
 538:layer1/prim_tch.c **** 	return 0;
 539:layer1/prim_tch.c **** }
 540:layer1/prim_tch.c **** 
 541:layer1/prim_tch.c **** 
 542:layer1/prim_tch.c **** const struct tdma_sched_item tch_sched_set[] = {
 543:layer1/prim_tch.c **** 	SCHED_ITEM_DT(l1s_tch_cmd, 0, 0, 0),	SCHED_END_FRAME(),
 544:layer1/prim_tch.c **** 						SCHED_END_FRAME(),
 545:layer1/prim_tch.c **** 	SCHED_ITEM(l1s_tch_resp, 0, 0, -4),	SCHED_END_FRAME(),
 546:layer1/prim_tch.c **** 	SCHED_END_SET()
 547:layer1/prim_tch.c **** };
 548:layer1/prim_tch.c **** 
 549:layer1/prim_tch.c **** 
 550:layer1/prim_tch.c **** /* -------------------------------------------------------------------------
 551:layer1/prim_tch.c ****  * TCH/H: Dummy
 552:layer1/prim_tch.c ****  * ------------------------------------------------------------------------- */
 553:layer1/prim_tch.c **** 
