  59:layer1/sync.c **** struct l1s_state l1s;
  60:layer1/sync.c **** 
  61:layer1/sync.c **** void l1s_time_inc(struct gsm_time *time, uint32_t delta_fn)
  62:layer1/sync.c **** {
  63:layer1/sync.c **** 	ADD_MODULO(time->fn, delta_fn, GSM_MAX_FN);
  64:layer1/sync.c **** 
  65:layer1/sync.c **** 	if (delta_fn == 1) {
  66:layer1/sync.c **** 		ADD_MODULO(time->t2, 1, 26);
  67:layer1/sync.c **** 		ADD_MODULO(time->t3, 1, 51);
  68:layer1/sync.c **** 
  69:layer1/sync.c **** 		/* if the new frame number is a multiple of 51 */
  70:layer1/sync.c **** 		if (time->t3 == 0) {
  71:layer1/sync.c **** 			ADD_MODULO(time->tc, 1, 8);
  72:layer1/sync.c **** 
  73:layer1/sync.c **** 			/* if new FN is multiple of 51 and 26 */
  74:layer1/sync.c **** 			if (time->t2 == 0)
  75:layer1/sync.c **** 				ADD_MODULO(time->t1, 1, 2048);
  76:layer1/sync.c **** 		}
  77:layer1/sync.c **** 	} else
  78:layer1/sync.c **** 		gsm_fn2gsmtime(time, time->fn);
  79:layer1/sync.c **** }
  80:layer1/sync.c **** 
  81:layer1/sync.c **** void l1s_time_dump(const struct gsm_time *time)
  82:layer1/sync.c **** {
  83:layer1/sync.c **** 	printf("fn=%lu(%u/%2u/%2u)", time->fn, time->t1, time->t2, time->t3);
  84:layer1/sync.c **** }
  85:layer1/sync.c **** 
  86:layer1/sync.c **** /* clip a signed 16bit value at a certain limit */
  87:layer1/sync.c **** int16_t clip_int16(int16_t angle, int16_t clip_at)
  88:layer1/sync.c **** {
  89:layer1/sync.c **** 	if (angle > clip_at)
  90:layer1/sync.c **** 		angle = clip_at;
  91:layer1/sync.c **** 	else if (angle < -clip_at)
  92:layer1/sync.c **** 		angle = -clip_at;
  93:layer1/sync.c **** 
  94:layer1/sync.c **** 	return angle;
  95:layer1/sync.c **** }
  96:layer1/sync.c **** 
  97:layer1/sync.c **** int16_t l1s_snr_int(uint16_t snr)
  98:layer1/sync.c **** {
  99:layer1/sync.c **** 	return snr >> 10;
 100:layer1/sync.c **** }
 101:layer1/sync.c **** 
 102:layer1/sync.c **** uint16_t l1s_snr_fract(uint16_t snr)
 103:layer1/sync.c **** {
 104:layer1/sync.c **** 	uint32_t fract = snr & 0x3ff;
 105:layer1/sync.c **** 	fract = fract * 1000 / (2 << 10);
 106:layer1/sync.c **** 
 107:layer1/sync.c **** 	return fract & 0xffff;
 108:layer1/sync.c **** }
 109:layer1/sync.c **** 
 110:layer1/sync.c **** #define AFC_MAX_ANGLE		328	/* 0.01 radian in fx1.15 */
 111:layer1/sync.c **** 
 112:layer1/sync.c **** /* synchronize the L1S to a new timebase (typically a new cell */
 113:layer1/sync.c **** void synchronize_tdma(struct l1_cell_info *cinfo)
 114:layer1/sync.c **** {
 115:layer1/sync.c **** 	int32_t fn_offset;
 116:layer1/sync.c **** 	uint32_t tpu_shift = cinfo->time_alignment;
 117:layer1/sync.c **** 
 118:layer1/sync.c **** 	/* NB detection only works if the TOA of the SB
 119:layer1/sync.c **** 	 * is within 0...8. We have to add 75 to get an SB TOA of 4. */
 120:layer1/sync.c **** 	tpu_shift += 75;
 121:layer1/sync.c **** 
 122:layer1/sync.c **** 	tpu_shift = (l1s.tpu_offset + tpu_shift) % QBITS_PER_TDMA;
 123:layer1/sync.c **** 
 124:layer1/sync.c **** 	fn_offset = cinfo->fn_offset - 1;
 125:layer1/sync.c **** 
 126:layer1/sync.c **** 	/* if we're already very close to the end of the TPU frame, the
 127:layer1/sync.c **** 	 * next interrupt will basically occur now and we need to
 128:layer1/sync.c **** 	 * compensate */
 129:layer1/sync.c **** 	if (tpu_shift < SWITCH_TIME)
 130:layer1/sync.c **** 		fn_offset++;
 131:layer1/sync.c **** 
 132:layer1/sync.c **** #if 0 /* probably wrong as we already added "offset" and "shift" above */
 133:layer1/sync.c **** 	/* increment the TPU quarter-bit offset */
 134:layer1/sync.c **** 	l1s.tpu_offset = (l1s.tpu_offset + tpu_shift) % TPU_RANGE;
 135:layer1/sync.c **** #else
 136:layer1/sync.c **** 	l1s.tpu_offset = tpu_shift;
 137:layer1/sync.c **** #endif
 138:layer1/sync.c **** 
 139:layer1/sync.c **** 	puts("Synchronize_TDMA\n");
 140:layer1/sync.c **** 	/* request the TPU to adjust the SYNCHRO and OFFSET registers */
 141:layer1/sync.c **** 	tpu_enq_at(SWITCH_TIME);
 142:layer1/sync.c **** 	tpu_enq_sync(l1s.tpu_offset);
 143:layer1/sync.c **** #if 0
 144:layer1/sync.c **** 	/* FIXME: properly end the TPU window at the emd of l1_sync() */
 145:layer1/sync.c **** 	tpu_end_scenario();
 146:layer1/sync.c **** #endif
 147:layer1/sync.c **** 
 148:layer1/sync.c **** 	/* Change the current time to reflect the new value */
 149:layer1/sync.c **** 	l1s_time_inc(&l1s.current_time, fn_offset);
 150:layer1/sync.c **** 	l1s.next_time = l1s.current_time;
 151:layer1/sync.c **** 	l1s_time_inc(&l1s.next_time, 1);
 152:layer1/sync.c **** 
 153:layer1/sync.c **** 	/* The serving cell now no longer has a frame or bit offset */
 154:layer1/sync.c **** 	cinfo->fn_offset = 0;
 155:layer1/sync.c **** 	cinfo->time_alignment = 0;
 156:layer1/sync.c **** }
 157:layer1/sync.c **** 
 158:layer1/sync.c **** void l1s_reset_hw(void)
 159:layer1/sync.c **** {
 160:layer1/sync.c **** 	dsp_api.w_page = 0;
 161:layer1/sync.c **** 	dsp_api.r_page = 0;
 162:layer1/sync.c **** 	dsp_api.r_page_used = 0;
 163:layer1/sync.c **** 	dsp_api.db_w = (T_DB_MCU_TO_DSP *) BASE_API_W_PAGE_0;
 164:layer1/sync.c **** 	dsp_api.db_r = (T_DB_DSP_TO_MCU *) BASE_API_R_PAGE_0;
 165:layer1/sync.c **** 	dsp_api.ndb->d_dsp_page = 0;
 166:layer1/sync.c **** 
 167:layer1/sync.c **** 	/* we have to really reset the TPU, otherwise FB detection
 168:layer1/sync.c **** 	 * sometimes returns wrong TOA values. */
 169:layer1/sync.c **** 	tpu_reset(1);
 170:layer1/sync.c **** 	tpu_reset(0);
 171:layer1/sync.c **** 	tpu_rewind();
 172:layer1/sync.c **** 	tpu_enq_wait(5); /* really needed ? */
 173:layer1/sync.c **** 	tpu_enq_sync(l1s.tpu_offset);
 174:layer1/sync.c **** 	tpu_end_scenario();
 175:layer1/sync.c **** }
 176:layer1/sync.c **** 
 177:layer1/sync.c **** /* Lost TDMA interrupt detection.  This works by starting a hardware timer
 178:layer1/sync.c ****  * that is clocked by the same master clock source (VCTCXO).  We expect
 179:layer1/sync.c ****  * 1875 timer ticks in the duration of a TDMA frame (5000 qbits / 1250 bits) */
 180:layer1/sync.c **** 
 181:layer1/sync.c **** /* Timer for detecting lost IRQ */
 182:layer1/sync.c **** #define TIMER_TICKS_PER_TDMA	1875
 183:layer1/sync.c **** #define TIMER_TICK_JITTER	1
 184:layer1/sync.c **** 
 185:layer1/sync.c **** static int last_timestamp;
 186:layer1/sync.c **** 
 187:layer1/sync.c **** static inline void check_lost_frame(void)
 188:layer1/sync.c **** {
 189:layer1/sync.c **** 	int diff, timestamp = hwtimer_read(1);
 190:layer1/sync.c **** 
 191:layer1/sync.c **** 	if (last_timestamp < timestamp)
 192:layer1/sync.c **** 		last_timestamp += (4*TIMER_TICKS_PER_TDMA);
 193:layer1/sync.c **** 
 194:layer1/sync.c **** 	diff = last_timestamp - timestamp;
 195:layer1/sync.c **** 
 196:layer1/sync.c **** 	/* allow for a bit of jitter */
 197:layer1/sync.c **** 	if (diff < TIMER_TICKS_PER_TDMA - TIMER_TICK_JITTER ||
 198:layer1/sync.c **** 	    diff > TIMER_TICKS_PER_TDMA + TIMER_TICK_JITTER)
 199:layer1/sync.c **** 		printf("LOST %d!\n", diff);
 200:layer1/sync.c **** 
 201:layer1/sync.c **** 	last_timestamp = timestamp;
 202:layer1/sync.c **** }
 203:layer1/sync.c **** 
 204:layer1/sync.c **** /* schedule a completion */
 205:layer1/sync.c **** void l1s_compl_sched(enum l1_compl c)
 206:layer1/sync.c **** {
 207:layer1/sync.c **** 	unsigned long flags;
 208:layer1/sync.c **** 
 209:layer1/sync.c **** 	local_firq_save(flags);
 210:layer1/sync.c **** 	l1s.scheduled_compl |= (1 << c);
 211:layer1/sync.c **** 	local_irq_restore(flags);
 212:layer1/sync.c **** }
 213:layer1/sync.c **** 
 214:layer1/sync.c **** /* main routine for synchronous part of layer 1, called by frame interrupt
 215:layer1/sync.c ****  * generated by TPU once every TDMA frame */
 216:layer1/sync.c **** static void l1_sync(void)
 217:layer1/sync.c **** {
 218:layer1/sync.c **** 	uint16_t sched_flags;
 219:layer1/sync.c **** 
 220:layer1/sync.c **** 	putchart('+');
 221:layer1/sync.c **** 
 222:layer1/sync.c **** 	check_lost_frame();
 223:layer1/sync.c **** 
 224:layer1/sync.c **** 	/* Increment Time */
 225:layer1/sync.c **** 	l1s.current_time = l1s.next_time;
 226:layer1/sync.c **** 	l1s_time_inc(&l1s.next_time, 1);
 227:layer1/sync.c **** 	//l1s_time_dump(&l1s.current_time); putchar(' ');
 228:layer1/sync.c **** 
 229:layer1/sync.c **** 	dsp_api.frame_ctr++;
 230:layer1/sync.c **** 	dsp_api.r_page_used = 0;
 231:layer1/sync.c **** 
 232:layer1/sync.c **** 	/* Update pointers */
 233:layer1/sync.c **** 	if (dsp_api.w_page == 0)
 234:layer1/sync.c **** 		dsp_api.db_w = (T_DB_MCU_TO_DSP *) BASE_API_W_PAGE_0;
 235:layer1/sync.c **** 	else
 236:layer1/sync.c **** 		dsp_api.db_w = (T_DB_MCU_TO_DSP *) BASE_API_W_PAGE_1;
 237:layer1/sync.c **** 
 238:layer1/sync.c **** 	if (dsp_api.r_page == 0)
 239:layer1/sync.c **** 		dsp_api.db_r = (T_DB_DSP_TO_MCU *) BASE_API_R_PAGE_0;
 240:layer1/sync.c **** 	else
 241:layer1/sync.c **** 		dsp_api.db_r = (T_DB_DSP_TO_MCU *) BASE_API_R_PAGE_1;
 242:layer1/sync.c **** 
 243:layer1/sync.c **** 	/* Reset MCU->DSP page */
 244:layer1/sync.c **** 	dsp_api_memset((uint16_t *) dsp_api.db_w, sizeof(*dsp_api.db_w));
 245:layer1/sync.c **** 
 246:layer1/sync.c **** 	/* Update AFC */
 247:layer1/sync.c **** 	afc_load_dsp();
 248:layer1/sync.c **** 
 249:layer1/sync.c **** 	if (dsp_api.ndb->d_error_status) {
 250:layer1/sync.c **** 		printf("DSP Error Status: %u\n", dsp_api.ndb->d_error_status);
 251:layer1/sync.c **** 		dsp_api.ndb->d_error_status = 0;
 252:layer1/sync.c **** 	}
 253:layer1/sync.c **** 
 254:layer1/sync.c **** 	/* execute the sched_items that have been scheduled for this
 255:layer1/sync.c **** 	 * TDMA frame (including setup/cleanup steps) */
 256:layer1/sync.c **** 	sched_flags = tdma_sched_flag_scan();
 257:layer1/sync.c **** 
 258:layer1/sync.c **** 	if (sched_flags & TDMA_IFLG_TPU)
 259:layer1/sync.c **** 		l1s_win_init();
 260:layer1/sync.c **** 
 261:layer1/sync.c **** 	tdma_sched_execute();
 262:layer1/sync.c **** 
 263:layer1/sync.c **** 	if (dsp_api.r_page_used) {
 264:layer1/sync.c **** 		/* clear and switch the read page */
 265:layer1/sync.c **** 		dsp_api_memset((uint16_t *) dsp_api.db_r,
 266:layer1/sync.c **** 				sizeof(*dsp_api.db_r));
 267:layer1/sync.c **** 
 268:layer1/sync.c **** 		/* TSM30 does it (really needed ?):
 269:layer1/sync.c **** 		 * Set crc result as "SB not found". */
 270:layer1/sync.c **** 		dsp_api.db_r->a_sch[0] = (1<<B_SCH_CRC);   /* B_SCH_CRC =1, BLUD =0 */
 271:layer1/sync.c **** 
 272:layer1/sync.c **** 		dsp_api.r_page ^= 1;
 273:layer1/sync.c **** 	}
 274:layer1/sync.c **** 
 275:layer1/sync.c **** 	if (sched_flags & TDMA_IFLG_DSP)
 276:layer1/sync.c **** 		dsp_end_scenario();
 277:layer1/sync.c **** 
 278:layer1/sync.c **** 	if (sched_flags & TDMA_IFLG_TPU)
 279:layer1/sync.c **** 		tpu_end_scenario();
 280:layer1/sync.c **** 
 281:layer1/sync.c **** 	/* schedule new / upcoming TDMA items */
 282:layer1/sync.c **** 	mframe_schedule();
 283:layer1/sync.c **** 	/* schedule new / upcoming one-shot events */
 284:layer1/sync.c **** 	sched_gsmtime_execute(l1s.current_time.fn);
 285:layer1/sync.c **** 
 286:layer1/sync.c **** 	tdma_sched_advance();
 287:layer1/sync.c **** }
