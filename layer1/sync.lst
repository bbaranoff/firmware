 322:layer1/sync.c **** /* APC offset is different from different targets */
 323:layer1/sync.c **** extern uint8_t apc_offset; /* see board/.../rf_tables.c */
 324:layer1/sync.c **** 
 325:layer1/sync.c **** void l1s_tx_apc_helper(uint16_t arfcn)
 326:layer1/sync.c **** {
 327:layer1/sync.c **** 	struct txcal_chan_cal (*my_chan_cal)[RF_TX_NUM_SUB_BANDS];
 328:layer1/sync.c **** 	struct txcal_chan_cal (*chan_cal)[RF_TX_NUM_SUB_BANDS];
 329:layer1/sync.c **** 	struct txcal_tx_level *levels, *mylevel;
 330:layer1/sync.c **** 	struct txcal_ramp_def *ramps, *myramp;
 331:layer1/sync.c **** 	int16_t auxapc;
 332:layer1/sync.c **** 	int i;
 333:layer1/sync.c **** 
 334:layer1/sync.c **** 	/* Figure out which band we are working in */
 335:layer1/sync.c **** 	switch (gsm_arfcn2band(arfcn)) {
 336:layer1/sync.c **** 	case GSM_BAND_850:
 337:layer1/sync.c **** 		levels = rf_tx_levels_850;
 338:layer1/sync.c **** 		ramps = rf_tx_ramps_850;
 339:layer1/sync.c **** 		chan_cal = rf_tx_chan_cal_850;
 340:layer1/sync.c **** 		break;
 341:layer1/sync.c **** 	case GSM_BAND_900:
 342:layer1/sync.c **** 		levels = rf_tx_levels_900;
 343:layer1/sync.c **** 		ramps = rf_tx_ramps_900;
 344:layer1/sync.c **** 		chan_cal = rf_tx_chan_cal_900;
 345:layer1/sync.c **** 		break;
 346:layer1/sync.c **** 	case GSM_BAND_1800:
 347:layer1/sync.c **** 		levels = rf_tx_levels_1800;
 348:layer1/sync.c **** 		ramps = rf_tx_ramps_1800;
 349:layer1/sync.c **** 		chan_cal = rf_tx_chan_cal_1800;
 350:layer1/sync.c **** 		break;
 351:layer1/sync.c **** 	case GSM_BAND_1900:
 352:layer1/sync.c **** 		levels = rf_tx_levels_1900;
 353:layer1/sync.c **** 		ramps = rf_tx_ramps_1900;
 354:layer1/sync.c **** 		chan_cal = rf_tx_chan_cal_1900;
 355:layer1/sync.c **** 		break;
 356:layer1/sync.c **** 	default:
 357:layer1/sync.c **** 		puts("Error: invalid band in l1s_tx_apc_helper()!\n");
 358:layer1/sync.c **** 		return;
 359:layer1/sync.c **** 	}
 360:layer1/sync.c **** 
 361:layer1/sync.c **** 	/* Figure out our Tx power level, APC and ramp index */
 362:layer1/sync.c **** 	mylevel = levels + (l1s.tx_power & 0x1F);
 363:layer1/sync.c **** 	auxapc = mylevel->apc;
 364:layer1/sync.c **** 	myramp = ramps + mylevel->ramp_index;
 365:layer1/sync.c **** 	my_chan_cal = chan_cal + mylevel->chan_cal_index;
 366:layer1/sync.c **** 
 367:layer1/sync.c **** 	/* Channel calibration correction */
 368:layer1/sync.c **** 	arfcn &= ~ARFCN_FLAG_MASK;
 369:layer1/sync.c **** 	for (i = 0; i < RF_TX_NUM_SUB_BANDS; i++) {
 370:layer1/sync.c **** 		if (arfcn <= (*my_chan_cal)[i].arfcn_limit)
 371:layer1/sync.c **** 			break;
 372:layer1/sync.c **** 	}
 373:layer1/sync.c **** 	if (i < RF_TX_NUM_SUB_BANDS)
 374:layer1/sync.c **** 		auxapc = ((uint32_t)auxapc * (*my_chan_cal)[i].chan_cal) / 128;
 375:layer1/sync.c **** 
 376:layer1/sync.c **** 	/* Load the (target specific) ApcOffset into the DSP */
 377:layer1/sync.c **** 	dsp_api.ndb->d_apcoff = ABB_VAL(APCOFF, (1 << 6) | apc_offset) | 1; /* 2x slope for the GTA-02 ram
 378:layer1/sync.c **** 
 379:layer1/sync.c **** 	/* Load the TX Power into the DSP */
 380:layer1/sync.c **** 	/*
 381:layer1/sync.c **** 	   If the power is too low (below 0 dBm) the ramp is not OK,
 382:layer1/sync.c **** 	   especially for GSM-1800. However an MS does not send below
 383:layer1/sync.c **** 	   0dBm anyway.
 384:layer1/sync.c **** 	*/
 385:layer1/sync.c **** 	dsp_api.db_w->d_power_ctl = ABB_VAL(AUXAPC, auxapc);
 386:layer1/sync.c **** 
 387:layer1/sync.c **** 	/* Update the ramp according to the PCL */
 388:layer1/sync.c **** 	for (i = 0; i < 16; i++)
 389:layer1/sync.c **** 		dsp_api.ndb->a_ramp[i] = ABB_VAL(APCRAM,
 390:layer1/sync.c **** 			ABB_RAMP_VAL(myramp->ramp_up[i], myramp->ramp_down[i]));
 391:layer1/sync.c **** 
 392:layer1/sync.c **** 	/* The Ramp Table is sent to ABB only once after RF init routine called */
 393:layer1/sync.c **** 	dsp_api.db_w->d_ctrl_abb |= (1 << B_RAMP) | (1 << B_BULRAMPDEL);
 394:layer1/sync.c **** }
