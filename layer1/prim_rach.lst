  54:layer1/prim_rach.c **** /* p1: type of operation (0: one NB, 1: one RACH burst, 2: four NB */
  55:layer1/prim_rach.c **** static int l1s_tx_rach_cmd(__unused uint8_t p1, __unused uint8_t p2, __unused uint16_t p3)
  56:layer1/prim_rach.c **** {
  57:layer1/prim_rach.c **** 	uint16_t  *info_ptr;
  58:layer1/prim_rach.c **** 	uint16_t arfcn;
  59:layer1/prim_rach.c **** 	uint8_t data[2];
  60:layer1/prim_rach.c **** 
  61:layer1/prim_rach.c **** 	putchart('T');
  62:layer1/prim_rach.c **** 
  63:layer1/prim_rach.c **** 	l1s_tx_apc_helper(l1s.serving_cell.arfcn);
  64:layer1/prim_rach.c **** 
  65:layer1/prim_rach.c **** 	/* If an invalid UIC is given, use BSIC. */
  66:layer1/prim_rach.c **** 	if (l1s.rach.uic > 0x3f)
  67:layer1/prim_rach.c **** 		data[0] = l1s.serving_cell.bsic << 2;
  68:layer1/prim_rach.c **** 	else
  69:layer1/prim_rach.c **** 		data[0] = l1s.rach.uic << 2;
  70:layer1/prim_rach.c **** 	data[1] = l1s.rach.ra;
  71:layer1/prim_rach.c **** 
  72:layer1/prim_rach.c **** 	info_ptr = &dsp_api.ndb->d_rach;
  73:layer1/prim_rach.c **** 	info_ptr[0] = ((uint16_t)(data[0])) | ((uint16_t)(data[1])<<8);
  74:layer1/prim_rach.c **** 
  75:layer1/prim_rach.c **** 	arfcn = l1s.serving_cell.arfcn;
  76:layer1/prim_rach.c **** 
  77:layer1/prim_rach.c **** 	dsp_api.db_w->d_task_ra = dsp_task_iq_swap(RACH_DSP_TASK, arfcn, 1);
  78:layer1/prim_rach.c **** 
  79:layer1/prim_rach.c **** 	l1s_tx_win_ctrl(arfcn | ARFCN_UPLINK, L1_TXWIN_AB, 0, 3);
  80:layer1/prim_rach.c **** 
  81:layer1/prim_rach.c **** 	return 0;
  82:layer1/prim_rach.c **** }
  83:layer1/prim_rach.c **** 
