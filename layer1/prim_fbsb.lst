 122:layer1/prim_fbsb.c **** /* SCH Burst Detection ********************************************************/
 123:layer1/prim_fbsb.c **** 
 124:layer1/prim_fbsb.c **** /* determine the GSM time and BSIC from a Sync Burst */
 125:layer1/prim_fbsb.c **** static uint8_t l1s_decode_sb(struct gsm_time *time, uint32_t sb)
 126:layer1/prim_fbsb.c **** {
 127:layer1/prim_fbsb.c **** 	uint8_t bsic = (sb >> 2) & 0x3f;
 128:layer1/prim_fbsb.c **** 	uint8_t t3p;
 129:layer1/prim_fbsb.c **** 
 130:layer1/prim_fbsb.c **** 	memset(time, 0, sizeof(*time));
 131:layer1/prim_fbsb.c **** 
 132:layer1/prim_fbsb.c **** 	/* TS 05.02 Chapter 3.3.2.2.1 SCH Frame Numbers */
 133:layer1/prim_fbsb.c **** 	time->t1 = ((sb >> 23) & 1) | ((sb >> 7) & 0x1fe) | ((sb << 9) & 0x600);
 134:layer1/prim_fbsb.c **** 	time->t2 = (sb >> 18) & 0x1f;
 135:layer1/prim_fbsb.c **** 	t3p = ((sb >> 24) & 1) | ((sb >> 15) & 6);
 136:layer1/prim_fbsb.c **** 	time->t3 = t3p*10 + 1;
 137:layer1/prim_fbsb.c **** 
 138:layer1/prim_fbsb.c **** 	/* TS 05.02 Chapter 4.3.3 TDMA frame number */
 139:layer1/prim_fbsb.c **** 	time->fn = gsm_gsmtime2fn(time);
 140:layer1/prim_fbsb.c **** 
 141:layer1/prim_fbsb.c **** 	time->tc = (time->fn / 51) % 8;
 142:layer1/prim_fbsb.c **** 
 143:layer1/prim_fbsb.c **** 	return bsic;
 144:layer1/prim_fbsb.c **** }
 145:layer1/prim_fbsb.c **** 
 146:layer1/prim_fbsb.c **** static void read_sb_result(struct mon_state *st, int attempt)
 147:layer1/prim_fbsb.c **** {
 148:layer1/prim_fbsb.c **** 	st->toa = dsp_api.db_r->a_serv_demod[D_TOA];
 149:layer1/prim_fbsb.c **** 	st->pm = dsp_api.db_r->a_serv_demod[D_PM]>>3;
 150:layer1/prim_fbsb.c **** 	st->angle = dsp_api.db_r->a_serv_demod[D_ANGLE];
 151:layer1/prim_fbsb.c **** 	st->snr = dsp_api.db_r->a_serv_demod[D_SNR];
 152:layer1/prim_fbsb.c **** 
 153:layer1/prim_fbsb.c **** 	st->freq_diff = ANGLE_TO_FREQ(st->angle);
 154:layer1/prim_fbsb.c **** 	st->fnr_report = l1s.current_time.fn;
 155:layer1/prim_fbsb.c **** 	st->attempt = attempt;
 156:layer1/prim_fbsb.c **** 
 157:layer1/prim_fbsb.c **** 	dump_mon_state(st);
 158:layer1/prim_fbsb.c **** 
 159:layer1/prim_fbsb.c **** 	if (st->snr > AFC_SNR_THRESHOLD)
 160:layer1/prim_fbsb.c **** 		afc_input(st->freq_diff, rf_arfcn, 1);
 161:layer1/prim_fbsb.c **** 	else
 162:layer1/prim_fbsb.c **** 		afc_input(st->freq_diff, rf_arfcn, 0);
 163:layer1/prim_fbsb.c **** 
 164:layer1/prim_fbsb.c **** 	dsp_api.r_page_used = 1;
 165:layer1/prim_fbsb.c **** }
