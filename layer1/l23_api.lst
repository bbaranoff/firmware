 192:layer1/l23_api.c **** 
 193:layer1/l23_api.c **** struct msgb *l1ctl_msgb_alloc(uint8_t msg_type)
 194:layer1/l23_api.c **** {
 195:layer1/l23_api.c **** 	struct msgb *msg;
 196:layer1/l23_api.c **** 	struct l1ctl_hdr *l1h;
 197:layer1/l23_api.c **** 
 198:layer1/l23_api.c **** 	msg = msgb_alloc_headroom(L3_MSG_SIZE, L3_MSG_HEAD, "l1ctl");
 199:layer1/l23_api.c **** 	if (!msg) {
 200:layer1/l23_api.c **** 		while (1) {
 201:layer1/l23_api.c **** 			puts("OOPS. Out of buffers...\n");
 202:layer1/l23_api.c **** 		}
 203:layer1/l23_api.c **** 
 204:layer1/l23_api.c **** 		return NULL;
 205:layer1/l23_api.c **** 	}
 206:layer1/l23_api.c **** 	l1h = (struct l1ctl_hdr *) msgb_put(msg, sizeof(*l1h));
 207:layer1/l23_api.c **** 	l1h->msg_type = msg_type;
 208:layer1/l23_api.c **** 	l1h->flags = 0;
 209:layer1/l23_api.c **** 
 210:layer1/l23_api.c **** 	msg->l1h = (uint8_t *)l1h;
 211:layer1/l23_api.c **** 
 212:layer1/l23_api.c **** 	return msg;
 213:layer1/l23_api.c **** }
 214:layer1/l23_api.c **** 
 215:layer1/l23_api.c **** struct msgb *l1_create_l2_msg(int msg_type, uint32_t fn, uint16_t snr,
 216:layer1/l23_api.c **** 			      uint16_t arfcn)
 217:layer1/l23_api.c **** {
 218:layer1/l23_api.c **** 	struct l1ctl_info_dl *dl;
 219:layer1/l23_api.c **** 	struct msgb *msg = l1ctl_msgb_alloc(msg_type);
 220:layer1/l23_api.c **** 
 221:layer1/l23_api.c **** 	dl = (struct l1ctl_info_dl *) msgb_put(msg, sizeof(*dl));
 222:layer1/l23_api.c **** 	dl->frame_nr = htonl(fn);
 223:layer1/l23_api.c **** 	dl->snr = snr;
 224:layer1/l23_api.c **** 	dl->band_arfcn = htons(arfcn);
 225:layer1/l23_api.c **** 
 226:layer1/l23_api.c **** 	return msg;
 227:layer1/l23_api.c **** }
 228:layer1/l23_api.c **** 
 229:layer1/l23_api.c **** /* receive a L1CTL_FBSB_REQ from L23 */
 230:layer1/l23_api.c **** static void l1ctl_rx_fbsb_req(struct msgb *msg)
 231:layer1/l23_api.c **** {
 232:layer1/l23_api.c **** 	struct l1ctl_hdr *l1h = (struct l1ctl_hdr *) msg->data;
 233:layer1/l23_api.c **** 	struct l1ctl_fbsb_req *sync_req = (struct l1ctl_fbsb_req *) l1h->data;
 234:layer1/l23_api.c **** 
 235:layer1/l23_api.c **** 	if (sizeof(*sync_req) > msg->len) {
 236:layer1/l23_api.c **** 		printf("Short sync msg. %u\n", msg->len);
 237:layer1/l23_api.c **** 		return;
 238:layer1/l23_api.c **** 	}
 239:layer1/l23_api.c **** 
 240:layer1/l23_api.c **** 	printd("L1CTL_FBSB_REQ (arfcn=%u, flags=0x%x)\n",
 241:layer1/l23_api.c **** 		ntohs(sync_req->band_arfcn), sync_req->flags);
 242:layer1/l23_api.c **** 
 243:layer1/l23_api.c **** 	/* reset scheduler and hardware */
 244:layer1/l23_api.c **** 	l1s_reset();
 245:layer1/l23_api.c **** 
 246:layer1/l23_api.c **** 	/* pre-set the CCCH mode */
 247:layer1/l23_api.c **** 	l1s.serving_cell.ccch_mode = sync_req->ccch_mode;
 248:layer1/l23_api.c **** 
 249:layer1/l23_api.c **** 	printd("Starting FCCH Recognition\n");
 250:layer1/l23_api.c **** 	l1s_fbsb_req(1, sync_req);
 251:layer1/l23_api.c **** }
 252:layer1/l23_api.c **** 
 253:layer1/l23_api.c **** /* receive a L1CTL_DM_EST_REQ from L23 */
 254:layer1/l23_api.c **** static void l1ctl_rx_dm_est_req(struct msgb *msg)
 255:layer1/l23_api.c **** {
 256:layer1/l23_api.c **** 	struct l1ctl_hdr *l1h = (struct l1ctl_hdr *) msg->data;
 257:layer1/l23_api.c **** 	struct l1ctl_info_ul *ul = (struct l1ctl_info_ul *) l1h->data;
 258:layer1/l23_api.c **** 	struct l1ctl_dm_est_req *est_req = (struct l1ctl_dm_est_req *) ul->payload;
 259:layer1/l23_api.c **** 
 260:layer1/l23_api.c **** 	printd("L1CTL_DM_EST_REQ (chan_nr=0x%02x, tsc=%u)\n",
 261:layer1/l23_api.c **** 	       ul->chan_nr, est_req->tsc);
 262:layer1/l23_api.c **** 
 263:layer1/l23_api.c **** 	/* disable neighbour cell measurement of C0 TS 0 */
 264:layer1/l23_api.c **** 	mframe_disable(MF_TASK_NEIGH_PM51_C0T0);
 265:layer1/l23_api.c **** 
 266:layer1/l23_api.c **** 	/* configure dedicated channel state */
 267:layer1/l23_api.c **** 	l1s.dedicated.type = chan_nr2dchan_type(ul->chan_nr);
 268:layer1/l23_api.c **** 	l1s.dedicated.tsc  = est_req->tsc;
 269:layer1/l23_api.c **** 	l1s.dedicated.tn   = ul->chan_nr & 0x7;
 270:layer1/l23_api.c **** 	l1s.dedicated.h    = est_req->h;
 271:layer1/l23_api.c **** 
 272:layer1/l23_api.c **** 	if (est_req->h) {
 273:layer1/l23_api.c **** 		int i;
 274:layer1/l23_api.c **** 		l1s.dedicated.h1.hsn  = est_req->h1.hsn;
 275:layer1/l23_api.c **** 		l1s.dedicated.h1.maio = est_req->h1.maio;
 276:layer1/l23_api.c **** 		l1s.dedicated.h1.n    = est_req->h1.n;
 277:layer1/l23_api.c **** 		for (i=0; i<est_req->h1.n; i++)
 278:layer1/l23_api.c **** 			l1s.dedicated.h1.ma[i] = ntohs(est_req->h1.ma[i]);
 279:layer1/l23_api.c **** 		printd("L1CTL_DM_EST_REQ indicates H1 (HSN=%u, MAIO=%u, chans=%u)\n",
 280:layer1/l23_api.c **** 		       est_req->h1.hsn, est_req->h1.maio, est_req->h1.n);
 281:layer1/l23_api.c **** 	} else {
 282:layer1/l23_api.c **** 		l1s.dedicated.h0.arfcn = ntohs(est_req->h0.band_arfcn);
 283:layer1/l23_api.c **** 		printd("L1CTL_DM_EST_REQ indicates H0 (ARFCN=%u)\n",
 284:layer1/l23_api.c **** 		       l1s.dedicated.h0.arfcn & ~ARFCN_FLAG_MASK);
 285:layer1/l23_api.c **** 	}
 286:layer1/l23_api.c **** 
 287:layer1/l23_api.c **** 	/* TCH config */
 288:layer1/l23_api.c **** 	if (chan_nr_is_tch(ul->chan_nr)) {
 289:layer1/l23_api.c **** 		/* Mode */
 290:layer1/l23_api.c **** 		l1a_tch_mode_set(est_req->tch_mode);
 291:layer1/l23_api.c **** 		l1a_audio_mode_set(est_req->audio_mode);
 292:layer1/l23_api.c **** 		l1a_tch_flags_set(est_req->tch_flags);
 293:layer1/l23_api.c **** 
 294:layer1/l23_api.c **** 		/* Sync */
 295:layer1/l23_api.c **** 		l1s.tch_sync = 1;	/* can be set without locking */
 296:layer1/l23_api.c **** 
 297:layer1/l23_api.c **** 		/* Audio path */
 298:layer1/l23_api.c **** 		audio_set_enabled(est_req->tch_mode, est_req->audio_mode);
 299:layer1/l23_api.c **** 	}
 300:layer1/l23_api.c **** 
 301:layer1/l23_api.c **** 	/* figure out which MF tasks to enable */
 302:layer1/l23_api.c **** 	l1a_mftask_set(chan_nr2mf_task_mask(ul->chan_nr, NEIGH_MODE_PM));
 303:layer1/l23_api.c **** }
 304:layer1/l23_api.c **** 
 305:layer1/l23_api.c **** /* receive a L1CTL_DM_FREQ_REQ from L23 */
 306:layer1/l23_api.c **** static void l1ctl_rx_dm_freq_req(struct msgb *msg)
 307:layer1/l23_api.c **** {
 308:layer1/l23_api.c **** 	struct l1ctl_hdr *l1h = (struct l1ctl_hdr *) msg->data;
 309:layer1/l23_api.c **** 	struct l1ctl_info_ul *ul = (struct l1ctl_info_ul *) l1h->data;
 310:layer1/l23_api.c **** 	struct l1ctl_dm_freq_req *freq_req =
 311:layer1/l23_api.c **** 			(struct l1ctl_dm_freq_req *) ul->payload;
 312:layer1/l23_api.c **** 
 313:layer1/l23_api.c **** 	printd("L1CTL_DM_FREQ_REQ (arfcn=%u, tsc=%u)\n",
 314:layer1/l23_api.c **** 		ntohs(freq_req->h0.band_arfcn), freq_req->tsc);
 315:layer1/l23_api.c **** 
 316:layer1/l23_api.c **** 	/* configure dedicated channel state */
 317:layer1/l23_api.c **** 	l1s.dedicated.st_tsc  = freq_req->tsc;
 318:layer1/l23_api.c **** 	l1s.dedicated.st_h    = freq_req->h;
 319:layer1/l23_api.c **** 
 320:layer1/l23_api.c **** 	if (freq_req->h) {
 321:layer1/l23_api.c **** 		int i;
 322:layer1/l23_api.c **** 		l1s.dedicated.st_h1.hsn  = freq_req->h1.hsn;
 323:layer1/l23_api.c **** 		l1s.dedicated.st_h1.maio = freq_req->h1.maio;
 324:layer1/l23_api.c **** 		l1s.dedicated.st_h1.n    = freq_req->h1.n;
 325:layer1/l23_api.c **** 		for (i=0; i<freq_req->h1.n; i++)
 326:layer1/l23_api.c **** 			l1s.dedicated.st_h1.ma[i] = ntohs(freq_req->h1.ma[i]);
 327:layer1/l23_api.c **** 	} else {
 328:layer1/l23_api.c **** 		l1s.dedicated.st_h0.arfcn = ntohs(freq_req->h0.band_arfcn);
 329:layer1/l23_api.c **** 	}
 330:layer1/l23_api.c **** 
 331:layer1/l23_api.c **** 	l1a_freq_req(ntohs(freq_req->fn));
 332:layer1/l23_api.c **** }
 333:layer1/l23_api.c **** 
 334:layer1/l23_api.c **** /* receive a L1CTL_CRYPTO_REQ from L23 */
 335:layer1/l23_api.c **** static void l1ctl_rx_crypto_req(struct msgb *msg)
 336:layer1/l23_api.c **** {
 337:layer1/l23_api.c **** 	struct l1ctl_hdr *l1h = (struct l1ctl_hdr *) msg->data;
 338:layer1/l23_api.c **** 	struct l1ctl_info_ul *ul = (struct l1ctl_info_ul *) l1h->data;
 339:layer1/l23_api.c **** 	struct l1ctl_crypto_req *cr = (struct l1ctl_crypto_req *) ul->payload;
 340:layer1/l23_api.c **** 
 341:layer1/l23_api.c **** 	printd("L1CTL_CRYPTO_REQ (algo=A5/%u, len=%u)\n", cr->algo, cr->key_len);
 342:layer1/l23_api.c **** 
 343:layer1/l23_api.c **** 	if (cr->algo && cr->key_len != 8) {
 344:layer1/l23_api.c **** 		printd("L1CTL_CRYPTO_REQ -> Invalid key\n");
 345:layer1/l23_api.c **** 		return;
 346:layer1/l23_api.c **** 	}
 347:layer1/l23_api.c **** 
 348:layer1/l23_api.c **** 	dsp_load_ciph_param(cr->algo, cr->key);
 349:layer1/l23_api.c **** }
 350:layer1/l23_api.c **** 
 351:layer1/l23_api.c **** /* receive a L1CTL_DM_REL_REQ from L23 */
 352:layer1/l23_api.c **** static void l1ctl_rx_dm_rel_req(struct msgb *msg)
 353:layer1/l23_api.c **** {
 354:layer1/l23_api.c **** 	printd("L1CTL_DM_REL_REQ\n");
 355:layer1/l23_api.c **** 	l1a_mftask_set(0);
 356:layer1/l23_api.c **** 	l1s.dedicated.type = GSM_DCHAN_NONE;
 357:layer1/l23_api.c **** 	l1a_txq_msgb_flush(&l1s.tx_queue[L1S_CHAN_MAIN]);
 358:layer1/l23_api.c **** 	l1a_txq_msgb_flush(&l1s.tx_queue[L1S_CHAN_SACCH]);
 359:layer1/l23_api.c **** 	l1a_txq_msgb_flush(&l1s.tx_queue[L1S_CHAN_TRAFFIC]);
 360:layer1/l23_api.c **** 	l1a_meas_msgb_set(NULL);
 361:layer1/l23_api.c **** 	dsp_load_ciph_param(0, NULL);
 362:layer1/l23_api.c **** 	l1a_tch_mode_set(GSM48_CMODE_SIGN);
 363:layer1/l23_api.c **** 	audio_set_enabled(GSM48_CMODE_SIGN, 0);
 364:layer1/l23_api.c **** 	l1s.tch_loop_mode = L1CTL_TCH_LOOP_OPEN;
 365:layer1/l23_api.c **** 	l1s.neigh_pm.n = 0;
 366:layer1/l23_api.c **** }
 367:layer1/l23_api.c **** 
 368:layer1/l23_api.c **** /* receive a L1CTL_PARAM_REQ from L23 */
 369:layer1/l23_api.c **** static void l1ctl_rx_param_req(struct msgb *msg)
 370:layer1/l23_api.c **** {
 371:layer1/l23_api.c **** 	struct l1ctl_hdr *l1h = (struct l1ctl_hdr *) msg->data;
 372:layer1/l23_api.c **** 	struct l1ctl_info_ul *ul = (struct l1ctl_info_ul *) l1h->data;
 373:layer1/l23_api.c **** 	struct l1ctl_par_req *par_req = (struct l1ctl_par_req *) ul->payload;
 374:layer1/l23_api.c **** 
 375:layer1/l23_api.c **** 	printd("L1CTL_PARAM_REQ (ta=%d, tx_power=%u)\n", par_req->ta,
 376:layer1/l23_api.c **** 		par_req->tx_power);
 377:layer1/l23_api.c **** 
 378:layer1/l23_api.c **** 	l1s.ta = par_req->ta;
 379:layer1/l23_api.c **** 	l1s.tx_power = par_req->tx_power;
 380:layer1/l23_api.c **** }
 381:layer1/l23_api.c **** 
 382:layer1/l23_api.c **** /* receive a L1CTL_RACH_REQ from L23 */
 383:layer1/l23_api.c **** static void l1ctl_rx_rach_req(struct msgb *msg)
 384:layer1/l23_api.c **** {
 385:layer1/l23_api.c **** 	struct l1ctl_hdr *l1h = (struct l1ctl_hdr *) msg->data;
 386:layer1/l23_api.c **** 	struct l1ctl_info_ul *ul = (struct l1ctl_info_ul *) l1h->data;
 387:layer1/l23_api.c **** 	struct l1ctl_rach_req *rach_req = (struct l1ctl_rach_req *) ul->payload;
 388:layer1/l23_api.c **** 
 389:layer1/l23_api.c **** 	printd("L1CTL_RACH_REQ (ra=0x%02x, offset=%d, combined=%d, uic=0x%02x)\n",
 390:layer1/l23_api.c **** 		rach_req->ra, ntohs(rach_req->offset), rach_req->combined, rach_req->uic);
 391:layer1/l23_api.c **** 
 392:layer1/l23_api.c **** 	l1a_rach_req(ntohs(rach_req->offset), rach_req->combined, rach_req->ra, rach_req->uic);
 393:layer1/l23_api.c **** }
 394:layer1/l23_api.c **** 
 395:layer1/l23_api.c **** /* receive a L1CTL_DATA_REQ from L23 */
 396:layer1/l23_api.c **** static void l1ctl_rx_data_req(struct msgb *msg)
 397:layer1/l23_api.c **** {
 398:layer1/l23_api.c **** 	struct l1ctl_hdr *l1h = (struct l1ctl_hdr *) msg->data;
 399:layer1/l23_api.c **** 	struct l1ctl_info_ul *ul = (struct l1ctl_info_ul *) l1h->data;
 400:layer1/l23_api.c **** 	struct l1ctl_data_ind *data_ind = (struct l1ctl_data_ind *) ul->payload;
 401:layer1/l23_api.c **** 	struct llist_head *tx_queue;
 402:layer1/l23_api.c **** 
 403:layer1/l23_api.c **** 	printd("L1CTL_DATA_REQ (link_id=0x%02x)\n", ul->link_id);
 404:layer1/l23_api.c **** 
 405:layer1/l23_api.c **** 	msg->l3h = data_ind->data;
 406:layer1/l23_api.c **** 	if (ul->link_id & 0x40) {
 407:layer1/l23_api.c **** 		struct gsm48_hdr *gh = (struct gsm48_hdr *)(data_ind->data + 5);
 408:layer1/l23_api.c **** 		if (gh->proto_discr == GSM48_PDISC_RR
 409:layer1/l23_api.c **** 		 && gh->msg_type == GSM48_MT_RR_MEAS_REP) {
 410:layer1/l23_api.c **** 			printd("updating measurement report\n");
 411:layer1/l23_api.c **** 			l1a_meas_msgb_set(msg);
 412:layer1/l23_api.c **** 			return;
 413:layer1/l23_api.c **** 		}
 414:layer1/l23_api.c **** 		tx_queue = &l1s.tx_queue[L1S_CHAN_SACCH];
 415:layer1/l23_api.c **** 	} else
 416:layer1/l23_api.c **** 		tx_queue = &l1s.tx_queue[L1S_CHAN_MAIN];
 417:layer1/l23_api.c **** 
 418:layer1/l23_api.c **** 	printd("ul=%p, ul->payload=%p, data_ind=%p, data_ind->data=%p l3h=%p\n",
 419:layer1/l23_api.c **** 		ul, ul->payload, data_ind, data_ind->data, msg->l3h);
 420:layer1/l23_api.c **** 
 421:layer1/l23_api.c **** 	l1a_txq_msgb_enq(tx_queue, msg);
 422:layer1/l23_api.c **** }
 423:layer1/l23_api.c **** 
 424:layer1/l23_api.c **** /* receive a L1CTL_PM_REQ from L23 */
 425:layer1/l23_api.c **** static void l1ctl_rx_pm_req(struct msgb *msg)
 426:layer1/l23_api.c **** {
 427:layer1/l23_api.c **** 	struct l1ctl_hdr *l1h = (struct l1ctl_hdr *) msg->data;
 428:layer1/l23_api.c **** 	struct l1ctl_pm_req *pm_req = (struct l1ctl_pm_req *) l1h->data;
 429:layer1/l23_api.c **** 
 430:layer1/l23_api.c **** 	switch (pm_req->type) {
 431:layer1/l23_api.c **** 	case 1:
 432:layer1/l23_api.c **** 		l1s.pm.mode = 1;
 433:layer1/l23_api.c **** 		l1s.pm.range.arfcn_start =
 434:layer1/l23_api.c **** 				ntohs(pm_req->range.band_arfcn_from);
 435:layer1/l23_api.c **** 		l1s.pm.range.arfcn_next =
 436:layer1/l23_api.c **** 				ntohs(pm_req->range.band_arfcn_from);
 437:layer1/l23_api.c **** 		l1s.pm.range.arfcn_end =
 438:layer1/l23_api.c **** 				ntohs(pm_req->range.band_arfcn_to);
 439:layer1/l23_api.c **** 		printf("L1CTL_PM_REQ start=%u end=%u\n",
 440:layer1/l23_api.c **** 			l1s.pm.range.arfcn_start, l1s.pm.range.arfcn_end);
 441:layer1/l23_api.c **** 		break;
 442:layer1/l23_api.c **** 	}
 443:layer1/l23_api.c **** 	l1s_reset_hw(); /* must reset, otherwise measurement results are delayed */
 444:layer1/l23_api.c **** 	l1s_pm_test(1, l1s.pm.range.arfcn_next);
 445:layer1/l23_api.c **** }
 446:layer1/l23_api.c **** 
 447:layer1/l23_api.c **** /* Transmit a L1CTL_RESET_IND or L1CTL_RESET_CONF */
 448:layer1/l23_api.c **** void l1ctl_tx_reset(uint8_t msg_type, uint8_t reset_type)
 449:layer1/l23_api.c **** {
 450:layer1/l23_api.c **** 	struct msgb *msg = l1ctl_msgb_alloc(msg_type);
 451:layer1/l23_api.c **** 	struct l1ctl_reset *reset_resp;
 452:layer1/l23_api.c **** 	reset_resp = (struct l1ctl_reset *)
 453:layer1/l23_api.c **** 				msgb_put(msg, sizeof(*reset_resp));
 454:layer1/l23_api.c **** 	reset_resp->type = reset_type;
 455:layer1/l23_api.c **** 
 456:layer1/l23_api.c **** 	l1_queue_for_l2(msg);
 457:layer1/l23_api.c **** }
 458:layer1/l23_api.c **** 
 459:layer1/l23_api.c **** /* receive a L1CTL_RESET_REQ from L23 */
 460:layer1/l23_api.c **** static void l1ctl_rx_reset_req(struct msgb *msg)
 461:layer1/l23_api.c **** {
 462:layer1/l23_api.c **** 	struct l1ctl_hdr *l1h = (struct l1ctl_hdr *) msg->data;
 463:layer1/l23_api.c **** 	struct l1ctl_reset *reset_req =
 464:layer1/l23_api.c **** 				(struct l1ctl_reset *) l1h->data;
 465:layer1/l23_api.c **** 
 466:layer1/l23_api.c **** 	switch (reset_req->type) {
 467:layer1/l23_api.c **** 	case L1CTL_RES_T_FULL:
 468:layer1/l23_api.c **** 		printf("L1CTL_RESET_REQ: FULL!\n");
 469:layer1/l23_api.c **** 		l1s_reset();
 470:layer1/l23_api.c **** 		l1s_reset_hw();
 471:layer1/l23_api.c **** 		audio_set_enabled(GSM48_CMODE_SIGN, 0);
 472:layer1/l23_api.c **** 		l1ctl_tx_reset(L1CTL_RESET_CONF, reset_req->type);
 473:layer1/l23_api.c **** 		break;
 474:layer1/l23_api.c **** 	case L1CTL_RES_T_SCHED:
 475:layer1/l23_api.c **** 		printf("L1CTL_RESET_REQ: SCHED!\n");
 476:layer1/l23_api.c **** 		l1ctl_tx_reset(L1CTL_RESET_CONF, reset_req->type);
 477:layer1/l23_api.c **** 		sched_gsmtime_reset();
 478:layer1/l23_api.c **** 		break;
 479:layer1/l23_api.c **** 	default:
 480:layer1/l23_api.c **** 		printf("unknown L1CTL_RESET_REQ type\n");
 481:layer1/l23_api.c **** 		break;
 482:layer1/l23_api.c **** 	}
 483:layer1/l23_api.c **** }
 484:layer1/l23_api.c **** 
 485:layer1/l23_api.c **** /* Transmit a L1CTL_CCCH_MODE_CONF */
 486:layer1/l23_api.c **** static void l1ctl_tx_ccch_mode_conf(uint8_t ccch_mode)
 487:layer1/l23_api.c **** {
 488:layer1/l23_api.c **** 	struct msgb *msg = l1ctl_msgb_alloc(L1CTL_CCCH_MODE_CONF);
 489:layer1/l23_api.c **** 	struct l1ctl_ccch_mode_conf *mode_conf;
 490:layer1/l23_api.c **** 	mode_conf = (struct l1ctl_ccch_mode_conf *)
 491:layer1/l23_api.c **** 				msgb_put(msg, sizeof(*mode_conf));
 492:layer1/l23_api.c **** 	mode_conf->ccch_mode = ccch_mode;
 493:layer1/l23_api.c **** 
 494:layer1/l23_api.c **** 	l1_queue_for_l2(msg);
 495:layer1/l23_api.c **** }
 496:layer1/l23_api.c **** 
 497:layer1/l23_api.c **** /* receive a L1CTL_CCCH_MODE_REQ from L23 */
 498:layer1/l23_api.c **** static void l1ctl_rx_ccch_mode_req(struct msgb *msg)
 499:layer1/l23_api.c **** {
 500:layer1/l23_api.c **** 	struct l1ctl_hdr *l1h = (struct l1ctl_hdr *) msg->data;
 501:layer1/l23_api.c **** 	struct l1ctl_ccch_mode_req *ccch_mode_req =
 502:layer1/l23_api.c **** 		(struct l1ctl_ccch_mode_req *) l1h->data;
 503:layer1/l23_api.c **** 	uint8_t ccch_mode = ccch_mode_req->ccch_mode;
 504:layer1/l23_api.c **** 
 505:layer1/l23_api.c **** 	/* pre-set the CCCH mode */
 506:layer1/l23_api.c **** 	l1s.serving_cell.ccch_mode = ccch_mode;
 507:layer1/l23_api.c **** 
 508:layer1/l23_api.c **** 	/* Update task */
 509:layer1/l23_api.c **** 	mframe_disable(MF_TASK_CCCH_COMB);
 510:layer1/l23_api.c **** 	mframe_disable(MF_TASK_CCCH);
 511:layer1/l23_api.c **** 
 512:layer1/l23_api.c **** 	if (ccch_mode == CCCH_MODE_COMBINED)
 513:layer1/l23_api.c **** 		mframe_enable(MF_TASK_CCCH_COMB);
 514:layer1/l23_api.c **** 	else if (ccch_mode == CCCH_MODE_NON_COMBINED)
 515:layer1/l23_api.c **** 		mframe_enable(MF_TASK_CCCH);
 516:layer1/l23_api.c **** 	else if (ccch_mode == CCCH_MODE_COMBINED_CBCH) {
 517:layer1/l23_api.c **** 		mframe_enable(MF_TASK_CCCH_COMB);
 518:layer1/l23_api.c **** 		mframe_enable(MF_TASK_SDCCH4_CBCH);
 519:layer1/l23_api.c **** 	}
 520:layer1/l23_api.c **** 
 521:layer1/l23_api.c **** 	l1ctl_tx_ccch_mode_conf(ccch_mode);
 522:layer1/l23_api.c **** }
 523:layer1/l23_api.c **** 
 524:layer1/l23_api.c **** /* Transmit a L1CTL_TCH_MODE_CONF */
 525:layer1/l23_api.c **** static void l1ctl_tx_tch_mode_conf(uint8_t tch_mode, uint8_t audio_mode, uint8_t tch_flags)
 526:layer1/l23_api.c **** {
 527:layer1/l23_api.c **** 	struct msgb *msg = l1ctl_msgb_alloc(L1CTL_TCH_MODE_CONF);
 528:layer1/l23_api.c **** 	struct l1ctl_tch_mode_conf *mode_conf;
 529:layer1/l23_api.c **** 	mode_conf = (struct l1ctl_tch_mode_conf *)
 530:layer1/l23_api.c **** 				msgb_put(msg, sizeof(*mode_conf));
 531:layer1/l23_api.c **** 	mode_conf->tch_mode = tch_mode;
 532:layer1/l23_api.c **** 	mode_conf->audio_mode = audio_mode;
 533:layer1/l23_api.c **** 	mode_conf->tch_flags = l1s.tch_flags;
 534:layer1/l23_api.c **** 	mode_conf->tch_loop_mode = l1s.tch_loop_mode;
 535:layer1/l23_api.c **** 
 536:layer1/l23_api.c **** 	l1_queue_for_l2(msg);
 537:layer1/l23_api.c **** }
 538:layer1/l23_api.c **** 
 539:layer1/l23_api.c **** /* receive a L1CTL_TCH_MODE_REQ from L23 */
 540:layer1/l23_api.c **** static void l1ctl_rx_tch_mode_req(struct msgb *msg)
 541:layer1/l23_api.c **** {
 542:layer1/l23_api.c **** 	struct l1ctl_hdr *l1h = (struct l1ctl_hdr *) msg->data;
 543:layer1/l23_api.c **** 	struct l1ctl_tch_mode_req *tch_mode_req =
 544:layer1/l23_api.c **** 		(struct l1ctl_tch_mode_req *) l1h->data;
 545:layer1/l23_api.c **** 	uint8_t tch_mode = tch_mode_req->tch_mode;
 546:layer1/l23_api.c **** 	uint8_t audio_mode = tch_mode_req->audio_mode;
 547:layer1/l23_api.c **** 	uint8_t tch_flags = tch_mode_req->tch_flags;
 548:layer1/l23_api.c **** 
 549:layer1/l23_api.c **** 	printd("L1CTL_TCH_MODE_REQ (tch_mode=0x%02x audio_mode=0x%02x)\n",
 550:layer1/l23_api.c **** 		tch_mode, audio_mode);
 551:layer1/l23_api.c **** 
 552:layer1/l23_api.c **** 	tch_mode = l1a_tch_mode_set(tch_mode);
 553:layer1/l23_api.c **** 	audio_mode = l1a_audio_mode_set(audio_mode);
 554:layer1/l23_api.c **** 	tch_flags = l1a_tch_flags_set(tch_flags);
 555:layer1/l23_api.c **** 
 556:layer1/l23_api.c **** 	audio_set_enabled(tch_mode, audio_mode);
 557:layer1/l23_api.c **** 
 558:layer1/l23_api.c **** 	l1s.tch_sync = 1; /* Needed for audio to work */
 559:layer1/l23_api.c **** 	l1s.tch_loop_mode = tch_mode_req->tch_loop_mode;
 560:layer1/l23_api.c **** 	/* TODO: Handle AMR codecs from tch_mode_req if tch_mode_req->tch_mode==GSM48_CMODE_SPEECH_AMR */
 561:layer1/l23_api.c **** 
 562:layer1/l23_api.c **** 	l1ctl_tx_tch_mode_conf(tch_mode, audio_mode, tch_flags);
 563:layer1/l23_api.c **** }
 564:layer1/l23_api.c **** 
 565:layer1/l23_api.c **** /* receive a L1CTL_NEIGH_PM_REQ from L23 */
 566:layer1/l23_api.c **** static void l1ctl_rx_neigh_pm_req(struct msgb *msg)
 567:layer1/l23_api.c **** {
 568:layer1/l23_api.c **** 	struct l1ctl_hdr *l1h = (struct l1ctl_hdr *) msg->data;
 569:layer1/l23_api.c **** 	struct l1ctl_neigh_pm_req *pm_req =
 570:layer1/l23_api.c **** 		(struct l1ctl_neigh_pm_req *) l1h->data;
 571:layer1/l23_api.c **** 	int i;
 572:layer1/l23_api.c **** 
 573:layer1/l23_api.c **** 	/* reset list in order to prevent race condition */
 574:layer1/l23_api.c **** 	l1s.neigh_pm.n = 0; /* atomic */
 575:layer1/l23_api.c **** 	l1s.neigh_pm.second = 0;
 576:layer1/l23_api.c **** 	/* now reset pointer and fill list */
 577:layer1/l23_api.c **** 	l1s.neigh_pm.pos = 0;
 578:layer1/l23_api.c **** 	l1s.neigh_pm.running = 0;
 579:layer1/l23_api.c **** 	for (i = 0; i < pm_req->n; i++) {
 580:layer1/l23_api.c **** 		l1s.neigh_pm.band_arfcn[i] = ntohs(pm_req->band_arfcn[i]);
 581:layer1/l23_api.c **** 		l1s.neigh_pm.tn[i] = pm_req->tn[i];
 582:layer1/l23_api.c **** 	}
 583:layer1/l23_api.c **** 	printf("L1CTL_NEIGH_PM_REQ new list with %u entries\n", pm_req->n);
 584:layer1/l23_api.c **** 	l1s.neigh_pm.n = pm_req->n; /* atomic */
 585:layer1/l23_api.c **** 
 586:layer1/l23_api.c **** 	/* on C0 enable PM on frame 51 */
 587:layer1/l23_api.c **** 	if (l1s.dedicated.type == GSM_DCHAN_NONE)
 588:layer1/l23_api.c **** 		mframe_enable(MF_TASK_NEIGH_PM51_C0T0);
 589:layer1/l23_api.c **** }
 590:layer1/l23_api.c **** 
 591:layer1/l23_api.c **** /* receive a L1CTL_TRAFFIC_REQ from L23 */
 592:layer1/l23_api.c **** static void l1ctl_rx_traffic_req(struct msgb *msg)
 593:layer1/l23_api.c **** {
 594:layer1/l23_api.c **** 	struct l1ctl_hdr *l1h = (struct l1ctl_hdr *) msg->data;
 595:layer1/l23_api.c **** 	struct l1ctl_info_ul *ul = (struct l1ctl_info_ul *) l1h->data;
 596:layer1/l23_api.c **** 	struct l1ctl_traffic_req *tr = (struct l1ctl_traffic_req *) ul->payload;
 597:layer1/l23_api.c **** 	int num = 0;
 598:layer1/l23_api.c **** 
 599:layer1/l23_api.c **** 	/* printd("L1CTL_TRAFFIC_REQ\n"); */ /* Very verbose, can overwhelm serial */
 600:layer1/l23_api.c **** 
 601:layer1/l23_api.c **** 	msg->l2h = tr->data;
 602:layer1/l23_api.c **** 
 603:layer1/l23_api.c **** 	num = l1a_txq_msgb_count(&l1s.tx_queue[L1S_CHAN_TRAFFIC]);
 604:layer1/l23_api.c **** 	if (num >= 4) {
 605:layer1/l23_api.c **** 		printd("dropping traffic frame\n");
 606:layer1/l23_api.c **** 		msgb_free(msg);
 607:layer1/l23_api.c **** 		return;
 608:layer1/l23_api.c **** 	}
 609:layer1/l23_api.c **** 
 610:layer1/l23_api.c **** 	l1a_txq_msgb_enq(&l1s.tx_queue[L1S_CHAN_TRAFFIC], msg);
 611:layer1/l23_api.c **** }
 612:layer1/l23_api.c **** 
 613:layer1/l23_api.c **** static void l1ctl_sim_req(struct msgb *msg)
 614:layer1/l23_api.c **** {
 615:layer1/l23_api.c **** 	uint16_t len = msg->len - sizeof(struct l1ctl_hdr);
 616:layer1/l23_api.c **** 	uint8_t *data = msg->data + sizeof(struct l1ctl_hdr);
 617:layer1/l23_api.c **** 
 618:layer1/l23_api.c **** #if 1 /* for debugging only */
 619:layer1/l23_api.c **** 	{
 620:layer1/l23_api.c **** 		int i;
 621:layer1/l23_api.c **** 		printf("SIM Request (%u): ", len);
 622:layer1/l23_api.c **** 		for (i = 0; i < len; i++)
 623:layer1/l23_api.c **** 			printf("%02x ", data[i]);
 624:layer1/l23_api.c **** 		puts("\n");
 625:layer1/l23_api.c **** 	}
 626:layer1/l23_api.c **** #endif
 627:layer1/l23_api.c **** 
 628:layer1/l23_api.c ****    sim_apdu(len, data);
 629:layer1/l23_api.c **** }
