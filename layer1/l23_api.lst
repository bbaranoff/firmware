  48:layer1/l23_api.c **** /* the size we will allocate struct msgb* for HDLC */
  49:layer1/l23_api.c **** #define L3_MSG_HEAD 4
  50:layer1/l23_api.c **** #define L3_MSG_DATA 200
  51:layer1/l23_api.c **** #define L3_MSG_SIZE (L3_MSG_HEAD + sizeof(struct l1ctl_hdr) + L3_MSG_DATA)
  52:layer1/l23_api.c **** 
  53:layer1/l23_api.c **** void (*l1a_l23_tx_cb)(struct msgb *msg) = NULL;
  54:layer1/l23_api.c **** 
  55:layer1/l23_api.c **** void l1_queue_for_l2(struct msgb *msg)
  56:layer1/l23_api.c **** {
  57:layer1/l23_api.c **** 	if (l1a_l23_tx_cb) {
  58:layer1/l23_api.c **** 		l1a_l23_tx_cb(msg);
  59:layer1/l23_api.c **** 		return;
  60:layer1/l23_api.c **** 	}
  61:layer1/l23_api.c **** 	/* forward via serial for now */
  62:layer1/l23_api.c **** 	sercomm_sendmsg(SC_DLCI_L1A_L23, msg);
  63:layer1/l23_api.c **** }
  64:layer1/l23_api.c **** 
  65:layer1/l23_api.c **** enum mf_type {
  66:layer1/l23_api.c **** 	MFNONE,
  67:layer1/l23_api.c **** 	MF51,
  68:layer1/l23_api.c **** 	MF26ODD,
  69:layer1/l23_api.c **** 	MF26EVEN
  70:layer1/l23_api.c **** };
  71:layer1/l23_api.c **** static uint32_t chan_nr2mf_task_mask(uint8_t chan_nr, uint8_t neigh_mode)
  72:layer1/l23_api.c **** {
  73:layer1/l23_api.c **** 	uint8_t cbits = chan_nr >> 3;
  74:layer1/l23_api.c **** 	uint8_t tn = chan_nr & 0x7;
  75:layer1/l23_api.c **** 	uint8_t lch_idx;
  76:layer1/l23_api.c **** 	enum mf_type multiframe = 0;
  77:layer1/l23_api.c **** 	uint32_t task_mask = 0x00;
  78:layer1/l23_api.c **** 
  79:layer1/l23_api.c **** #define TASK_SET(task) \
  80:layer1/l23_api.c **** 	task_mask |= (1 << (task))
  81:layer1/l23_api.c **** 
  82:layer1/l23_api.c **** 	if (cbits == 0x01) {
  83:layer1/l23_api.c **** 		lch_idx = 0;
  84:layer1/l23_api.c **** 		TASK_SET((tn & 1) ? MF_TASK_TCH_F_ODD : MF_TASK_TCH_F_EVEN);
  85:layer1/l23_api.c **** 		multiframe = (tn & 1) ? MF26ODD : MF26EVEN;
  86:layer1/l23_api.c **** 	} else if ((cbits & 0x1e) == 0x02) {
  87:layer1/l23_api.c **** 		lch_idx = cbits & 0x1;
  88:layer1/l23_api.c **** 		TASK_SET(MF_TASK_TCH_H_0 + lch_idx);
  89:layer1/l23_api.c **** 		multiframe = (lch_idx & 1) ? MF26ODD : MF26EVEN;
  90:layer1/l23_api.c **** 	} else if ((cbits & 0x1c) == 0x04) {
  91:layer1/l23_api.c **** 		lch_idx = cbits & 0x3;
  92:layer1/l23_api.c **** 		TASK_SET(MF_TASK_SDCCH4_0 + lch_idx);
  93:layer1/l23_api.c **** 		multiframe = MF51;
  94:layer1/l23_api.c **** 	} else if ((cbits & 0x18) == 0x08) {
  95:layer1/l23_api.c **** 		lch_idx = cbits & 0x7;
  96:layer1/l23_api.c **** 		TASK_SET(MF_TASK_SDCCH8_0 + lch_idx);
  97:layer1/l23_api.c **** 		multiframe = MF51;
  98:layer1/l23_api.c **** 	} else if ((cbits & 0x1f) == 0x18) {
  99:layer1/l23_api.c **** 		/* Osmocom specific extension for PDTCH and PTCCH */
 100:layer1/l23_api.c **** 		TASK_SET(MF_TASK_GPRS_PDTCH);
 101:layer1/l23_api.c **** 		TASK_SET(MF_TASK_GPRS_PTCCH);
 102:layer1/l23_api.c **** 		/* FIXME: PDCH has different multiframe structure */
 103:layer1/l23_api.c **** 		multiframe = MFNONE;
 104:layer1/l23_api.c **** 	} else if ((cbits & 0x1f) == 0x19) {
 105:layer1/l23_api.c **** 		/* Osmocom specific extension for CBCH on SDCCH/4 */
 106:layer1/l23_api.c **** 		TASK_SET(MF_TASK_SDCCH4_CBCH);
 107:layer1/l23_api.c **** 		multiframe = MF51;
 108:layer1/l23_api.c **** 	} else if ((cbits & 0x1f) == 0x1a) {
 109:layer1/l23_api.c **** 		/* Osmocom specific extension for CBCH on SDCCH/8 */
 110:layer1/l23_api.c **** 		TASK_SET(MF_TASK_SDCCH8_CBCH);
 111:layer1/l23_api.c **** 		multiframe = MF51;
 112:layer1/l23_api.c **** #if 0
 113:layer1/l23_api.c **** 	} else if (cbits == 0x10) {
 114:layer1/l23_api.c **** 		/* FIXME: when to do extended BCCH? */
 115:layer1/l23_api.c **** 		TASK_SET(MF_TASK_BCCH_NORM);
 116:layer1/l23_api.c **** 	} else if (cbits == 0x11 || cbits == 0x12) {
 117:layer1/l23_api.c **** 		/* FIXME: how to decide CCCH norm/extd? */
 118:layer1/l23_api.c **** 		TASK_SET(MF_TASK_BCCH_CCCH);
 119:layer1/l23_api.c **** #endif
 120:layer1/l23_api.c **** 	} else {
 121:layer1/l23_api.c **** 		TASK_SET(MF_TASK_BCCH_NORM);
 122:layer1/l23_api.c **** 	}
 123:layer1/l23_api.c **** 
 124:layer1/l23_api.c **** 	switch (neigh_mode) {
 125:layer1/l23_api.c **** 	case NEIGH_MODE_PM:
 126:layer1/l23_api.c **** 		switch (multiframe) {
 127:layer1/l23_api.c **** 		case MF51:
 128:layer1/l23_api.c **** 			TASK_SET(MF_TASK_NEIGH_PM51);
 129:layer1/l23_api.c **** 			break;
 130:layer1/l23_api.c **** 		case MF26EVEN:
 131:layer1/l23_api.c **** 			TASK_SET(MF_TASK_NEIGH_PM26E);
 132:layer1/l23_api.c **** 			break;
 133:layer1/l23_api.c **** 		case MF26ODD:
 134:layer1/l23_api.c **** 			TASK_SET(MF_TASK_NEIGH_PM26O);
 135:layer1/l23_api.c **** 			break;
 136:layer1/l23_api.c **** 		default:
 137:layer1/l23_api.c **** 			/* no neighbor measurement */
 138:layer1/l23_api.c **** 			break;
 139:layer1/l23_api.c **** 		}
 140:layer1/l23_api.c **** 		break;
 141:layer1/l23_api.c **** 	}
 142:layer1/l23_api.c **** 
 143:layer1/l23_api.c **** #undef TASK_SET
 144:layer1/l23_api.c **** 
 145:layer1/l23_api.c **** 	return task_mask;
 146:layer1/l23_api.c **** }
 147:layer1/l23_api.c **** 
 148:layer1/l23_api.c **** static int  chan_nr2dchan_type(uint8_t chan_nr)
 149:layer1/l23_api.c **** {
 150:layer1/l23_api.c **** 	uint8_t cbits = chan_nr >> 3;
 151:layer1/l23_api.c **** 
 152:layer1/l23_api.c **** 	if (cbits == 0x01) {
 153:layer1/l23_api.c **** 		return GSM_DCHAN_TCH_F;
 154:layer1/l23_api.c **** 	} else if ((cbits & 0x1e) == 0x02) {
 155:layer1/l23_api.c **** 		return GSM_DCHAN_TCH_H;
 156:layer1/l23_api.c **** 	} else if ((cbits & 0x1c) == 0x04) {
 157:layer1/l23_api.c **** 		return GSM_DCHAN_SDCCH_4;
 158:layer1/l23_api.c **** 	} else if ((cbits & 0x18) == 0x08) {
 159:layer1/l23_api.c **** 		return GSM_DCHAN_SDCCH_8;
 160:layer1/l23_api.c **** 	} else if ((cbits & 0x1f) == 0x18) {
 161:layer1/l23_api.c **** 		/* Osmocom-specific extension for PDCH */
 162:layer1/l23_api.c **** 		return GSM_DCHAN_PDCH;
 163:layer1/l23_api.c **** 	} else if ((cbits & 0x1f) == 0x19) {
 164:layer1/l23_api.c **** 		/* Osmocom-specific extension for CBCH on SDCCH/4 */
 165:layer1/l23_api.c **** 		return GSM_DCHAN_SDCCH_4_CBCH;
 166:layer1/l23_api.c **** 	} else if ((cbits & 0x1f) == 0x1a) {
 167:layer1/l23_api.c **** 		/* Osmocom-specific extension for CBCH on SDCCH/8 */
 168:layer1/l23_api.c **** 		return GSM_DCHAN_SDCCH_8_CBCH;
 169:layer1/l23_api.c **** 	}
 170:layer1/l23_api.c **** 
 171:layer1/l23_api.c **** 	return GSM_DCHAN_UNKNOWN;
 172:layer1/l23_api.c **** }
 173:layer1/l23_api.c **** 
 174:layer1/l23_api.c **** static int chan_nr_is_tch(uint8_t chan_nr)
 175:layer1/l23_api.c **** {
 176:layer1/l23_api.c **** 	return ((chan_nr >> 3) == 0x01 ||		/* TCH/F */
 177:layer1/l23_api.c **** 		((chan_nr >> 3) & 0x1e) == 0x02);	/* TCH/H */
 178:layer1/l23_api.c **** }
