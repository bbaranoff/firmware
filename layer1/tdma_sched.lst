 141:layer1/tdma_sched.c **** /* Sort a bucket entries by priority */
 142:layer1/tdma_sched.c **** static void _tdma_sched_bucket_sort(struct tdma_sched_bucket *bucket, int *seq)
 143:layer1/tdma_sched.c **** {
 144:layer1/tdma_sched.c **** 	int i, j, k;
 145:layer1/tdma_sched.c **** 	struct tdma_sched_item *item_i, *item_j;
 146:layer1/tdma_sched.c **** 
 147:layer1/tdma_sched.c **** 	/* initial sequence */
 148:layer1/tdma_sched.c **** 		/* we need all the items because some call back may schedule
 149:layer1/tdma_sched.c **** 		 * new call backs 'on the fly' */
 150:layer1/tdma_sched.c **** 	for (i=0; i<TDMASCHED_NUM_CB; i++)
 151:layer1/tdma_sched.c **** 		seq[i] = i;
 152:layer1/tdma_sched.c **** 
 153:layer1/tdma_sched.c **** 	/* iterate over items in this bucket and sort them */
 154:layer1/tdma_sched.c **** 	for (i=0; i<bucket->num_items; i++)
 155:layer1/tdma_sched.c **** 	{
 156:layer1/tdma_sched.c **** 		item_i = &bucket->item[seq[i]];
 157:layer1/tdma_sched.c **** 
 158:layer1/tdma_sched.c **** 		for (j=i+1; j<bucket->num_items; j++)
 159:layer1/tdma_sched.c **** 		{
 160:layer1/tdma_sched.c **** 			item_j = &bucket->item[seq[j]];
 161:layer1/tdma_sched.c **** 
 162:layer1/tdma_sched.c **** 			if (item_i->prio > item_j->prio)
 163:layer1/tdma_sched.c **** 			{
 164:layer1/tdma_sched.c **** 				item_i = item_j;
 165:layer1/tdma_sched.c **** 				k      = seq[i];
 166:layer1/tdma_sched.c **** 				seq[i] = seq[j];
 167:layer1/tdma_sched.c **** 				seq[j] = k;
 168:layer1/tdma_sched.c **** 			}
 169:layer1/tdma_sched.c **** 		}
 170:layer1/tdma_sched.c **** 	}
 171:layer1/tdma_sched.c **** }
