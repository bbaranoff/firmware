  25:layer1/rfch.c **** 
  26:layer1/rfch.c **** /*
  27:layer1/rfch.c ****  * Hopping sequence generation
  28:layer1/rfch.c ****  *
  29:layer1/rfch.c ****  * The algorithm is explained in GSM 05.02 Section 6.2.3
  30:layer1/rfch.c ****  *
  31:layer1/rfch.c ****  *	if HSN = 0 (cyclic hopping) then:
  32:layer1/rfch.c ****  *		MAI, integer (0 .. N-1) :
  33:layer1/rfch.c ****  *			MAI = (FN + MAIO) modulo N
  34:layer1/rfch.c ****  *
  35:layer1/rfch.c ****  *	else:
  36:layer1/rfch.c ****  *		M, integer (0 .. 152) :
  37:layer1/rfch.c ****  *			M = T2 + RNTABLE((HSN xor T1R) + T3)
  38:layer1/rfch.c ****  *
  39:layer1/rfch.c ****  *		S, integer (0 .. N-1) :
  40:layer1/rfch.c ****  *			M' = M modulo (2 ^ NBIN)
  41:layer1/rfch.c ****  *			T' = T3 modulo (2 ^ NBIN)
  42:layer1/rfch.c ****  *
  43:layer1/rfch.c ****  *			if M' < N then:
  44:layer1/rfch.c ****  *				S = M'
  45:layer1/rfch.c ****  *			else:
  46:layer1/rfch.c ****  *				S = (M'+T') modulo N
  47:layer1/rfch.c ****  *
  48:layer1/rfch.c ****  *		MAI, integer (0 .. N-1) :
  49:layer1/rfch.c ****  *			MAI = (S + MAIO) modulo N
  50:layer1/rfch.c ****  */
  51:layer1/rfch.c **** 
  52:layer1/rfch.c **** static uint8_t rn_table[114] = {
  53:layer1/rfch.c **** 	 48,  98,  63,   1,  36,  95,  78, 102,  94,  73,
  54:layer1/rfch.c **** 	  0,  64,  25,  81,  76,  59, 124,  23, 104, 100,
  55:layer1/rfch.c **** 	101,  47, 118,  85,  18,  56,  96,  86,  54,   2,
  56:layer1/rfch.c **** 	 80,  34, 127,  13,   6,  89,  57, 103,  12,  74,
  57:layer1/rfch.c **** 	 55, 111,  75,  38, 109,  71, 112,  29,  11,  88,
  58:layer1/rfch.c **** 	 87,  19,   3,  68, 110,  26,  33,  31,   8,  45,
  59:layer1/rfch.c **** 	 82,  58,  40, 107,  32,   5, 106,  92,  62,  67,
  60:layer1/rfch.c **** 	 77, 108, 122,  37,  60,  66, 121,  42,  51, 126,
  61:layer1/rfch.c **** 	117, 114,   4,  90,  43,  52,  53, 113, 120,  72,
  62:layer1/rfch.c **** 	 16,  49,   7,  79, 119,  61,  22,  84,   9,  97,
  63:layer1/rfch.c **** 	 91,  15,  21,  24,  46,  39,  93, 105,  65,  70,
  64:layer1/rfch.c **** 	125,  99,  17, 123,
  65:layer1/rfch.c **** };
  66:layer1/rfch.c **** 
  67:layer1/rfch.c **** 
  68:layer1/rfch.c **** static int pow_nbin_mask(int n)
  69:layer1/rfch.c **** {
  70:layer1/rfch.c **** 	int x;
  71:layer1/rfch.c **** 	x =	(n     ) |
  72:layer1/rfch.c **** 		(n >> 1) |
  73:layer1/rfch.c **** 		(n >> 2) |
  74:layer1/rfch.c **** 		(n >> 3) |
  75:layer1/rfch.c **** 		(n >> 4) |
  76:layer1/rfch.c **** 		(n >> 5) |
  77:layer1/rfch.c **** 		(n >> 6);
  78:layer1/rfch.c **** 	return x;
  79:layer1/rfch.c **** }
  80:layer1/rfch.c **** 
  81:layer1/rfch.c **** /*! Hopping sequence generator.
  82:layer1/rfch.c ****  * \param[in] t GSM time (frame number)
  83:layer1/rfch.c ****  * \param[in] hsn Hopping Sequence Number
  84:layer1/rfch.c ****  * \param[in] maio Mobile Allocation Index OFfset
  85:layer1/rfch.c ****  * \param[in] n number of entries in mobile allocation (arfcn table)
  86:layer1/rfch.c ****  * \param[in] arfcn_tbl Array of ARFCN representing the mobile allocation
  87:layer1/rfch.c ****  * \returns ARFCN to use for given input parameters at time 't' or MAI if arfcn_tbl == NULL */
  88:layer1/rfch.c **** static int16_t rfch_hop_seq_gen(const struct gsm_time *t,
  89:layer1/rfch.c ****                                 uint8_t hsn, uint8_t maio,
  90:layer1/rfch.c ****                                 uint8_t n, const uint16_t *arfcn_tbl)
  91:layer1/rfch.c **** {
  92:layer1/rfch.c **** 	int mai;
  93:layer1/rfch.c **** 
  94:layer1/rfch.c **** 	if (!hsn) {
  95:layer1/rfch.c **** 		/* cyclic hopping */
  96:layer1/rfch.c **** 		mai = (t->fn + maio) % n;
  97:layer1/rfch.c **** 	} else {
  98:layer1/rfch.c **** 		/* pseudo random hopping */
  99:layer1/rfch.c **** 		int m, mp, tp, s, pnm;
 100:layer1/rfch.c **** 
 101:layer1/rfch.c **** 		pnm = pow_nbin_mask(n);
 102:layer1/rfch.c **** 
 103:layer1/rfch.c **** 		m = t->t2 + rn_table[(hsn ^ (t->t1 & 63)) + t->t3];
 104:layer1/rfch.c **** 		mp = m & pnm;
 105:layer1/rfch.c **** 
 106:layer1/rfch.c **** 		if (mp < n)
 107:layer1/rfch.c **** 			s = mp;
 108:layer1/rfch.c **** 		else {
 109:layer1/rfch.c **** 			tp = t->t3 & pnm;
 110:layer1/rfch.c **** 			s = (mp + tp) % n;
 111:layer1/rfch.c **** 		}
 112:layer1/rfch.c **** 
 113:layer1/rfch.c **** 		mai = (s + maio) % n;
 114:layer1/rfch.c **** 	}
 115:layer1/rfch.c **** 
 116:layer1/rfch.c **** 	return arfcn_tbl ? arfcn_tbl[mai] : mai;
 117:layer1/rfch.c **** }
 118:layer1/rfch.c **** 
