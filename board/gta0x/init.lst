  46:board/gta0x/init.c **** #define ARMIO_LATCH_OUT 0xfffe4802
  47:board/gta0x/init.c **** #define IO_CNTL_REG	0xfffe4804
  48:board/gta0x/init.c **** #define ASIC_CONF_REG	0xfffef008
  49:board/gta0x/init.c **** #define IO_CONF_REG	0xfffef00a
  50:board/gta0x/init.c **** 
  51:board/gta0x/init.c **** static void board_io_init(void)
  52:board/gta0x/init.c **** {
  53:board/gta0x/init.c **** 	uint16_t reg;
  54:board/gta0x/init.c **** 
  55:board/gta0x/init.c **** 	reg = readw(ASIC_CONF_REG);
  56:board/gta0x/init.c **** 	/* TWL3025: Set SPI+RIF RX clock to rising edge */
  57:board/gta0x/init.c **** 	reg |= (1 << 13) | (1 << 14);
  58:board/gta0x/init.c **** 	writew(reg, ASIC_CONF_REG);
  59:board/gta0x/init.c **** 
  60:board/gta0x/init.c **** 	/*
  61:board/gta0x/init.c **** 	 * Most Calypso peripheral interface signals are unconnected
  62:board/gta0x/init.c **** 	 * on this modem.  We configure them to be GPIOs in IO_CONF_REG,
  63:board/gta0x/init.c **** 	 * then configure them to be outputs in IO_CNTL_REG, then set
  64:board/gta0x/init.c **** 	 * the outputs to 0 in ARMIO_LATCH_OUT.
  65:board/gta0x/init.c **** 	 */
  66:board/gta0x/init.c **** 	writew(0x03F5, IO_CONF_REG);
  67:board/gta0x/init.c **** 	writew(0xC000, IO_CNTL_REG);
  68:board/gta0x/init.c **** 	writew(0x0000, ARMIO_LATCH_OUT);
  69:board/gta0x/init.c **** }
