 188:board/mediatek/uart.c **** static void uart_irq_handler_cons(__unused int irqnr)
 189:board/mediatek/uart.c **** {
 190:board/mediatek/uart.c **** 	const uint8_t uart = cons_get_uart();
 191:board/mediatek/uart.c **** 	uint8_t iir;
 192:board/mediatek/uart.c **** 
 193:board/mediatek/uart.c **** 	//uart_putchar_nb(uart, 'U');
 194:board/mediatek/uart.c **** 
 195:board/mediatek/uart.c **** 	iir = uart_reg_read(uart, IIR);
 196:board/mediatek/uart.c **** 	if (iir & IIR_INT_PENDING)
 197:board/mediatek/uart.c **** 		return;
 198:board/mediatek/uart.c **** 
 199:board/mediatek/uart.c **** 	switch (iir & IIR_INT_TYPE) {
 200:board/mediatek/uart.c **** 	case IIR_INT_TYPE_RBR:
 201:board/mediatek/uart.c **** 		break;
 202:board/mediatek/uart.c **** 	case IIR_INT_TYPE_THR:
 203:board/mediatek/uart.c **** 		if (cons_rb_flush() == 1) {
 204:board/mediatek/uart.c **** 			/* everything was flushed, disable RBR IRQ */
 205:board/mediatek/uart.c **** 			uint8_t ier = uart_reg_read(uart, IER);
 206:board/mediatek/uart.c **** 			ier &= ~(1 << 1);
 207:board/mediatek/uart.c **** 			uart_reg_write(uart, IER, ier);
 208:board/mediatek/uart.c **** 		}
 209:board/mediatek/uart.c **** 		break;
 210:board/mediatek/uart.c **** 	case IIR_INT_TYPE_MSR:
 211:board/mediatek/uart.c **** 		break;
 212:board/mediatek/uart.c **** 	case IIR_INT_TYPE_RX_STATUS_ERROR:
 213:board/mediatek/uart.c **** 		break;
 214:board/mediatek/uart.c **** 	case IIR_INT_TYPE_RX_TIMEOUT:
 215:board/mediatek/uart.c **** 		break;
 216:board/mediatek/uart.c **** 	case IIR_INT_TYPE_XOFF:
 217:board/mediatek/uart.c **** 		break;
 218:board/mediatek/uart.c **** 	}
 219:board/mediatek/uart.c **** }
 220:board/mediatek/uart.c **** 
 221:board/mediatek/uart.c **** static void uart_irq_handler_sercomm(__unused int irqnr)
 222:board/mediatek/uart.c **** {
 223:board/mediatek/uart.c **** 	const uint8_t uart = sercomm_get_uart();
 224:board/mediatek/uart.c **** 	uint8_t iir, ch;
 225:board/mediatek/uart.c **** 
 226:board/mediatek/uart.c **** 	//uart_putchar_nb(uart, 'U');
 227:board/mediatek/uart.c **** 
 228:board/mediatek/uart.c **** 	iir = uart_reg_read(uart, IIR);
 229:board/mediatek/uart.c **** 	if (iir & IIR_INT_PENDING)
 230:board/mediatek/uart.c **** 		return;
 231:board/mediatek/uart.c **** 
 232:board/mediatek/uart.c **** 	switch (iir & IIR_INT_TYPE) {
 233:board/mediatek/uart.c **** 	case IIR_INT_TYPE_RX_TIMEOUT:
 234:board/mediatek/uart.c **** 	case IIR_INT_TYPE_RBR:
 235:board/mediatek/uart.c **** 		/* as long as we have rx data available */
 236:board/mediatek/uart.c **** 		while (uart_getchar_nb(uart, &ch)) {
 237:board/mediatek/uart.c **** 			if (sercomm_drv_rx_char(ch) < 0) {
 238:board/mediatek/uart.c **** 				/* sercomm cannot receive more data right now */
 239:board/mediatek/uart.c **** 				uart_irq_enable(uart, UART_IRQ_RX_CHAR, 0);
 240:board/mediatek/uart.c **** 			}
 241:board/mediatek/uart.c **** 		}
 242:board/mediatek/uart.c **** 		break;
 243:board/mediatek/uart.c **** 	case IIR_INT_TYPE_THR:
 244:board/mediatek/uart.c **** 		/* as long as we have space in the FIFO */
 245:board/mediatek/uart.c **** 		while (!uart_tx_busy(uart)) {
 246:board/mediatek/uart.c **** 			/* get a byte from sercomm */
 247:board/mediatek/uart.c **** 			if (!sercomm_drv_pull(&ch)) {
 248:board/mediatek/uart.c **** 				/* no more bytes in sercomm, stop TX interrupts */
 249:board/mediatek/uart.c **** 				uart_irq_enable(uart, UART_IRQ_TX_EMPTY, 0);
 250:board/mediatek/uart.c **** 				break;
 251:board/mediatek/uart.c **** 			}
 252:board/mediatek/uart.c **** 			/* write the byte into the TX FIFO */
 253:board/mediatek/uart.c **** 			uart_putchar_nb(uart, ch);
 254:board/mediatek/uart.c **** 		}
 255:board/mediatek/uart.c **** 		break;
 256:board/mediatek/uart.c **** 	case IIR_INT_TYPE_MSR:
 257:board/mediatek/uart.c **** 		printf("UART IRQ MSR\n");
 258:board/mediatek/uart.c **** 		break;
 259:board/mediatek/uart.c **** 	case IIR_INT_TYPE_RX_STATUS_ERROR:
 260:board/mediatek/uart.c **** 		printf("UART IRQ RX_SE\n");
 261:board/mediatek/uart.c **** 		break;
 262:board/mediatek/uart.c **** 	case IIR_INT_TYPE_XOFF:
 263:board/mediatek/uart.c **** 		printf("UART IRQXOFF\n");
 264:board/mediatek/uart.c **** 		break;
 265:board/mediatek/uart.c **** 	}
 266:board/mediatek/uart.c **** }
 267:board/mediatek/uart.c **** 
 268:board/mediatek/uart.c **** void uart_init(uint8_t uart, __unused uint8_t interrupts)
 269:board/mediatek/uart.c **** {
 270:board/mediatek/uart.c **** 	/* no interrupts, only polling so far */
 271:board/mediatek/uart.c **** 
 272:board/mediatek/uart.c **** 	uart_reg_write(uart, IER, 0x00);
 273:board/mediatek/uart.c **** 	if (uart == cons_get_uart()) {
 274:board/mediatek/uart.c **** 		cons_init();
 275:board/mediatek/uart.c **** 	} else if (uart == sercomm_get_uart()) {
 276:board/mediatek/uart.c **** 		sercomm_init();
 277:board/mediatek/uart.c **** 		uart_irq_enable(uart, UART_IRQ_RX_CHAR, 1);
 278:board/mediatek/uart.c **** 	} else {
 279:board/mediatek/uart.c **** 		return;
 280:board/mediatek/uart.c **** 	}
 281:board/mediatek/uart.c **** 
 282:board/mediatek/uart.c **** 	uart_reg_write(uart, AUTOBAUD_EN, 0x00); /* disable AUTOBAUD */
 283:board/mediatek/uart.c **** 	uart_reg_write(uart,   EFR, 0x10); /* Enhanced Features Register */
 284:board/mediatek/uart.c **** 
 285:board/mediatek/uart.c **** 	/* no XON/XOFF flow control, ENHANCED_EN, no auto-RTS/CTS */
 286:board/mediatek/uart.c **** 	uart_reg_write(uart, EFR, (1 << 4));
 287:board/mediatek/uart.c **** 	/* enable Tx/Rx FIFO, Tx trigger at 56 spaces, Rx trigger at 60 chars */
 288:board/mediatek/uart.c **** 	//FIXME check those FIFO settings
 289:board/mediatek/uart.c **** 	uart_reg_write(uart, IIR, FIFO_EN | RX_FIFO_CLEAR | TX_FIFO_CLEAR |
 290:board/mediatek/uart.c **** 			(3 << TX_FIFO_TRIG_SHIFT) | (1 << RX_FIFO_TRIG_SHIFT));
 291:board/mediatek/uart.c **** 
 292:board/mediatek/uart.c **** 	/* RBR interrupt only when TX FIFO and TX shift register are empty */
 293:board/mediatek/uart.c **** 	uart_reg_write(uart, SCR, (1 << 0));// | (1 << 3));
 294:board/mediatek/uart.c **** 
 295:board/mediatek/uart.c **** 	/* 8 bit, 1 stop bit, no parity, no break */
 296:board/mediatek/uart.c **** 	uart_reg_write(uart, LCR, 0x03);
 297:board/mediatek/uart.c **** 
 298:board/mediatek/uart.c **** 	uart_set_lcr7bit(uart, 0);
 299:board/mediatek/uart.c **** }
 300:board/mediatek/uart.c **** 
 301:board/mediatek/uart.c **** void uart_poll(uint8_t uart) {
 302:board/mediatek/uart.c **** 	if(uart == cons_get_uart()) {
 303:board/mediatek/uart.c **** 		uart_irq_handler_cons(0);
 304:board/mediatek/uart.c **** 	} else {
 305:board/mediatek/uart.c **** 		uart_irq_handler_sercomm(0);
 306:board/mediatek/uart.c **** 	}
 307:board/mediatek/uart.c **** }
