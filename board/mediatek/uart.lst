  35:board/mediatek/uart.c **** /* MT622x */
  36:board/mediatek/uart.c **** #if 0
  37:board/mediatek/uart.c **** #define BASE_ADDR_UART1	0x80130000
  38:board/mediatek/uart.c **** #define BASE_ADDR_UART2	0x80180000
  39:board/mediatek/uart.c **** #define BASE_ADDR_UART3	0x801b0000
  40:board/mediatek/uart.c **** #endif
  41:board/mediatek/uart.c **** 
  42:board/mediatek/uart.c **** /* MT 6235 */
  43:board/mediatek/uart.c **** #define BASE_ADDR_UART1	0x81030000
  44:board/mediatek/uart.c **** 
  45:board/mediatek/uart.c **** //TODO make UART2 and 3 work
  46:board/mediatek/uart.c **** #define UART_REG(n,m)	(BASE_ADDR_UART1 + (m))
  47:board/mediatek/uart.c **** 
  48:board/mediatek/uart.c **** #define LCR7BIT		0x80
  49:board/mediatek/uart.c **** #define LCRBFBIT	0x40
  50:board/mediatek/uart.c **** #define MCR6BIT		0x20
  51:board/mediatek/uart.c **** #define REG_OFFS(m)	((m) & ~(LCR7BIT|LCRBFBIT|MCR6BIT))
  52:board/mediatek/uart.c **** /* read access LCR[7] = 0 */
  53:board/mediatek/uart.c **** enum uart_reg {
  54:board/mediatek/uart.c **** 	RBR		= 0x00,
  55:board/mediatek/uart.c **** 	IER		= 0x04,
  56:board/mediatek/uart.c **** 	IIR		= 0x08,
  57:board/mediatek/uart.c **** 	LCR		= 0x0c,
  58:board/mediatek/uart.c **** 	MCR		= 0x10,
  59:board/mediatek/uart.c **** 	LSR		= 0x14,
  60:board/mediatek/uart.c **** 	MSR		= 0x18,
  61:board/mediatek/uart.c **** 	SCR		= 0x1c,
  62:board/mediatek/uart.c **** 	AUTOBAUD_EN	= 0x20,
  63:board/mediatek/uart.c **** 	HIGHSPEED	= 0x24,
  64:board/mediatek/uart.c **** 	SAMPLE_COUNT	= 0x28,
  65:board/mediatek/uart.c **** 	SAMPLE_POINT	= 0x2c,
  66:board/mediatek/uart.c **** 	AUTOBAUD_REG	= 0x30,
  67:board/mediatek/uart.c **** 	RATE_FIX_REG	= 0x34, /* undocumented */
  68:board/mediatek/uart.c **** 	AUTOBAUDSAMPLE	= 0x38,
  69:board/mediatek/uart.c **** 	GUARD		= 0x3c,
  70:board/mediatek/uart.c **** 	ESCAPE_DAT	= 0x40,
  71:board/mediatek/uart.c **** 	ESCAPE_EN	= 0x44,
  72:board/mediatek/uart.c **** 	SLEEP_EN	= 0x48,
  73:board/mediatek/uart.c **** 	VFIFO_EN	= 0x4c,
  74:board/mediatek/uart.c **** /* read access LCR[7] = 1 */
  75:board/mediatek/uart.c **** 	DLL	= RBR,
  76:board/mediatek/uart.c **** 	DLH	= IER,
  77:board/mediatek/uart.c **** /* read/write access LCR[7:0] = 0xbf */
  78:board/mediatek/uart.c **** 	EFR	= IIR | LCRBFBIT,
  79:board/mediatek/uart.c **** 	XON1	= MCR | LCRBFBIT,
  80:board/mediatek/uart.c **** 	XON2	= LSR | LCRBFBIT,
  81:board/mediatek/uart.c **** 	XOFF1	= MSR | LCRBFBIT,
  82:board/mediatek/uart.c **** 	XOFF2 	= SCR | LCRBFBIT,
  83:board/mediatek/uart.c **** };
  84:board/mediatek/uart.c **** 
  85:board/mediatek/uart.c **** enum fcr_bits {
  86:board/mediatek/uart.c **** 	FIFO_EN		= (1 << 0),
  87:board/mediatek/uart.c **** 	RX_FIFO_CLEAR	= (1 << 1),
  88:board/mediatek/uart.c **** 	TX_FIFO_CLEAR	= (1 << 2),
  89:board/mediatek/uart.c **** 	DMA_MODE	= (1 << 3),
  90:board/mediatek/uart.c **** };
  91:board/mediatek/uart.c **** #define TX_FIFO_TRIG_SHIFT	4
  92:board/mediatek/uart.c **** #define RX_FIFO_TRIG_SHIFT	6
  93:board/mediatek/uart.c **** 
  94:board/mediatek/uart.c **** enum iir_bits {
  95:board/mediatek/uart.c **** 	IIR_INT_PENDING			= 0x01,
  96:board/mediatek/uart.c **** 	IIR_INT_TYPE			= 0x3E,
  97:board/mediatek/uart.c **** 	IIR_INT_TYPE_RX_STATUS_ERROR 	= 0x06,
  98:board/mediatek/uart.c **** 	IIR_INT_TYPE_RX_TIMEOUT		= 0x0C,
  99:board/mediatek/uart.c **** 	IIR_INT_TYPE_RBR		= 0x04,
 100:board/mediatek/uart.c **** 	IIR_INT_TYPE_THR		= 0x02,
 101:board/mediatek/uart.c **** 	IIR_INT_TYPE_MSR		= 0x00,
 102:board/mediatek/uart.c **** 	IIR_INT_TYPE_XOFF		= 0x10,
 103:board/mediatek/uart.c **** 	IIR_INT_TYPE_FLOW		= 0x20,
 104:board/mediatek/uart.c **** 	IIR_FCR0_MIRROR			= 0xC0,
 105:board/mediatek/uart.c **** };
