  46:board/gtm900b/init.c **** 
  47:board/gtm900b/init.c **** #define ARMIO_LATCH_OUT 0xfffe4802
  48:board/gtm900b/init.c **** #define IO_CNTL_REG	0xfffe4804
  49:board/gtm900b/init.c **** #define ARM_CONF_REG	0xfffef006
  50:board/gtm900b/init.c **** #define ASIC_CONF_REG	0xfffef008
  51:board/gtm900b/init.c **** #define IO_CONF_REG	0xfffef00a
  52:board/gtm900b/init.c **** #define LPG_LCR_REG	0xfffe7800
  53:board/gtm900b/init.c **** #define LPG_PM_REG	0xfffe7801
  54:board/gtm900b/init.c **** 
  55:board/gtm900b/init.c **** int gtm900_hw_is_mg01gsmt;
  56:board/gtm900b/init.c **** 
  57:board/gtm900b/init.c **** static void board_io_init(void)
  58:board/gtm900b/init.c **** {
  59:board/gtm900b/init.c **** 	uint16_t reg;
  60:board/gtm900b/init.c **** 
  61:board/gtm900b/init.c **** 	reg = readw(ASIC_CONF_REG);
  62:board/gtm900b/init.c **** 	/* Set LPG pin mux for power LED */
  63:board/gtm900b/init.c **** 	reg |= (1 << 6);
  64:board/gtm900b/init.c **** 	/* TWL3025: Set SPI+RIF RX clock to rising edge */
  65:board/gtm900b/init.c **** 	reg |= (1 << 13) | (1 << 14);
  66:board/gtm900b/init.c **** 	writew(reg, ASIC_CONF_REG);
  67:board/gtm900b/init.c **** 
  68:board/gtm900b/init.c **** 	/*
  69:board/gtm900b/init.c **** 	 * Configure Calypso GPIO and multifunction pins the same way
  70:board/gtm900b/init.c **** 	 * how Huawei's official firmware configures them.
  71:board/gtm900b/init.c **** 	 */
  72:board/gtm900b/init.c **** 	writew(0x03F5, IO_CONF_REG);
  73:board/gtm900b/init.c **** 	writew(0xDC58, IO_CNTL_REG);
  74:board/gtm900b/init.c **** 	writew(0x0007, ARMIO_LATCH_OUT);
  75:board/gtm900b/init.c **** 
  76:board/gtm900b/init.c **** 	/* Set LPG output permanently on (power LED) */
  77:board/gtm900b/init.c **** 	writew(1, LPG_PM_REG);
  78:board/gtm900b/init.c **** 	writew((1 << 7), LPG_LCR_REG);
  79:board/gtm900b/init.c **** 
  80:board/gtm900b/init.c **** 	/* configure ADD(22), needed for second half of flash on MG01GSMT */
  81:board/gtm900b/init.c **** 	reg = readw(ARM_CONF_REG);
  82:board/gtm900b/init.c **** 	reg |= (1 << 3);
  83:board/gtm900b/init.c **** 	writew(reg, ARM_CONF_REG);
  84:board/gtm900b/init.c **** }
  85:board/gtm900b/init.c **** 
  86:board/gtm900b/init.c **** /*
  87:board/gtm900b/init.c ****  * There exist two firmware-incompatible versions of GTM900-B hardware:
  88:board/gtm900b/init.c ****  * MG01GSMT and MGCxGSMT.  They have different flash chip types (8 MiB
  89:board/gtm900b/init.c ****  * vs. 4 MiB) with correspondingly different TIFFS configurations
  90:board/gtm900b/init.c ****  * (and we need TIFFS in order to read factory RF calibration values),
  91:board/gtm900b/init.c ****  * and they have different (incompatible) RFFE control signals.
  92:board/gtm900b/init.c ****  *
  93:board/gtm900b/init.c ****  * We are going to check the flash chip type and use it to decide which
  94:board/gtm900b/init.c ****  * hw variant we are running on.
  95:board/gtm900b/init.c ****  */
  96:board/gtm900b/init.c **** static void board_flash_init(void)
  97:board/gtm900b/init.c **** {
  98:board/gtm900b/init.c **** 	uint16_t manufacturer_id, device_id[3];
  99:board/gtm900b/init.c **** 
 100:board/gtm900b/init.c **** 	/* Use an address above the Calypso boot ROM
 101:board/gtm900b/init.c **** 	 * so we don't need to unmap it to access the flash. */
 102:board/gtm900b/init.c **** 	flash_get_id((void *)0x40000, &manufacturer_id, device_id);
 103:board/gtm900b/init.c **** 
 104:board/gtm900b/init.c **** 	switch (manufacturer_id) {
 105:board/gtm900b/init.c **** 	case CFI_MANUF_SPANSION:
 106:board/gtm900b/init.c **** 		/* is it S71PL064J? */
 107:board/gtm900b/init.c **** 		if (device_id[0] == 0x227E && device_id[1] == 0x2202 &&
 108:board/gtm900b/init.c **** 		    device_id[2] == 0x2201) {
 109:board/gtm900b/init.c **** 			gtm900_hw_is_mg01gsmt = 1;
 110:board/gtm900b/init.c **** 			break;
 111:board/gtm900b/init.c **** 		}
 112:board/gtm900b/init.c **** 		/* is it S71PL032J? */
 113:board/gtm900b/init.c **** 		if (device_id[0] == 0x227E && device_id[1] == 0x220A &&
 114:board/gtm900b/init.c **** 		    device_id[2] == 0x2201) {
 115:board/gtm900b/init.c **** 			gtm900_hw_is_mg01gsmt = 0;
 116:board/gtm900b/init.c **** 			break;
 117:board/gtm900b/init.c **** 		}
 118:board/gtm900b/init.c **** 		goto bad;
 119:board/gtm900b/init.c **** 	case CFI_MANUF_SAMSUNG:
 120:board/gtm900b/init.c **** 		/* is it K5A3281CTM? */
 121:board/gtm900b/init.c **** 		if (device_id[0] == 0x22A0) {
 122:board/gtm900b/init.c **** 			gtm900_hw_is_mg01gsmt = 0;
 123:board/gtm900b/init.c **** 			break;
 124:board/gtm900b/init.c **** 		}
 125:board/gtm900b/init.c **** 		/* is it K5L3316CAM? */
 126:board/gtm900b/init.c **** 		if (device_id[0] == 0x257E && device_id[1] == 0x2503 &&
 127:board/gtm900b/init.c **** 		    device_id[2] == 0x2501) {
 128:board/gtm900b/init.c **** 			gtm900_hw_is_mg01gsmt = 0;
 129:board/gtm900b/init.c **** 			break;
 130:board/gtm900b/init.c **** 		}
 131:board/gtm900b/init.c **** 		/* FALL THRU */
 132:board/gtm900b/init.c **** 	default:
 133:board/gtm900b/init.c **** 	bad:
 134:board/gtm900b/init.c **** 		printf("Unknown module detected, "
 135:board/gtm900b/init.c **** 		       "flash ID 0x%04x 0x%04x 0x%04x 0x%04x\n"
 136:board/gtm900b/init.c **** 		       "Please contact mailing list!\n\n", manufacturer_id,
 137:board/gtm900b/init.c **** 		       device_id[0], device_id[1], device_id[2]);
 138:board/gtm900b/init.c **** 		return;
 139:board/gtm900b/init.c **** 	}
 140:board/gtm900b/init.c **** 
 141:board/gtm900b/init.c **** 	/* Initialize TIFFS reader */
 142:board/gtm900b/init.c **** 	if (gtm900_hw_is_mg01gsmt)
 143:board/gtm900b/init.c **** 		tiffs_init(0x700000, 0x10000, 15);
 144:board/gtm900b/init.c **** 	else
 145:board/gtm900b/init.c **** 		tiffs_init(0x380000, 0x10000, 7);
 146:board/gtm900b/init.c **** }
