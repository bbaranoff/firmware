  16:board/tr800/rffe_leo_quadband.c **** 
  17:board/tr800/rffe_leo_quadband.c **** /*
  18:board/tr800/rffe_leo_quadband.c ****  * This module implements RFFE control for TI's original Leonardo+
  19:board/tr800/rffe_leo_quadband.c ****  * quadband RFFE, depicted on page 4 of this 2011-find schematic drawing:
  20:board/tr800/rffe_leo_quadband.c ****  *
  21:board/tr800/rffe_leo_quadband.c ****  * https://www.freecalypso.org/pub/GSM/Calypso/Leonardo_plus_quadband_schem.pdf
  22:board/tr800/rffe_leo_quadband.c ****  *
  23:board/tr800/rffe_leo_quadband.c ****  * This TI-original quadband RFFE is reproduced verbatim on the TR-800
  24:board/tr800/rffe_leo_quadband.c ****  * packaged module by iWOW.
  25:board/tr800/rffe_leo_quadband.c ****  *
  26:board/tr800/rffe_leo_quadband.c ****  * The present C code is based on ../gta0x/rffe_gta0x_triband.c,
  27:board/tr800/rffe_leo_quadband.c ****  * controlling Openmoko's triband RFFE which is very closely based on
  28:board/tr800/rffe_leo_quadband.c ****  * Leonardo, with only a few control signal permutations.
  29:board/tr800/rffe_leo_quadband.c ****  *
  30:board/tr800/rffe_leo_quadband.c ****  * The present code addition by Mother Mychaela merely brings the TR-800 hw
  31:board/tr800/rffe_leo_quadband.c ****  * target to the same level of support that already existed in OBB since
  32:board/tr800/rffe_leo_quadband.c ****  * forever for Compal/Motorola and Openmoko GTA01/02 targets, and more
  33:board/tr800/rffe_leo_quadband.c ****  * recently GTM900 and FCDEV3B - it does NOT fix the problem of overly
  34:board/tr800/rffe_leo_quadband.c ****  * simplistic RFFE control timing and other oversimplifications which OBB
  35:board/tr800/rffe_leo_quadband.c ****  * exhibits in comparison to the official firmware maintained by the
  36:board/tr800/rffe_leo_quadband.c ****  * custodians of the Calypso+Iota+RF chipset (formerly TI, now FreeCalypso).
  37:board/tr800/rffe_leo_quadband.c ****  * These massive oversimplifications which OBB exhibits in comparison to
  38:board/tr800/rffe_leo_quadband.c ****  * officially approved production firmwares result in OBB's radio transmissions
  39:board/tr800/rffe_leo_quadband.c ****  * being SEVERELY out of compliance (as observed with even the simplest tests
  40:board/tr800/rffe_leo_quadband.c ****  * with a CMU200 RF test instrument), thus anyone who runs the present code
  41:board/tr800/rffe_leo_quadband.c ****  * with Tx enabled outside of a Faraday cage will very likely cause
  42:board/tr800/rffe_leo_quadband.c ****  * interference and disruption to public communication networks!  Furthermore,
  43:board/tr800/rffe_leo_quadband.c ****  * if you go on with running OBB with Tx enabled after having read this
  44:board/tr800/rffe_leo_quadband.c ****  * warning, the resulting interference and disruption to public communication
  45:board/tr800/rffe_leo_quadband.c ****  * networks can be considered intentional on your part, which is likely to be
  46:board/tr800/rffe_leo_quadband.c ****  * seen as a more severe offense.
  47:board/tr800/rffe_leo_quadband.c ****  */
  48:board/tr800/rffe_leo_quadband.c **** 
  49:board/tr800/rffe_leo_quadband.c **** #include <stdint.h>
  50:board/tr800/rffe_leo_quadband.c **** #include <stdio.h>
  51:board/tr800/rffe_leo_quadband.c **** 
  52:board/tr800/rffe_leo_quadband.c **** #include <debug.h>
  53:board/tr800/rffe_leo_quadband.c **** #include <memory.h>
  54:board/tr800/rffe_leo_quadband.c **** #include <rffe.h>
  55:board/tr800/rffe_leo_quadband.c **** #include <calypso/tsp.h>
  56:board/tr800/rffe_leo_quadband.c **** #include <rf/trf6151.h>
  57:board/tr800/rffe_leo_quadband.c **** 
  58:board/tr800/rffe_leo_quadband.c **** /*
  59:board/tr800/rffe_leo_quadband.c ****  * OsmocomBB's definition of system inherent gain is similar to what is
  60:board/tr800/rffe_leo_quadband.c ****  * called "magic gain" (GMagic) in TI's architecture, except that TI's
  61:board/tr800/rffe_leo_quadband.c ****  * GMagic includes TRF6151 LNA gain whereas OBB's definition of system
  62:board/tr800/rffe_leo_quadband.c ****  * inherent gain does not.  TI's GMagic is also reckoned in half-dB units
  63:board/tr800/rffe_leo_quadband.c ****  * instead of integral dB.
  64:board/tr800/rffe_leo_quadband.c ****  *
  65:board/tr800/rffe_leo_quadband.c ****  * The canonical GMagic number for Leonardo/TR-800 RFFE is 200, both in
  66:board/tr800/rffe_leo_quadband.c ****  * iWOW's original calibration and as confirmed with CMU200 measurements
  67:board/tr800/rffe_leo_quadband.c ****  * at FreeCalypso HQ.  GMagic=200 in TI's universe is equivalent to
  68:board/tr800/rffe_leo_quadband.c ****  * OsmocomBB's "system inherent gain" of 73 dB.
  69:board/tr800/rffe_leo_quadband.c ****  */
  70:board/tr800/rffe_leo_quadband.c **** #define SYSTEM_INHERENT_GAIN	73
  71:board/tr800/rffe_leo_quadband.c **** 
  72:board/tr800/rffe_leo_quadband.c **** /* describe how the RF frontend is wired on Leonardo and TR-800 */
  73:board/tr800/rffe_leo_quadband.c **** 
  74:board/tr800/rffe_leo_quadband.c **** #define		RITA_RESET	TSPACT(0)	/* Reset of the Rita TRF6151 */
  75:board/tr800/rffe_leo_quadband.c **** #define		PA_ENABLE	TSPACT(9)	/* Enable the Power Amplifier */
  76:board/tr800/rffe_leo_quadband.c **** #define		PA_BAND_SEL	TSPACT(3)	/* PA band select, 1=DCS/PCS */
  77:board/tr800/rffe_leo_quadband.c **** 
  78:board/tr800/rffe_leo_quadband.c **** /* All FEM controls are low-active */
  79:board/tr800/rffe_leo_quadband.c **** #define		FEM_7		TSPACT(2)	/* FEM pin 7 */
  80:board/tr800/rffe_leo_quadband.c **** #define		FEM_8		TSPACT(1)	/* FEM pin 8 */
  81:board/tr800/rffe_leo_quadband.c **** #define		FEM_9		TSPACT(4)	/* FEM pin 9 */
  82:board/tr800/rffe_leo_quadband.c **** 
  83:board/tr800/rffe_leo_quadband.c **** #define		IOTA_STROBE	TSPEN(0)	/* Strobe for the Iota TSP */
  84:board/tr800/rffe_leo_quadband.c **** #define		RITA_STROBE	TSPEN(2)	/* Strobe for the Rita TSP */
  85:board/tr800/rffe_leo_quadband.c **** 
