  44:board/tr800/init.c **** 
  45:board/tr800/init.c **** #define ARMIO_LATCH_OUT 0xfffe4802
  46:board/tr800/init.c **** #define IO_CNTL_REG	0xfffe4804
  47:board/tr800/init.c **** #define ARM_CONF_REG	0xfffef006
  48:board/tr800/init.c **** #define ASIC_CONF_REG	0xfffef008
  49:board/tr800/init.c **** #define IO_CONF_REG	0xfffef00a
  50:board/tr800/init.c **** 
  51:board/tr800/init.c **** static void board_io_init(void)
  52:board/tr800/init.c **** {
  53:board/tr800/init.c **** 	uint16_t reg;
  54:board/tr800/init.c **** 
  55:board/tr800/init.c **** 	reg = readw(ASIC_CONF_REG);
  56:board/tr800/init.c **** 	/* DSR_MODEM/LPG pin is unconnected - make it LPG dummy output */
  57:board/tr800/init.c **** 	reg |= (1 << 6);
  58:board/tr800/init.c **** 	/* TWL3025: Set SPI+RIF RX clock to rising edge */
  59:board/tr800/init.c **** 	reg |= (1 << 13) | (1 << 14);
  60:board/tr800/init.c **** 	writew(reg, ASIC_CONF_REG);
  61:board/tr800/init.c **** 
  62:board/tr800/init.c **** 	/*
  63:board/tr800/init.c **** 	 * Calypso signals GPIO0, TSPDI/GPIO4, BCLKX/GPIO6, MCUEN1/GPIO8 and
  64:board/tr800/init.c **** 	 * MCUEN2/GPIO13 are unused and unconnected inside the TR-800 module.
  65:board/tr800/init.c **** 	 * Configure them as dummy outputs in order to prevent floating inputs.
  66:board/tr800/init.c **** 	 */
  67:board/tr800/init.c **** 	writew(0x0215, IO_CONF_REG);
  68:board/tr800/init.c **** 	writew(0xDC0E, IO_CNTL_REG);
  69:board/tr800/init.c **** 	writew(0x0000, ARMIO_LATCH_OUT);
  70:board/tr800/init.c **** 
  71:board/tr800/init.c **** 	/* configure ADD(22), needed for second half of flash */
  72:board/tr800/init.c **** 	reg = readw(ARM_CONF_REG);
  73:board/tr800/init.c **** 	reg |= (1 << 3);
  74:board/tr800/init.c **** 	writew(reg, ARM_CONF_REG);
  75:board/tr800/init.c **** }
  76:board/tr800/init.c **** 
  77:board/tr800/init.c **** /*
  78:board/tr800/init.c ****  * A total of 8 Calypso GPIO/multifunction pins (3 pure GPIO, 5 multifunction)
  79:board/tr800/init.c ****  * are brought out on the TR-800 module, with module users (application board
  80:board/tr800/init.c ****  * designers) explicitly allowed to wire them in whichever way is needed for
  81:board/tr800/init.c ****  * the custom application at hand.  6 of these pins power up as inputs.
  82:board/tr800/init.c ****  * Should the firmware leave them as inputs, or switch them to dummy outputs
  83:board/tr800/init.c ****  * to prevent floating inputs?  The answer in FreeCalypso (for TR-800 modules
  84:board/tr800/init.c ****  * rebranded as FC Tango) is a special file written into FFS: /etc/tango-pinmux.
  85:board/tr800/init.c ****  * This board wiring config file tells the firmware what it should do with each
  86:board/tr800/init.c ****  * of the 8 GPIO/multifunction pins in question; the format is defined here:
  87:board/tr800/init.c ****  *
  88:board/tr800/init.c ****  * https://www.freecalypso.org/hg/freecalypso-docs/file/tip/Tango-pinmux
  89:board/tr800/init.c ****  *
  90:board/tr800/init.c ****  * The following function reads /etc/tango-pinmux from FFS and applies the pin
  91:board/tr800/init.c ****  * multiplexing configuration encoded therein.  If this file is missing, all
  92:board/tr800/init.c ****  * pins in question are left in their default power-up state.
  93:board/tr800/init.c ****  */
  94:board/tr800/init.c **** static void board_pinmux_init(void)
  95:board/tr800/init.c **** {
  96:board/tr800/init.c **** 	uint8_t pinmux[4];
  97:board/tr800/init.c **** 	int rc;
  98:board/tr800/init.c **** 	uint16_t conf_reg, cntl_reg, out_reg;
  99:board/tr800/init.c **** 
 100:board/tr800/init.c **** 	rc = tiffs_read_file_fixedlen("/etc/tango-pinmux", pinmux, 4);
 101:board/tr800/init.c **** 	if (rc < 0)
 102:board/tr800/init.c **** 		return;		/* error msg already printed */
 103:board/tr800/init.c **** 	if (rc == 0) {
 104:board/tr800/init.c **** 		puts("Warning: /etc/tango-pinmux not found, pins left in default power-up state\n");
 105:board/tr800/init.c **** 		return;
 106:board/tr800/init.c **** 	}
 107:board/tr800/init.c **** 	/* read-modify-write registers */
 108:board/tr800/init.c **** 	conf_reg = readw(IO_CONF_REG);
 109:board/tr800/init.c **** 	cntl_reg = readw(IO_CNTL_REG);
 110:board/tr800/init.c **** 	out_reg = readw(ARMIO_LATCH_OUT);
 111:board/tr800/init.c **** 	/* GPIO1 */
 112:board/tr800/init.c **** 	if (pinmux[0] & 0x80) {
 113:board/tr800/init.c **** 		cntl_reg &= ~(1 << 1);
 114:board/tr800/init.c **** 		if (pinmux[0] & 0x01)
 115:board/tr800/init.c **** 			out_reg |= (1 << 1);
 116:board/tr800/init.c **** 		else
 117:board/tr800/init.c **** 			out_reg &= ~(1 << 1);
 118:board/tr800/init.c **** 	}
 119:board/tr800/init.c **** 	/* GPIO2 */
 120:board/tr800/init.c **** 	if (pinmux[1] & 0x08) {
 121:board/tr800/init.c **** 		/* pinmux says it's DCD output - set it high */
 122:board/tr800/init.c **** 		cntl_reg &= ~(1 << 2);
 123:board/tr800/init.c **** 		out_reg |= (1 << 2);
 124:board/tr800/init.c **** 	} else if (pinmux[1] & 0x02) {
 125:board/tr800/init.c **** 		/* generic output */
 126:board/tr800/init.c **** 		cntl_reg &= ~(1 << 2);
 127:board/tr800/init.c **** 		if (pinmux[1] & 0x01)
 128:board/tr800/init.c **** 			out_reg |= (1 << 2);
 129:board/tr800/init.c **** 		else
 130:board/tr800/init.c **** 			out_reg &= ~(1 << 2);
 131:board/tr800/init.c **** 	}
 132:board/tr800/init.c **** 	/* GPIO3 */
 133:board/tr800/init.c **** 	if (pinmux[1] & 0x20) {
 134:board/tr800/init.c **** 		/* generic output */
 135:board/tr800/init.c **** 		cntl_reg &= ~(1 << 3);
 136:board/tr800/init.c **** 		if (pinmux[1] & 0x10)
 137:board/tr800/init.c **** 			out_reg |= (1 << 3);
 138:board/tr800/init.c **** 		else
 139:board/tr800/init.c **** 			out_reg &= ~(1 << 3);
 140:board/tr800/init.c **** 	}
 141:board/tr800/init.c **** 	/* MCSI or GPIO? */
 142:board/tr800/init.c **** 	if (pinmux[2] & 0x80) {
 143:board/tr800/init.c **** 		/* MCSI pins switch to GPIO */
 144:board/tr800/init.c **** 		conf_reg |= 0x1E0;
 145:board/tr800/init.c **** 		writew(conf_reg, IO_CONF_REG);
 146:board/tr800/init.c **** 		/* GPIO9 */
 147:board/tr800/init.c **** 		if (pinmux[3] & 0x10) {
 148:board/tr800/init.c **** 			cntl_reg &= ~(1 << 9);
 149:board/tr800/init.c **** 			if (pinmux[3] & 0x01)
 150:board/tr800/init.c **** 				out_reg |= (1 << 9);
 151:board/tr800/init.c **** 			else
 152:board/tr800/init.c **** 				out_reg &= ~(1 << 9);
 153:board/tr800/init.c **** 		} else
 154:board/tr800/init.c **** 			cntl_reg |= (1 << 9);
 155:board/tr800/init.c **** 		/* GPIO10 */
 156:board/tr800/init.c **** 		if (pinmux[3] & 0x20) {
 157:board/tr800/init.c **** 			cntl_reg &= ~(1 << 10);
 158:board/tr800/init.c **** 			if (pinmux[3] & 0x02)
 159:board/tr800/init.c **** 				out_reg |= (1 << 10);
 160:board/tr800/init.c **** 			else
 161:board/tr800/init.c **** 				out_reg &= ~(1 << 10);
 162:board/tr800/init.c **** 		}
 163:board/tr800/init.c **** 		/* GPIO11 */
 164:board/tr800/init.c **** 		if (pinmux[3] & 0x40) {
 165:board/tr800/init.c **** 			cntl_reg &= ~(1 << 11);
 166:board/tr800/init.c **** 			if (pinmux[3] & 0x04)
 167:board/tr800/init.c **** 				out_reg |= (1 << 11);
 168:board/tr800/init.c **** 			else
 169:board/tr800/init.c **** 				out_reg &= ~(1 << 11);
 170:board/tr800/init.c **** 		}
 171:board/tr800/init.c **** 		/* GPIO12 */
 172:board/tr800/init.c **** 		if (pinmux[3] & 0x80) {
 173:board/tr800/init.c **** 			cntl_reg &= ~(1 << 12);
 174:board/tr800/init.c **** 			if (pinmux[3] & 0x08)
 175:board/tr800/init.c **** 				out_reg |= (1 << 12);
 176:board/tr800/init.c **** 			else
 177:board/tr800/init.c **** 				out_reg &= ~(1 << 12);
 178:board/tr800/init.c **** 		}
 179:board/tr800/init.c **** 	}
 180:board/tr800/init.c **** 	writew(out_reg, ARMIO_LATCH_OUT);
 181:board/tr800/init.c **** 	writew(cntl_reg, IO_CNTL_REG);
 182:board/tr800/init.c **** }
