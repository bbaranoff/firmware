  49:board/se_k2xx/init.c **** #define ASIC_CONF_REG	0xfffef008
  50:board/se_k2xx/init.c **** #define ARMIO_LATCH_OUT	0xfffe4802
  51:board/se_k2xx/init.c **** #define IO_CNTL_REG	0xfffe4804
  52:board/se_k2xx/init.c **** #define IO_CONF_REG	0xfffef00a
  53:board/se_k2xx/init.c **** 
  54:board/se_k2xx/init.c **** static void board_io_init(void)
  55:board/se_k2xx/init.c **** {
  56:board/se_k2xx/init.c **** 	uint16_t reg;
  57:board/se_k2xx/init.c **** 
  58:board/se_k2xx/init.c **** 	reg = readw(ASIC_CONF_REG);
  59:board/se_k2xx/init.c **** 	/* Set LPG and PWL pin mux */
  60:board/se_k2xx/init.c **** 	reg |= (1 << 6) | (1 << 4);
  61:board/se_k2xx/init.c **** 	/* TWL3025: Set SPI+RIF RX clock to rising edge */
  62:board/se_k2xx/init.c **** 	reg |= (1 << 13) | (1 << 14);
  63:board/se_k2xx/init.c **** 	writew(reg, ASIC_CONF_REG);
  64:board/se_k2xx/init.c **** 
  65:board/se_k2xx/init.c **** 	writew(0xc060, IO_CNTL_REG);
  66:board/se_k2xx/init.c **** 	writew(0x03fd, IO_CONF_REG);
  67:board/se_k2xx/init.c **** 
  68:board/se_k2xx/init.c **** 	/* set default IO state */
  69:board/se_k2xx/init.c **** 	writew(0x1f83, ARMIO_LATCH_OUT);
  70:board/se_k2xx/init.c **** }
