  31:board/se_k2xx/rffe_k2xx.c **** /* This is a value that has been measured on the C123 by Harald: 71dBm,
  32:board/se_k2xx/rffe_k2xx.c ****    it is the difference between the input level at the antenna and what
  33:board/se_k2xx/rffe_k2xx.c ****    the DSP reports, subtracted by the total gain of the TRF6151 */
  34:board/se_k2xx/rffe_k2xx.c **** #define SYSTEM_INHERENT_GAIN	71
  35:board/se_k2xx/rffe_k2xx.c **** 
  36:board/se_k2xx/rffe_k2xx.c **** /* describe how the RF frontend is wired on the SE K200i/K220i */
  37:board/se_k2xx/rffe_k2xx.c **** #define		RITA_RESET	TSPACT(0)	/* Reset of the Rita TRF6151, correct for K200i */
  38:board/se_k2xx/rffe_k2xx.c **** #define		PA_ENABLE	TSPACT(9)	/* Enable the Power Amplifier */
  39:board/se_k2xx/rffe_k2xx.c **** #define		DCS_TXEN	TSPACT(3)	/* DCS (as opposed to GSM) Transmit */
  40:board/se_k2xx/rffe_k2xx.c **** 
  41:board/se_k2xx/rffe_k2xx.c **** #define		ASM_VC1		TSPACT(1)	/* GSM1800 TX at antenna switch, inverted */
  42:board/se_k2xx/rffe_k2xx.c **** #define		ASM_VC2		TSPACT(2)	/* GSM900 TX at antenna switch, inverted */
  43:board/se_k2xx/rffe_k2xx.c **** 
  44:board/se_k2xx/rffe_k2xx.c **** #define		IOTA_STROBE	TSPEN(1)	/* Strobe for the Iota TSP */
  45:board/se_k2xx/rffe_k2xx.c **** #define		RITA_STROBE	TSPEN(2)	/* Strobe for the Rita TSP */
