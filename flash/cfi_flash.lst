 484:flash/cfi_flash.c **** 	uint32_t word_program_max =
 485:flash/cfi_flash.c **** 		(1 << qry->word_write_timeout_max) * word_program_typ;
 486:flash/cfi_flash.c **** 	printf("  block erase typ %u ms\n", block_erase_typ);
 487:flash/cfi_flash.c **** 	printf("  block erase max %u ms\n", block_erase_max);
 488:flash/cfi_flash.c **** 	printf("  word program typ %u us\n", word_program_typ);
 489:flash/cfi_flash.c **** 	printf("  word program max %u us\n", word_program_max);
 490:flash/cfi_flash.c **** }
