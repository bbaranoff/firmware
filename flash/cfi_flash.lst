 478:flash/cfi_flash.c **** static void dump_query_timing(struct cfi_query *qry)
 479:flash/cfi_flash.c **** {
 480:flash/cfi_flash.c **** 	uint32_t block_erase_typ = 1 << qry->block_erase_timeout_typ;
 481:flash/cfi_flash.c **** 	uint32_t block_erase_max =
