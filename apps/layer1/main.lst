  74:apps/layer1/main.c **** 	puts(hr);
  75:apps/layer1/main.c **** 
  76:apps/layer1/main.c **** 	fb_clear();
  77:apps/layer1/main.c **** 
  78:apps/layer1/main.c **** 	fb_setfg(FB_COLOR_BLACK);
  79:apps/layer1/main.c **** 	fb_setbg(FB_COLOR_WHITE);
  80:apps/layer1/main.c **** 	fb_setfont(FB_FONT_HELVB14);
  81:apps/layer1/main.c **** 
  82:apps/layer1/main.c **** 	fb_gotoxy(2,20);
  83:apps/layer1/main.c **** 	fb_putstr("Layer 1",framebuffer->width-4);
  84:apps/layer1/main.c **** 
  85:apps/layer1/main.c **** 	fb_setfg(FB_COLOR_RED);
  86:apps/layer1/main.c **** 	fb_setbg(FB_COLOR_BLUE);
  87:apps/layer1/main.c **** 
  88:apps/layer1/main.c **** 	fb_gotoxy(2,25);
  89:apps/layer1/main.c **** 	fb_boxto(framebuffer->width-3,38);
  90:apps/layer1/main.c **** 
  91:apps/layer1/main.c **** 	fb_setfg(FB_COLOR_WHITE);
  92:apps/layer1/main.c **** 	fb_setfont(FB_FONT_HELVR08);
  93:apps/layer1/main.c **** 	fb_gotoxy(8,33);
  94:apps/layer1/main.c **** 	fb_putstr("osmocom-bb",framebuffer->width-4);
  95:apps/layer1/main.c **** 
  96:apps/layer1/main.c **** 	fb_flush();
  97:apps/layer1/main.c **** 
  98:apps/layer1/main.c **** 	/* initialize SIM */
