 116:apps/layer1/main.c **** 
 117:apps/layer1/main.c **** 	/* NOT REACHED */
 118:apps/layer1/main.c **** 
 119:apps/layer1/main.c **** 	twl3025_power_off();
 120:apps/layer1/main.c **** }
