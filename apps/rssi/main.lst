1341:apps/rssi/main.c **** 	case GSM48_MT_RR_IMM_ASS_REJ:
1342:apps/rssi/main.c **** 		rx_imm_ass_rej(msg);
1343:apps/rssi/main.c **** 		break;
1344:apps/rssi/main.c **** 	}
1345:apps/rssi/main.c **** }
