1353:apps/rssi/main.c **** 	sih = msgb_l3(msg);
1354:apps/rssi/main.c **** 	switch (sih->system_information) {
1355:apps/rssi/main.c **** 	case GSM48_MT_RR_SYSINFO_1:
1356:apps/rssi/main.c **** 		memcpy(si_1, msgb_l3(msg), msgb_l3len(msg));
1357:apps/rssi/main.c **** 		break;
1358:apps/rssi/main.c **** 	case GSM48_MT_RR_SYSINFO_2:
1359:apps/rssi/main.c **** 		memcpy(si_2, msgb_l3(msg), msgb_l3len(msg));
1360:apps/rssi/main.c **** 		break;
1361:apps/rssi/main.c **** 	case GSM48_MT_RR_SYSINFO_2bis:
1362:apps/rssi/main.c **** 		memcpy(si_2bis, msgb_l3(msg), msgb_l3len(msg));
1363:apps/rssi/main.c **** 		break;
1364:apps/rssi/main.c **** 	case GSM48_MT_RR_SYSINFO_2ter:
1365:apps/rssi/main.c **** 		memcpy(si_2ter, msgb_l3(msg), msgb_l3len(msg));
1366:apps/rssi/main.c **** 		break;
1367:apps/rssi/main.c **** 	case GSM48_MT_RR_SYSINFO_3:
1368:apps/rssi/main.c **** 		memcpy(si_3, msgb_l3(msg), msgb_l3len(msg));
1369:apps/rssi/main.c **** 		break;
1370:apps/rssi/main.c **** 	case GSM48_MT_RR_SYSINFO_4:
1371:apps/rssi/main.c **** 		memcpy(si_4, msgb_l3(msg), msgb_l3len(msg));
1372:apps/rssi/main.c **** 		break;
1373:apps/rssi/main.c **** 	}
1374:apps/rssi/main.c **** 	si_new = sih->system_information | 0x100;
1375:apps/rssi/main.c **** }
