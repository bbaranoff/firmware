1336:apps/rssi/main.c **** 		rx_imm_ass(msg);
1337:apps/rssi/main.c **** 		break;
1338:apps/rssi/main.c **** 	case GSM48_MT_RR_IMM_ASS_EXT:
1339:apps/rssi/main.c **** 		rx_imm_ass_ext(msg);
