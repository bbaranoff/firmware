1348:apps/rssi/main.c **** static void rx_bcch(struct msgb *msg)
1349:apps/rssi/main.c **** {
1350:apps/rssi/main.c **** 	struct gsm48_system_information_type_header *sih;
1351:apps/rssi/main.c **** 
