1377:apps/rssi/main.c **** /* note: called from IRQ context */
1378:apps/rssi/main.c **** static void l1a_l23_tx(struct msgb *msg)
1379:apps/rssi/main.c **** {
1380:apps/rssi/main.c **** 	struct l1ctl_hdr *l1h = (struct l1ctl_hdr *) msg->l1h;
1381:apps/rssi/main.c **** 	struct l1ctl_pm_conf *pmr;
1382:apps/rssi/main.c **** 	struct l1ctl_info_dl *dl;
1383:apps/rssi/main.c **** 	struct l1ctl_fbsb_conf *sb;
1384:apps/rssi/main.c **** 	uint8_t chan_type, chan_ts, chan_ss;
1385:apps/rssi/main.c **** 	struct l1ctl_neigh_pm_ind *pm_ind;
1386:apps/rssi/main.c **** 	struct gsm_time tm;
1387:apps/rssi/main.c **** 
1388:apps/rssi/main.c **** 	switch (l1h->msg_type) {
1389:apps/rssi/main.c **** 	case L1CTL_PM_CONF:
1390:apps/rssi/main.c **** 		if (pm_mode == PM_SENT) {
1391:apps/rssi/main.c **** 			pmr = (struct l1ctl_pm_conf *) l1h->data;
1392:apps/rssi/main.c **** 			pm_meas[pm_count] = pmr->pm[0];
1393:apps/rssi/main.c **** 			pm_count++;
1394:apps/rssi/main.c **** 			pm_mode = PM_RESULT;
1395:apps/rssi/main.c **** 		}
1396:apps/rssi/main.c **** 		if (pm_mode == PM_RANGE_SENT) {
1397:apps/rssi/main.c **** 			for (pmr = (struct l1ctl_pm_conf *) l1h->data;
1398:apps/rssi/main.c **** 				(uint8_t *) pmr < msg->tail; pmr++) {
1399:apps/rssi/main.c **** 				if (!max || pm_spectrum[ntohs(pmr->band_arfcn) & 1023] < pmr->pm[0])
1400:apps/rssi/main.c **** 					pm_spectrum[ntohs(pmr->band_arfcn) & 1023] = pmr->pm[0];
1401:apps/rssi/main.c **** 			}
1402:apps/rssi/main.c **** 			if ((l1h->flags & L1CTL_F_DONE))
1403:apps/rssi/main.c **** 				pm_mode = PM_RANGE_RESULT;
1404:apps/rssi/main.c **** 		}
1405:apps/rssi/main.c **** 		l1s.tpu_offset_correction += 5000 / NUM_PM_UL;
1406:apps/rssi/main.c **** 		break;
1407:apps/rssi/main.c **** 	case L1CTL_FBSB_CONF:
1408:apps/rssi/main.c **** 		dl = (struct l1ctl_info_dl *) l1h->data;
1409:apps/rssi/main.c **** 		sb = (struct l1ctl_fbsb_conf *) dl->payload;
1410:apps/rssi/main.c **** 		if (sb->result == 0)
1411:apps/rssi/main.c **** 			sync_result = "ok";
1412:apps/rssi/main.c **** 		else
1413:apps/rssi/main.c **** 			sync_result = "error";
1414:apps/rssi/main.c **** 		bsic = sb->bsic;
1415:apps/rssi/main.c **** 		break;
1416:apps/rssi/main.c **** 	case L1CTL_DATA_IND:
1417:apps/rssi/main.c **** 		dl = (struct l1ctl_info_dl *) l1h->data;
1418:apps/rssi/main.c **** 		msg->l2h = dl->payload;
1419:apps/rssi/main.c **** 		rsl_dec_chan_nr(dl->chan_nr, &chan_type, &chan_ss, &chan_ts);
1420:apps/rssi/main.c **** 
1421:apps/rssi/main.c **** 		power = dl->rx_level;
1422:apps/rssi/main.c **** 		if (dl->fire_crc >= 2) {
1423:apps/rssi/main.c **** 			if (chan_type == RSL_CHAN_BCCH)
1424:apps/rssi/main.c **** 				si_new = 0x1ff; /* error frame indication */
1425:apps/rssi/main.c **** 			break; /* free, but don't send to sercom */
1426:apps/rssi/main.c **** 		}
1427:apps/rssi/main.c **** 
1428:apps/rssi/main.c **** 		switch (chan_type) {
1429:apps/rssi/main.c **** 		case RSL_CHAN_BCCH:
1430:apps/rssi/main.c **** 			msg->l3h = msg->l2h;
