1235:apps/rssi/main.c **** static void handle_assign(void)
1236:apps/rssi/main.c **** {
1237:apps/rssi/main.c **** 	if (mode != MODE_RACH)
1238:apps/rssi/main.c **** 		return;
1239:apps/rssi/main.c **** 
1240:apps/rssi/main.c **** 	if (assign == ASSIGN_NONE) {
1241:apps/rssi/main.c **** 		unsigned long elapsed = jiffies - rach_when;
1242:apps/rssi/main.c **** 
1243:apps/rssi/main.c **** 		if (!rach)
1244:apps/rssi/main.c **** 			return;
1245:apps/rssi/main.c **** 		if (elapsed < HZ * 2)
1246:apps/rssi/main.c **** 			return;
1247:apps/rssi/main.c **** 		assign = ASSIGN_TIMEOUT;
1248:apps/rssi/main.c **** 		rach = 0;
1249:apps/rssi/main.c **** 	}
1250:apps/rssi/main.c **** 
1251:apps/rssi/main.c **** 	refresh_display();
1252:apps/rssi/main.c **** 	assign = ASSIGN_NONE;
1253:apps/rssi/main.c **** }
