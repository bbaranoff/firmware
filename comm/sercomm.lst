 102:comm/sercomm.c **** void sercomm_init(void)
 103:comm/sercomm.c **** {
 104:comm/sercomm.c **** 	unsigned int i;
 105:comm/sercomm.c **** 	for (i = 0; i < ARRAY_SIZE(sercomm.tx.dlci_queues); i++)
 106:comm/sercomm.c **** 		INIT_LLIST_HEAD(&sercomm.tx.dlci_queues[i]);
 107:comm/sercomm.c **** 
 108:comm/sercomm.c **** 	sercomm.rx.msg = NULL;
 109:comm/sercomm.c **** 	sercomm.initialized = 1;
 110:comm/sercomm.c **** 
 111:comm/sercomm.c **** 	/* set up the echo dlci */
 112:comm/sercomm.c **** 	sercomm_register_rx_cb(SC_DLCI_ECHO, &sercomm_sendmsg);
 113:comm/sercomm.c **** }
 114:comm/sercomm.c **** 
 115:comm/sercomm.c **** int sercomm_initialized(void)
 116:comm/sercomm.c **** {
 117:comm/sercomm.c **** 	return sercomm.initialized;
 118:comm/sercomm.c **** }
