  84:comm/sercomm.c **** 		uint8_t dlci;
  85:comm/sercomm.c **** 		uint8_t ctrl;
  86:comm/sercomm.c **** 	} rx;
  87:comm/sercomm.c **** 	
  88:comm/sercomm.c **** } sercomm;
  89:comm/sercomm.c **** 
